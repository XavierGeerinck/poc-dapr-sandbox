+limitations under the License.
+*/
+
+package sandbox
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+)
+
+// Config is the parsed component metadata of a sandbox component.
+type Config struct {
+	Image               string
+	CPUs                uint32
+	MemoryMiB           uint32
+	Setup               string
+	WarmPoolSize        uint32
+	MaxSandboxesPerHost uint32
+	RefillConcurrency   uint32
+	IdleTimeout         time.Duration
+	Template            string
+}
+
+// ParseConfig parses component metadata properties, applying defaults.
+func ParseConfig(props map[string]string) (Config, error) {
+	c := Config{
+		Image:               props["image"],
+		CPUs:                1,
+		MemoryMiB:           512,
+		Setup:               props["setup"],
+		WarmPoolSize:        4,
+		MaxSandboxesPerHost: 32,
+		RefillConcurrency:   2,
+		IdleTimeout:         5 * time.Minute,
+		Template:            "snapshot",
+	}
+	if c.Image == "" {
+		return Config{}, errors.New("sandbox: metadata 'image' is required")
+	}
+
+	for _, f := range []struct {
+		name string
+		dst  *uint32
+	}{
+		{"cpus", &c.CPUs},
+		{"memoryMiB", &c.MemoryMiB},
+		{"warmPoolSize", &c.WarmPoolSize},
+		{"maxSandboxesPerHost", &c.MaxSandboxesPerHost},
+		{"refillConcurrency", &c.RefillConcurrency},
+	} {
+		v, ok := props[f.name]
+		if !ok || v == "" {
+			continue
+		}
+		n, err := strconv.ParseUint(v, 10, 32)
+		if err != nil {
+			return Config{}, fmt.Errorf("sandbox: invalid metadata '%s' %q: %w", f.name, v, err)
+		}
+		*f.dst = uint32(n)
+	}
+
+	if v := props["idleTimeout"]; v != "" {
+		d, err := time.ParseDuration(v)
+		if err != nil {
+			return Config{}, fmt.Errorf("sandbox: invalid metadata 'idleTimeout' %q: %w", v, err)
+		}
+		c.IdleTimeout = d
+	}
+
+	if v := props["template"]; v != "" {
+		if v != "snapshot" && v != "none" {
+			return Config{}, fmt.Errorf("sandbox: invalid metadata 'template' %q: must be 'snapshot' or 'none'", v)
+		}
+		c.Template = v
+	}
+
+	return c, nil
+}
diff --git a/pkg/components/sandbox/config_test.go b/pkg/components/sandbox/config_test.go
new file mode 100644
