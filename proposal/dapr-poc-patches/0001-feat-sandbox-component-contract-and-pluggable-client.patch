+
+// Sandbox is the driver interface daprd uses to manage isolated sandboxes.
+type Sandbox interface {
+	Init(ctx context.Context, md metadata.Base) error
+	Close() error
+
+	Ready(ctx context.Context, req *proto.SandboxReadyRequest) (*proto.SandboxReadyResponse, error)
