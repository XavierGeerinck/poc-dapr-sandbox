+
+package sandbox
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/dapr/dapr/pkg/components"
+	"github.com/dapr/kit/logger"
+)
+
+// Registry is an interface for a component that returns registered sandbox implementations.
+type Registry struct {
+	Logger    logger.Logger
+	sandboxes map[string]func(logger.Logger) Sandbox
+}
+
+// DefaultRegistry is the singleton with the registry.
+var DefaultRegistry *Registry = NewRegistry()
+
+// NewRegistry is used to create sandbox registry.
+func NewRegistry() *Registry {
+	return &Registry{
+		Logger:    logger.NewLogger("dapr.sandbox.registry"),
+		sandboxes: make(map[string]func(logger.Logger) Sandbox),
+	}
+}
+
+// RegisterComponent adds a new sandbox to the registry.
+func (s *Registry) RegisterComponent(componentFactory func(logger.Logger) Sandbox, names ...string) {
+	for _, name := range names {
+		s.sandboxes[createFullName(name)] = componentFactory
+	}
+}
+
+func (s *Registry) Create(name, version, logName string) (Sandbox, error) {
+	if method, ok := s.getSandbox(name, version, logName); ok {
+		return method(), nil
+	}
+	return nil, fmt.Errorf("couldn't find sandbox %s/%s", name, version)
+}
+
+func (s *Registry) getSandbox(name, version, logName string) (func() Sandbox, bool) {
+	name = strings.ToLower(name)
+	version = strings.ToLower(version)
+	storeFn, ok := s.sandboxes[name+"/"+version]
+
+	if ok {
+		return s.wrapFn(storeFn, logName), true
+	}
+	if components.IsInitialVersion(version) {
+		storeFn, ok = s.sandboxes[name]
+		if ok {
+			return s.wrapFn(storeFn, logName), true
+		}
+	}
+
+	return nil, false
+}
+
+func (s *Registry) wrapFn(componentFactory func(logger.Logger) Sandbox, logName string) func() Sandbox {
+	return func() Sandbox {
+		l := s.Logger
+		if logName != "" && l != nil {
+			l = l.WithFields(map[string]any{
+				"component": logName,
+			})
+		}
+		return componentFactory(l)
+	}
+}
+
+func createFullName(name string) string {
+	return strings.ToLower("sandbox." + name)
+}
