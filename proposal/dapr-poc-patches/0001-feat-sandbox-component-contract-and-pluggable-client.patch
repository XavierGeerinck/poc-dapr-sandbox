+
+package sandbox
+
+import (
+	"context"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+
+	cmetadata "github.com/dapr/components-contrib/metadata"
+	proto "github.com/dapr/dapr/pkg/proto/components/v1"
+	"github.com/dapr/kit/logger"
+)
+
+type fakeServer struct {
+	proto.UnimplementedSandboxServer
+	initProps   map[string]string
+	instanceHdr []string
+	acquireErr  error
+}
+
+func (f *fakeServer) Init(ctx context.Context, req *proto.SandboxInitRequest) (*proto.SandboxInitResponse, error) {
+	f.initProps = req.GetMetadata().GetProperties()
+	md, _ := metadata.FromIncomingContext(ctx)
+	f.instanceHdr = md.Get("x-component-instance")
+	return &proto.SandboxInitResponse{}, nil
+}
+
+func (f *fakeServer) Acquire(context.Context, *proto.SandboxAcquireRequest) (*proto.SandboxAcquireResponse, error) {
+	if f.acquireErr != nil {
+		return nil, f.acquireErr
+	}
+	return &proto.SandboxAcquireResponse{InstanceId: "inst-1", Path: proto.SandboxAcquirePath_POOL}, nil
+}
+
+func startFake(t *testing.T, f *fakeServer) string {
+	t.Helper()
+	// Unix socket paths are limited to ~104 bytes on macOS.
+	dir, err := os.MkdirTemp("/tmp", "sbx")
+	require.NoError(t, err)
+	t.Cleanup(func() { os.RemoveAll(dir) })
+	sock := filepath.Join(dir, "s.sock")
+	lis, err := net.Listen("unix", sock)
+	require.NoError(t, err)
+	srv := grpc.NewServer()
+	proto.RegisterSandboxServer(srv, f)
+	go srv.Serve(lis)
+	t.Cleanup(srv.Stop)
+	return sock
+}
+
+func TestGRPCSandbox_RoundTrip(t *testing.T) {
+	f := &fakeServer{}
+	sock := startFake(t, f)
+
+	sb := NewGRPCSandbox(logger.NewLogger("test"), sock)
+	t.Cleanup(func() { sb.Close() })
+
+	require.NoError(t, sb.Init(t.Context(), cmetadata.Base{
+		Name:       "mysb",
+		Properties: map[string]string{"image": "x"},
+	}))
+	assert.Equal(t, map[string]string{"image": "x"}, f.initProps)
+	assert.Equal(t, []string{"mysb"}, f.instanceHdr)
+
+	resp, err := sb.Acquire(t.Context(), &proto.SandboxAcquireRequest{SandboxId: "a"})
+	require.NoError(t, err)
+	assert.Equal(t, "inst-1", resp.GetInstanceId())
+
+	f.acquireErr = status.Error(codes.ResourceExhausted, "full")
+	_, err = sb.Acquire(t.Context(), &proto.SandboxAcquireRequest{SandboxId: "b"})
+	require.Error(t, err)
+	assert.Equal(t, codes.ResourceExhausted, status.Code(err))
+}
