+
+package sandbox
+
+import (
+	"context"
+
+	"github.com/dapr/components-contrib/metadata"
+	"github.com/dapr/dapr/pkg/components/pluggable"
+	proto "github.com/dapr/dapr/pkg/proto/components/v1"
+	"github.com/dapr/kit/logger"
+)
+
+// grpcSandbox is a Sandbox implementation over a gRPC pluggable component.
+type grpcSandbox struct {
+	*pluggable.GRPCConnector[proto.SandboxClient]
+}
+
+// Init dials the component and passes the metadata to it.
+func (g *grpcSandbox) Init(ctx context.Context, md metadata.Base) error {
+	if err := g.Dial(md.Name); err != nil {
+		return err
+	}
+	_, err := g.Client.Init(g.Context, &proto.SandboxInitRequest{
+		Metadata: &proto.MetadataRequest{Properties: md.Properties},
+	})
+	return err
+}
+
+func (g *grpcSandbox) Ready(ctx context.Context, req *proto.SandboxReadyRequest) (*proto.SandboxReadyResponse, error) {
+	return g.Client.Ready(ctx, req)
+}
+
+func (g *grpcSandbox) Acquire(ctx context.Context, req *proto.SandboxAcquireRequest) (*proto.SandboxAcquireResponse, error) {
+	return g.Client.Acquire(ctx, req)
+}
+
+func (g *grpcSandbox) Exec(ctx context.Context, req *proto.SandboxExecRequest) (*proto.SandboxExecResponse, error) {
+	return g.Client.Exec(ctx, req)
+}
+
+func (g *grpcSandbox) SessionStart(ctx context.Context, req *proto.SandboxSessionStartRequest) (*proto.SandboxSessionStartResponse, error) {
+	return g.Client.SessionStart(ctx, req)
+}
+
+func (g *grpcSandbox) SessionSend(ctx context.Context, req *proto.SandboxSessionSendRequest) (*proto.SandboxExecResponse, error) {
+	return g.Client.SessionSend(ctx, req)
+}
+
+func (g *grpcSandbox) SessionClose(ctx context.Context, req *proto.SandboxSessionCloseRequest) (*proto.SandboxSessionCloseResponse, error) {
+	return g.Client.SessionClose(ctx, req)
+}
+
+func (g *grpcSandbox) Release(ctx context.Context, req *proto.SandboxReleaseRequest) (*proto.SandboxReleaseResponse, error) {
+	return g.Client.Release(ctx, req)
+}
+
+func (g *grpcSandbox) Reconcile(ctx context.Context, req *proto.SandboxReconcileRequest) (*proto.SandboxReconcileResponse, error) {
+	return g.Client.Reconcile(ctx, req)
+}
+
+// NewGRPCSandbox creates a new gRPC sandbox using the given socket.
+func NewGRPCSandbox(l logger.Logger, socket string) Sandbox {
+	return &grpcSandbox{GRPCConnector: pluggable.NewGRPCConnector(socket, proto.NewSandboxClient)}
+}
+
+func newGRPCSandbox(dialer pluggable.GRPCConnectionDialer) func(l logger.Logger) Sandbox {
+	return func(l logger.Logger) Sandbox {
+		return &grpcSandbox{GRPCConnector: pluggable.NewGRPCConnectorWithDialer(dialer, proto.NewSandboxClient)}
+	}
+}
+
+func init() {
+	//nolint:nosnakecase
+	pluggable.AddServiceDiscoveryCallback(proto.Sandbox_ServiceDesc.ServiceName, func(name string, dialer pluggable.GRPCConnectionDialer) {
+		DefaultRegistry.RegisterComponent(newGRPCSandbox(dialer), name)
+	})
+}
