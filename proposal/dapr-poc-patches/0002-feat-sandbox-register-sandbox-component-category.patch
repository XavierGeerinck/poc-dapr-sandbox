+package compstore
+
+import "github.com/dapr/dapr/pkg/components/sandbox"
+
+func (c *ComponentStore) AddSandbox(name string, s sandbox.Sandbox) {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+
+	c.sandboxes[name] = s
+}
+
+func (c *ComponentStore) GetSandbox(name string) (sandbox.Sandbox, bool) {
+	c.lock.RLock()
+	defer c.lock.RUnlock()
+
+	s, ok := c.sandboxes[name]
+
+	return s, ok
+}
+
+func (c *ComponentStore) DeleteSandbox(name string) {
+	c.lock.Lock()
+	defer c.lock.Unlock()
+
+	delete(c.sandboxes, name)
+}
