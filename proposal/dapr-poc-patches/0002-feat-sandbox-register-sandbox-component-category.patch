+package sandboxhost
+
+import (
+	"context"
+	"time"
+
+	"github.com/dapr/dapr/pkg/actors"
+	"github.com/dapr/dapr/pkg/components/sandbox"
+)
+
+// Options are the options for a Host.
+type Options struct {
+	Actors            actors.Interface
+	AppID, Namespace  string
+	ReadyPollInterval time.Duration
+	ReconcileInterval time.Duration
+}
+
+// Host manages sandbox drivers and registers their internal actor types.
+type Host struct {
+	opts Options
+}
+
+// New returns a new Host.
+func New(opts Options) *Host {
+	return &Host{opts: opts}
+}
+
+// Add registers a sandbox component with the host.
+func (h *Host) Add(_ context.Context, _ string, _ sandbox.Sandbox, _ sandbox.Config) {
+	// TODO(Task 6): register the internal actor type and start warm pool management.
+}
+
+// Remove unregisters a sandbox component from the host.
+func (h *Host) Remove(_ context.Context, _ string) error {
+	// TODO(Task 6): unregister the actor type and stop management.
+	return nil
+}
+
+// ActorType returns the internal actor type name for a sandbox component.
+func ActorType(namespace, appID, component string) string {
+	return "dapr.internal." + namespace + "." + appID + ".sandbox." + component
+}
