+
+type fakeDriver struct {
+	compsandbox.Sandbox
+	initErr     error
+	initCalled  bool
+	closeCalled bool
+	md          metadata.Base
+}
+
+func (f *fakeDriver) Init(_ context.Context, md metadata.Base) error {
+	f.initCalled = true
+	f.md = md
+	return f.initErr
+}
+
+func (f *fakeDriver) Close() error {
+	f.closeCalled = true
+	return nil
+}
+
+type fakeHost struct {
+	added    []string
+	cfgs     []compsandbox.Config
+	removed  []string
+	removeEr error
+}
+
+func (h *fakeHost) Add(_ context.Context, component string, _ compsandbox.Sandbox, cfg compsandbox.Config) {
+	h.added = append(h.added, component)
+	h.cfgs = append(h.cfgs, cfg)
+}
+
+func (h *fakeHost) Remove(_ context.Context, component string) error {
+	h.removed = append(h.removed, component)
+	return h.removeEr
+}
+
+func newComp(props map[string]string) compapi.Component {
+	c := compapi.Component{
+		ObjectMeta: metav1.ObjectMeta{Name: "box"},
+		Spec:       compapi.ComponentSpec{Type: "sandbox.fake", Version: "v1"},
+	}
+	for k, v := range props {
+		c.Spec.Metadata = append(c.Spec.Metadata, commonapi.NameValuePair{
+			Name:  k,
+			Value: commonapi.DynamicValue{JSON: apiextv1.JSON{Raw: []byte(v)}},
+		})
+	}
+	return c
+}
+
+func setup(fake *fakeDriver) (*sandboxMgr, *compstore.ComponentStore, *fakeHost) {
+	reg := compsandbox.NewRegistry()
+	reg.RegisterComponent(func(logger.Logger) compsandbox.Sandbox { return fake }, "fake")
+	store := compstore.New()
+	host := &fakeHost{}
+	return New(Options{Registry: reg, Store: store, Meta: meta.New(meta.Options{}), Host: host}), store, host
+}
+
+func TestSandboxProcessor_InitClose(t *testing.T) {
+	t.Parallel()
+
+	t.Run("init adds to store and host, close removes", func(t *testing.T) {
+		t.Parallel()
+		fake := &fakeDriver{}
+		p, store, host := setup(fake)
+
+		require.NoError(t, p.Init(t.Context(), newComp(map[string]string{"image": "x"})))
+		assert.True(t, fake.initCalled)
+		got, ok := store.GetSandbox("box")
+		require.True(t, ok)
+		assert.Same(t, fake, got)
+		require.Len(t, host.added, 1)
+		assert.Equal(t, "box", host.added[0])
+		assert.Equal(t, "x", host.cfgs[0].Image)
+		assert.Equal(t, uint32(1), host.cfgs[0].CPUs)
+
+		require.NoError(t, p.Close(newComp(nil)))
+		assert.Equal(t, []string{"box"}, host.removed)
+		_, ok = store.GetSandbox("box")
+		assert.False(t, ok)
+		assert.True(t, fake.closeCalled)
+	})
+
+	t.Run("missing image errors, nothing added", func(t *testing.T) {
+		t.Parallel()
+		fake := &fakeDriver{}
+		p, store, host := setup(fake)
+
+		require.Error(t, p.Init(t.Context(), newComp(nil)))
+		assert.False(t, fake.initCalled)
+		assert.False(t, fake.closeCalled)
+		_, ok := store.GetSandbox("box")
+		assert.False(t, ok)
+		assert.Empty(t, host.added)
+	})
+
+	t.Run("driver init error, nothing added or closed", func(t *testing.T) {
+		t.Parallel()
+		fake := &fakeDriver{initErr: assert.AnError}
+		p, store, host := setup(fake)
+
+		require.Error(t, p.Init(t.Context(), newComp(map[string]string{"image": "x"})))
+		assert.False(t, fake.closeCalled)
+		_, ok := store.GetSandbox("box")
+		assert.False(t, ok)
+		assert.Empty(t, host.added)
+	})
+
+	t.Run("close of unknown component is a no-op", func(t *testing.T) {
+		t.Parallel()
+		p, _, host := setup(&fakeDriver{})
+		require.NoError(t, p.Close(newComp(nil)))
+		assert.Empty(t, host.removed)
+	})
+}
