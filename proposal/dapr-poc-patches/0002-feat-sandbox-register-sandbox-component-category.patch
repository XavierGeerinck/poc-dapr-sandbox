+package sandbox
+
+import (
+	"context"
+	"fmt"
+
+	compapi "github.com/dapr/dapr/pkg/apis/components/v1alpha1"
+	compsandbox "github.com/dapr/dapr/pkg/components/sandbox"
+	diag "github.com/dapr/dapr/pkg/diagnostics"
+	"github.com/dapr/dapr/pkg/runtime/compstore"
+	rterrors "github.com/dapr/dapr/pkg/runtime/errors"
+	"github.com/dapr/dapr/pkg/runtime/meta"
+)
+
+// SandboxHost is the subset of the sandbox host used by the processor.
+type SandboxHost interface {
+	Add(ctx context.Context, component string, d compsandbox.Sandbox, cfg compsandbox.Config)
+	Remove(ctx context.Context, component string) error
+}
+
+type Options struct {
+	Registry *compsandbox.Registry
+	Store    *compstore.ComponentStore
+	Meta     *meta.Meta
+	Host     SandboxHost
+}
+
+type sandboxMgr struct {
+	registry *compsandbox.Registry
+	store    *compstore.ComponentStore
+	meta     *meta.Meta
+	host     SandboxHost
+}
+
+func New(opts Options) *sandboxMgr {
+	return &sandboxMgr{
+		registry: opts.Registry,
+		store:    opts.Store,
+		meta:     opts.Meta,
+		host:     opts.Host,
+	}
+}
+
+func (s *sandboxMgr) Init(ctx context.Context, comp compapi.Component) error {
+	fName := comp.LogName()
+
+	driver, err := s.registry.Create(comp.Spec.Type, comp.Spec.Version, fName)
+	if err != nil {
+		diag.DefaultMonitoring.ComponentInitFailed(comp.Spec.Type, "creation", comp.Name)
+		return rterrors.NewInit(rterrors.CreateComponentFailure, fName, err)
+	}
+
+	if driver == nil {
+		diag.DefaultMonitoring.ComponentInitFailed(comp.Spec.Type, "creation", comp.Name)
+		return rterrors.NewInit(rterrors.CreateComponentFailure, fName,
+			fmt.Errorf("sandbox %s/%s returned a nil driver", comp.Spec.Type, comp.Spec.Version))
+	}
+
+	base, err := s.meta.ToBaseMetadata(comp)
+	if err != nil {
+		diag.DefaultMonitoring.ComponentInitFailed(comp.Spec.Type, "init", comp.Name)
+		return rterrors.NewInit(rterrors.InitComponentFailure, fName, err)
+	}
+
+	// Parse before driver Init: a failure here must not touch the driver, since
+	// pluggable drivers' Close dereferences a connection that Init dials.
+	cfg, err := compsandbox.ParseConfig(base.Properties)
+	if err != nil {
+		diag.DefaultMonitoring.ComponentInitFailed(comp.Spec.Type, "init", comp.Name)
+		return rterrors.NewInit(rterrors.InitComponentFailure, fName, err)
+	}
+
+	// On Init failure the driver is deliberately not closed (see above).
+	if err = driver.Init(ctx, base); err != nil {
+		diag.DefaultMonitoring.ComponentInitFailed(comp.Spec.Type, "init", comp.Name)
+		return rterrors.NewInit(rterrors.InitComponentFailure, fName, err)
+	}
+
+	s.store.AddSandbox(comp.Name, driver)
+	s.host.Add(ctx, comp.Name, driver, cfg)
+
+	diag.DefaultMonitoring.ComponentInitialized(comp.Spec.Type)
+
+	return nil
+}
+
+func (s *sandboxMgr) Close(comp compapi.Component) error {
+	driver, ok := s.store.GetSandbox(comp.Name)
+	if !ok {
+		return nil
+	}
+
+	defer s.store.DeleteSandbox(comp.Name)
+
+	if err := s.host.Remove(context.Background(), comp.Name); err != nil {
+		_ = driver.Close()
+		return err
+	}
+	return driver.Close()
+}
