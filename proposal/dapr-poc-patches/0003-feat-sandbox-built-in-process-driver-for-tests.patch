+
+func newDriver(t *testing.T, props map[string]string) *Process {
+	t.Helper()
+	return newDriverDelay(t, props, 0)
+}
+
+func newDriverDelay(t *testing.T, props map[string]string, refillDelay time.Duration) *Process {
+	t.Helper()
+	p := map[string]string{"image": "ignored"}
+	for k, v := range props {
+		p[k] = v
+	}
+	d := New(logger.NewLogger("test")).(*Process)
+	d.refillDelay = refillDelay
+	require.NoError(t, d.Init(t.Context(), metadata.Base{Properties: p}))
+	t.Cleanup(func() { _ = d.Close() })
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		r, err := d.Ready(t.Context(), &proto.SandboxReadyRequest{})
+		require.NoError(t, err)
+		if r.GetReady() {
+			break
+		}
+		require.False(t, time.Now().After(deadline), "not ready: %s", r.GetReason())
+		time.Sleep(5 * time.Millisecond)
+	}
+	return d
+}
+
+func acquire(t *testing.T, d *Process) *proto.SandboxAcquireResponse {
+	t.Helper()
+	r, err := d.Acquire(t.Context(), &proto.SandboxAcquireRequest{SandboxId: "s", ActivationId: "a"})
+	require.NoError(t, err)
+	return r
+}
+
+func run(t *testing.T, d *Process, id string, spec *proto.SandboxExecSpec) *proto.SandboxExecResponse {
+	t.Helper()
+	r, err := d.Exec(t.Context(), &proto.SandboxExecRequest{InstanceId: id, Spec: spec})
+	require.NoError(t, err)
+	return r
+}
+
+func TestAcquirePoolThenBoot(t *testing.T) {
+	d := newDriverDelay(t, map[string]string{"warmPoolSize": "1", "refillConcurrency": "1"}, time.Hour)
+	a := acquire(t, d)
+	assert.Equal(t, proto.SandboxAcquirePath_POOL, a.GetPath())
+	b := acquire(t, d)
+	assert.Equal(t, proto.SandboxAcquirePath_BOOT, b.GetPath())
+	assert.NotEqual(t, a.GetInstanceId(), b.GetInstanceId())
+}
+
+func TestHostFull(t *testing.T) {
+	d := newDriver(t, map[string]string{"maxSandboxesPerHost": "1", "warmPoolSize": "1"})
+	acquire(t, d)
+	_, err := d.Acquire(t.Context(), &proto.SandboxAcquireRequest{SandboxId: "s2"})
+	require.Error(t, err)
+	assert.Equal(t, codes.ResourceExhausted, status.Code(err))
+}
+
+func TestExecEcho(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	r := run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "echo", Args: []string{"hi"}})
+	assert.Equal(t, "hi\n", string(r.GetStdout()))
+	assert.Equal(t, int32(0), r.GetExitCode())
+}
+
+func TestExecTimeout(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	r := run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "sleep", Args: []string{"5"}, TimeoutMs: 200})
+	assert.True(t, r.GetTimedOut())
+	assert.NotZero(t, r.GetExitCode())
+	assert.Less(t, r.GetElapsedUs(), uint64(time.Second/time.Microsecond))
+
+	r = run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "echo", Args: []string{"ok"}})
+	assert.Equal(t, "ok\n", string(r.GetStdout()))
+}
+
+func TestExecOutputCap(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	r := run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "head", Args: []string{"-c", "10485760", "/dev/zero"}})
+	assert.Len(t, r.GetStdout(), 4194304)
+	assert.True(t, r.GetTruncated())
+	assert.Equal(t, int32(0), r.GetExitCode())
+}
+
+func TestExecCwdEnvStdin(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	r := run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "sh", Args: []string{"-c", "echo $FOO; pwd; cat"}, Env: map[string]string{"FOO": "bar"}, Stdin: []byte("in")})
+	assert.Contains(t, string(r.GetStdout()), "bar\n")
+	assert.Contains(t, string(r.GetStdout()), "in")
+	run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "mkdir", Args: []string{"sub"}})
+	r = run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "pwd", Cwd: "sub"})
+	assert.Contains(t, string(r.GetStdout()), "/sub\n")
+}
+
+func TestSessionKeepsState(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	s, err := d.SessionStart(t.Context(), &proto.SandboxSessionStartRequest{
+		InstanceId: a.GetInstanceId(), Spec: &proto.SandboxExecSpec{Command: "sh", Args: []string{"-i"}},
+	})
+	require.NoError(t, err)
+	_, err = d.SessionSend(t.Context(), &proto.SandboxSessionSendRequest{
+		InstanceId: a.GetInstanceId(), SessionId: s.GetSessionId(), Input: []byte("X=42\n"), TimeoutMs: 100,
+	})
+	require.NoError(t, err)
+	r, err := d.SessionSend(t.Context(), &proto.SandboxSessionSendRequest{
+		InstanceId: a.GetInstanceId(), SessionId: s.GetSessionId(), Input: []byte("echo $X\n"), Until: []byte("42"), TimeoutMs: 5000,
+	})
+	require.NoError(t, err)
+	assert.Contains(t, string(r.GetStdout())+string(r.GetStderr()), "42")
+	assert.False(t, r.GetTimedOut())
+
+	// timeout returns collected output with no error
+	r, err = d.SessionSend(t.Context(), &proto.SandboxSessionSendRequest{
+		InstanceId: a.GetInstanceId(), SessionId: s.GetSessionId(), Input: []byte("true\n"), Until: []byte("never-appears"), TimeoutMs: 100,
+	})
+	require.NoError(t, err)
+	assert.True(t, r.GetTimedOut())
+
+	_, err = d.SessionClose(t.Context(), &proto.SandboxSessionCloseRequest{InstanceId: a.GetInstanceId(), SessionId: s.GetSessionId()})
+	require.NoError(t, err)
+	_, err = d.SessionSend(t.Context(), &proto.SandboxSessionSendRequest{InstanceId: a.GetInstanceId(), SessionId: s.GetSessionId()})
+	assert.Equal(t, codes.NotFound, status.Code(err))
+}
+
+func TestUnknownInstance(t *testing.T) {
+	d := newDriver(t, nil)
+	_, err := d.Exec(t.Context(), &proto.SandboxExecRequest{InstanceId: "nope", Spec: &proto.SandboxExecSpec{Command: "echo"}})
+	assert.Equal(t, codes.NotFound, status.Code(err))
+	_, err = d.SessionStart(t.Context(), &proto.SandboxSessionStartRequest{InstanceId: "nope", Spec: &proto.SandboxExecSpec{Command: "cat"}})
+	assert.Equal(t, codes.NotFound, status.Code(err))
+	_, err = d.Release(t.Context(), &proto.SandboxReleaseRequest{InstanceId: "nope"})
+	assert.Equal(t, codes.NotFound, status.Code(err))
+}
+
+func TestReleaseFreesSlot(t *testing.T) {
+	d := newDriver(t, map[string]string{"maxSandboxesPerHost": "1", "warmPoolSize": "0"})
+	a := acquire(t, d)
+	_, err := d.Release(context.Background(), &proto.SandboxReleaseRequest{InstanceId: a.GetInstanceId()})
+	require.NoError(t, err)
+	b := acquire(t, d)
+	assert.Equal(t, proto.SandboxAcquirePath_BOOT, b.GetPath())
+	assert.Eventually(t, func() bool {
+		_, err := d.Exec(t.Context(), &proto.SandboxExecRequest{InstanceId: a.GetInstanceId(), Spec: &proto.SandboxExecSpec{Command: "true"}})
+		return status.Code(err) == codes.NotFound
+	}, 2*time.Second, 10*time.Millisecond)
+}
+
+func TestReconcile(t *testing.T) {
+	d := newDriver(t, map[string]string{"warmPoolSize": "0"})
+	a := acquire(t, d)
+	acquire(t, d)
+	acquire(t, d)
+	r, err := d.Reconcile(t.Context(), &proto.SandboxReconcileRequest{LiveInstanceIds: []string{a.GetInstanceId()}})
+	require.NoError(t, err)
+	assert.Equal(t, uint32(2), r.GetReleased())
+	run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "true"})
+}
