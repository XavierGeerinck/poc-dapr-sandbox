@@ -188,10 +189,108 @@ func TestReleaseFreesSlot(t *testing.T) {
 func TestReconcile(t *testing.T) {
 	d := newDriver(t, map[string]string{"warmPoolSize": "0"})
 	a := acquire(t, d)
-	acquire(t, d)
-	acquire(t, d)
+	released := []string{acquire(t, d).GetInstanceId(), acquire(t, d).GetInstanceId()}
 	r, err := d.Reconcile(t.Context(), &proto.SandboxReconcileRequest{LiveInstanceIds: []string{a.GetInstanceId()}})
 	require.NoError(t, err)
 	assert.Equal(t, uint32(2), r.GetReleased())
 	run(t, d, a.GetInstanceId(), &proto.SandboxExecSpec{Command: "true"})
+	d.lock.Lock()
+	assert.Len(t, d.live, 1)
+	d.lock.Unlock()
+	for _, id := range released {
+		_, err := d.Exec(t.Context(), &proto.SandboxExecRequest{InstanceId: id, Spec: &proto.SandboxExecSpec{Command: "true"}})
+		assert.Equal(t, codes.NotFound, status.Code(err))
