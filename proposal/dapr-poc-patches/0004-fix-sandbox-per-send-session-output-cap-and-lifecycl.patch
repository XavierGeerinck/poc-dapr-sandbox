Subject: [PATCH 04/15] fix(sandbox): per-send session output cap and lifecycle
 tests

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/components/sandbox/process/process.go     |   9 +-
 .../sandbox/process/process_test.go           | 103 +++++++++++++++++-
 2 files changed, 107 insertions(+), 5 deletions(-)

diff --git a/pkg/components/sandbox/process/process.go b/pkg/components/sandbox/process/process.go
index df414df6f..068029d50 100644
--- a/pkg/components/sandbox/process/process.go
+++ b/pkg/components/sandbox/process/process.go
@@ -565,8 +565,8 @@ func (i *instance) session(id string) (*session, error) {
 // SessionSend writes input to the session and returns the output produced
 // since the call started, once `until` appears in stdout or stderr, the
 // process exits, or timeout_ms elapses (timed_out=true, no error). With an
-// empty `until` it simply waits timeout_ms. Output produced between sends is
-// not returned by the following send.
+// empty `until` it simply waits timeout_ms. The 4 MiB per-stream cap applies per send; output
+// produced between sends is discarded when the next send starts.
 func (p *Process) SessionSend(ctx context.Context, req *proto.SandboxSessionSendRequest) (*proto.SandboxExecResponse, error) {
 	inst, err := p.get(req.GetInstanceId())
 	if err != nil {
@@ -588,8 +588,11 @@ func (p *Process) SessionSend(ctx context.Context, req *proto.SandboxSessionSend
 	timer := time.NewTimer(timeout)
 	defer timer.Stop()
 
+	// Discard anything produced while no send was in progress and start a
+	// fresh capped window, so the 4 MiB cap and the truncated flag are per send.
 	s.lock.Lock()
-	startOut, startErr := len(s.out), len(s.errb)
+	s.out, s.errb, s.truncated = nil, nil, false
+	startOut, startErr := 0, 0
 	s.lock.Unlock()
 
 	if in := req.GetInput(); len(in) > 0 {
diff --git a/pkg/components/sandbox/process/process_test.go b/pkg/components/sandbox/process/process_test.go
