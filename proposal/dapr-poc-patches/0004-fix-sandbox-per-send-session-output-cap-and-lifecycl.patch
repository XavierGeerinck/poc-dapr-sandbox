+}
+
+func TestReadyFalseBeforePoolFull(t *testing.T) {
+	d := New(logger.NewLogger("test")).(*Process)
+	// Hold the initial fill back so the pool is observably not full.
+	d.cfg.WarmPoolSize = 2
+	d.ctx, d.cancel = context.WithCancel(context.Background())
+	t.Cleanup(func() { _ = d.Close() })
+	r, err := d.Ready(t.Context(), &proto.SandboxReadyRequest{})
+	require.NoError(t, err)
+	assert.False(t, r.GetReady())
+	assert.NotEmpty(t, r.GetReason())
+
+	d.topUp(0)
+	assert.Eventually(t, func() bool {
+		r, _ := d.Ready(t.Context(), &proto.SandboxReadyRequest{})
+		return r.GetReady()
+	}, 5*time.Second, 5*time.Millisecond)
+}
+
+func TestCloseStopsRefillAndDestroysLive(t *testing.T) {
+	d := newDriverDelay(t, map[string]string{"warmPoolSize": "1"}, 200*time.Millisecond)
+	a := acquire(t, d) // pool hit; refill is pending behind the delay
+	d.lock.Lock()
+	inst := d.live[a.GetInstanceId()]
+	d.lock.Unlock()
+	require.NotNil(t, inst)
+	_, err := os.Stat(inst.dir)
+	require.NoError(t, err)
+
+	require.NoError(t, d.Close())
+	_, err = os.Stat(inst.dir)
+	assert.True(t, os.IsNotExist(err), "live instance dir should be removed")
+
+	time.Sleep(400 * time.Millisecond) // longer than the refill delay
+	d.lock.Lock()
+	assert.Empty(t, d.pool)
+	assert.Zero(t, d.inflight)
+	d.lock.Unlock()
+	_, err = d.Acquire(t.Context(), &proto.SandboxAcquireRequest{})
+	assert.Equal(t, codes.Unavailable, status.Code(err))
+}
+
+func TestReleaseKillsInFlightExec(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	type res struct {
+		r   *proto.SandboxExecResponse
+		err error
+	}
+	ch := make(chan res, 1)
+	go func() {
+		r, err := d.Exec(context.Background(), &proto.SandboxExecRequest{
+			InstanceId: a.GetInstanceId(), Spec: &proto.SandboxExecSpec{Command: "sleep", Args: []string{"30"}},
+		})
+		ch <- res{r, err}
+	}()
+	time.Sleep(100 * time.Millisecond) // let the child start
+	_, err := d.Release(t.Context(), &proto.SandboxReleaseRequest{InstanceId: a.GetInstanceId()})
+	require.NoError(t, err)
+	select {
+	case x := <-ch:
+		require.NoError(t, x.err)
+		assert.NotZero(t, x.r.GetExitCode())
+	case <-time.After(3 * time.Second):
+		t.Fatal("Exec did not return after Release")
+	}
+}
+
+func TestSessionOutputCapPerSend(t *testing.T) {
+	d := newDriver(t, nil)
+	a := acquire(t, d)
+	s, err := d.SessionStart(t.Context(), &proto.SandboxSessionStartRequest{
+		InstanceId: a.GetInstanceId(), Spec: &proto.SandboxExecSpec{Command: "sh"},
+	})
+	require.NoError(t, err)
+	send := func(in, until string) *proto.SandboxExecResponse {
+		r, err := d.SessionSend(t.Context(), &proto.SandboxSessionSendRequest{
+			InstanceId: a.GetInstanceId(), SessionId: s.GetSessionId(), Input: []byte(in), Until: []byte(until), TimeoutMs: 10000,
+		})
+		require.NoError(t, err)
+		return r
+	}
+	r := send("head -c 10485760 /dev/zero; echo big-done >&2\n", "big-done")
+	assert.True(t, r.GetTruncated())
+	assert.Len(t, r.GetStdout(), 4194304)
+	assert.Contains(t, string(r.GetStderr()), "big-done")
+
+	r = send("echo second\n", "second")
+	assert.False(t, r.GetTruncated())
+	assert.False(t, r.GetTimedOut())
+	assert.Equal(t, "second\n", string(r.GetStdout()))
 }
