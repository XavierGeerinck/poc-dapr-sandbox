+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package sandbox
+
+import (
+	"context"
+	"slices"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"k8s.io/utils/clock"
+
+	"github.com/dapr/dapr/pkg/actors/api"
+	"github.com/dapr/dapr/pkg/actors/targets"
+	"github.com/dapr/dapr/pkg/components/sandbox"
+	compv1pb "github.com/dapr/dapr/pkg/proto/components/v1"
+	"github.com/dapr/kit/events/queue"
+)
+
+const (
+	// DefaultIdleTimeout is used when Options.IdleTimeout is not positive.
+	DefaultIdleTimeout = 5 * time.Minute
+
+	// releaseTimeout bounds each background driver Release call.
+	releaseTimeout = 10 * time.Second
+
+	// idleSlack covers the idler queue firing an item slightly before its
+	// scheduled time.
+	idleSlack = time.Millisecond
+)
+
+// Options configures the actor targets of one sandbox component.
+type Options struct {
+	// ActorType is the internal actor type, for example
+	// `dapr.internal.<namespace>.<appID>.sandbox.<component>`.
+	ActorType string
+	// Component is the name of the sandbox component.
+	Component string
+	// Driver provides the sandbox VMs.
+	Driver sandbox.Sandbox
+	// IdleTimeout is how long a sandbox may go without calls before its VM is
+	// released. Defaults to DefaultIdleTimeout.
+	IdleTimeout time.Duration
+	// Clock defaults to the real clock.
+	Clock clock.Clock
+}
+
+// Factory creates and tracks the sandbox actor targets of one sandbox
+// component. It implements targets.Factory.
+//
+// Locking: a target's turn lock may be held while taking Factory.lock, never
+// the other way round, and Factory.lock is never held while calling the
+// driver.
+type Factory struct {
+	actorType   string
+	component   string
+	driver      sandbox.Sandbox
+	idleTimeout time.Duration
+	clock       clock.Clock
+	idlerQueue  *queue.Processor[string, *target]
+
+	// lock guards table and each target's instanceID and removed fields. A
+	// target is in table exactly while its removed field is false.
+	lock  sync.RWMutex
+	table map[string]*target
+}
+
+var _ targets.Factory = (*Factory)(nil)
+
+// New returns a Factory for one sandbox component.
+func New(opts Options) *Factory {
+	if opts.Clock == nil {
+		opts.Clock = clock.RealClock{}
+	}
+	if opts.IdleTimeout <= 0 {
+		opts.IdleTimeout = DefaultIdleTimeout
+	}
+
+	f := &Factory{
+		actorType:   opts.ActorType,
+		component:   opts.Component,
+		driver:      opts.Driver,
+		idleTimeout: opts.IdleTimeout,
+		clock:       opts.Clock,
+		table:       make(map[string]*target),
+	}
+
+	f.idlerQueue = queue.NewProcessor[string, *target](queue.Options[string, *target]{
+		ExecuteFn: f.handleIdle,
+		Clock:     f.clock,
+	})
+
+	return f
+}
+
+// GetOrCreate returns the target for the sandbox ID, creating it with a new
+// activation token if there is none. It does not touch the driver: the VM is
+// acquired on the first call.
+func (f *Factory) GetOrCreate(actorID string) targets.Interface {
+	f.lock.RLock()
+	t, ok := f.table[actorID]
+	f.lock.RUnlock()
+	if ok {
+		return t
+	}
+
+	f.lock.Lock()
+	defer f.lock.Unlock()
+
+	if t, ok = f.table[actorID]; ok {
+		return t
+	}
+
+	t = &target{
+		factory:    f,
+		actorID:    actorID,
+		activation: uuid.NewString(),
+	}
+	t.idleAt.Store(new(f.clock.Now().Add(f.idleTimeout)))
+	f.table[actorID] = t
+	f.idlerQueue.Enqueue(t)
+
+	return t
+}
+
+// Exists reports whether a target for the sandbox ID is active.
+func (f *Factory) Exists(actorID string) bool {
+	f.lock.RLock()
+	defer f.lock.RUnlock()
+	_, ok := f.table[actorID]
+	return ok
+}
+
+// Len returns the number of active targets.
+func (f *Factory) Len() int {
+	f.lock.RLock()
+	defer f.lock.RUnlock()
+	return len(f.table)
+}
+
+// LiveInstanceIDs returns the driver instance IDs held by active targets, for
+// the driver's Reconcile.
+func (f *Factory) LiveInstanceIDs() []string {
+	f.lock.RLock()
+	ids := make([]string, 0, len(f.table))
+	for _, t := range f.table {
+		if t.instanceID != "" {
+			ids = append(ids, t.instanceID)
+		}
+	}
+	f.lock.RUnlock()
+
+	slices.Sort(ids)
+	return ids
+}
+
+// HaltAll removes every target and releases their VMs in the background. It
+// does not wait for the driver.
+func (f *Factory) HaltAll(context.Context) error {
+	f.haltWhere(func(string) bool { return true })
+	return nil
+}
+
+// HaltNonHosted removes the targets that fn reports as no longer hosted here
+// and releases their VMs in the background. It does not wait for the driver.
+func (f *Factory) HaltNonHosted(_ context.Context, fn func(*api.LookupActorRequest) bool) error {
+	f.haltWhere(func(actorID string) bool {
+		return !fn(&api.LookupActorRequest{
+			ActorType: f.actorType,
+			ActorID:   actorID,
+		})
+	})
+	return nil
+}
+
+func (f *Factory) haltWhere(halt func(actorID string) bool) {
+	f.lock.RLock()
+	all := make([]*target, 0, len(f.table))
+	for _, t := range f.table {
+		all = append(all, t)
+	}
+	f.lock.RUnlock()
+
+	for _, t := range all {
+		if halt(t.actorID) {
+			log.Debugf("Halting sandbox actor '%s'", t.Key())
+			f.remove(t)
+		}
+	}
+}
+
+// remove takes t out of the table and releases its VM, if it has one, in
+// the background. It is idempotent: a later call for the same sandbox ID
+// gets a new target with a new activation token.
+func (f *Factory) remove(t *target) {
+	f.lock.Lock()
+	instanceID, ok := f.removeLocked(t)
+	f.lock.Unlock()
+
+	if ok && instanceID != "" {
+		f.releaseAsync(instanceID)
+	}
+}
+
+// removeLocked must be called with f.lock held for writing. It reports
+// whether t was still in the table and returns its instance ID.
+func (f *Factory) removeLocked(t *target) (string, bool) {
+	if t.removed {
+		return "", false
+	}
+	t.removed = true
+	delete(f.table, t.actorID)
+	// While t was in the table no other target had its key, so the queued
+	// item for the key, if any, is t's.
+	f.idlerQueue.Dequeue(t.Key())
+	return t.instanceID, true
+}
+
+// handleIdle is called by the idler queue when a target's idle deadline
+// passed.
+func (f *Factory) handleIdle(t *target) {
+	f.lock.Lock()
+
+	if t.removed {
+		f.lock.Unlock()
+		return
+	}
+
+	// A call that is waiting or running keeps the sandbox: check again one
+	// idle period from now (the call also re-arms the timer when it ends).
+	if t.inflight.Load() > 0 {
+		t.touchIdleLocked()
+		f.lock.Unlock()
+		return
+	}
+
+	// A call that ended after the processor popped this item already pushed
+	// the deadline back and re-queued t. The processor may fire up to 500µs
+	// early, so a deadline that close still counts as reached.
+	if f.clock.Now().Add(idleSlack).Before(*t.idleAt.Load()) {
+		f.lock.Unlock()
+		return
+	}
+
+	log.Debugf("Sandbox actor '%s' is idle, releasing it", t.Key())
+	instanceID, ok := f.removeLocked(t)
+	f.lock.Unlock()
+
+	if ok && instanceID != "" {
+		f.releaseAsync(instanceID)
+	}
+}
+
+// releaseAsync releases a driver instance in the background. Errors are
+// logged: the driver's Reconcile cleans up anything left behind.
+func (f *Factory) releaseAsync(instanceID string) {
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), releaseTimeout)
+		defer cancel()
+
+		_, err := f.driver.Release(ctx, &compv1pb.SandboxReleaseRequest{InstanceId: instanceID})
+		switch {
+		case err == nil:
+			log.Debugf("Released sandbox instance '%s' of component '%s'", instanceID, f.component)
+		case status.Code(err) == codes.NotFound:
+			log.Debugf("Sandbox instance '%s' of component '%s' was already gone", instanceID, f.component)
+		default:
+			log.Errorf("Failed to release sandbox instance '%s' of component '%s': %v", instanceID, f.component, err)
+		}
+	}()
+}
+
+// sinceUs returns the microseconds elapsed since start on the factory clock.
+func (f *Factory) sinceUs(start time.Time) uint64 {
+	d := f.clock.Since(start)
+	if d <= 0 {
+		return 0
+	}
+	return uint64(d.Microseconds())
+}
