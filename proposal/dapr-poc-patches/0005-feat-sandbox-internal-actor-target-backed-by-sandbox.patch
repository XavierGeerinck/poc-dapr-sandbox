+
+const testActorType = "dapr.internal.default.app.sandbox.mysandbox"
+
+var _ targets.Factory = (*Factory)(nil)
+
+// fakeDriver is a deterministic sandbox.Sandbox that counts calls and can be
+// told to delay or fail.
+type fakeDriver struct {
+	acquireCount atomic.Int32
+	execCount    atomic.Int32
+	releaseCount atomic.Int32
+	// releaseStarted counts Release calls, including ones still blocked.
+	releaseStarted atomic.Int32
+
+	acquireDelay time.Duration
+	execDelay    time.Duration
+	acquireErr   error
+	execErr      error
+	// releaseBlock, when set, makes Release wait until it is closed (or the
+	// context is done).
+	releaseBlock chan struct{}
+	// execStarted and execBlock, when set, make Exec signal that it started
+	// and wait until execBlock is closed.
+	execStarted chan struct{}
+	execBlock   chan struct{}
+
+	nextID atomic.Int32
+
+	lock     sync.Mutex
+	released []string
+	execs    []*compv1pb.SandboxExecRequest
+	sends    []*compv1pb.SandboxSessionSendRequest
+	starts   []*compv1pb.SandboxSessionStartRequest
+	closes   []*compv1pb.SandboxSessionCloseRequest
+}
+
+var _ sandbox.Sandbox = (*fakeDriver)(nil)
+
+func (d *fakeDriver) Init(context.Context, metadata.Base) error { return nil }
+func (d *fakeDriver) Close() error                              { return nil }
+
+func (d *fakeDriver) Ready(context.Context, *compv1pb.SandboxReadyRequest) (*compv1pb.SandboxReadyResponse, error) {
+	return &compv1pb.SandboxReadyResponse{Ready: true}, nil
+}
+
+func (d *fakeDriver) Acquire(ctx context.Context, req *compv1pb.SandboxAcquireRequest) (*compv1pb.SandboxAcquireResponse, error) {
+	d.acquireCount.Add(1)
+	if d.acquireDelay > 0 {
+		time.Sleep(d.acquireDelay)
+	}
+	if d.acquireErr != nil {
+		return nil, d.acquireErr
+	}
+	return &compv1pb.SandboxAcquireResponse{
+		InstanceId: "inst-" + strconv.Itoa(int(d.nextID.Add(1))),
+		Path:       compv1pb.SandboxAcquirePath_POOL,
+	}, nil
+}
+
+func (d *fakeDriver) Exec(ctx context.Context, req *compv1pb.SandboxExecRequest) (*compv1pb.SandboxExecResponse, error) {
+	d.execCount.Add(1)
+	d.lock.Lock()
+	d.execs = append(d.execs, req)
+	d.lock.Unlock()
+	if d.execStarted != nil {
+		d.execStarted <- struct{}{}
+	}
+	if d.execBlock != nil {
+		<-d.execBlock
+	}
+	if d.execDelay > 0 {
+		time.Sleep(d.execDelay)
+	}
+	if d.execErr != nil {
+		return nil, d.execErr
+	}
+	return &compv1pb.SandboxExecResponse{
+		Stdout:   []byte("out:" + req.GetSpec().GetCommand()),
+		Stderr:   []byte("err"),
+		ExitCode: 3,
+	}, nil
+}
+
+func (d *fakeDriver) SessionStart(ctx context.Context, req *compv1pb.SandboxSessionStartRequest) (*compv1pb.SandboxSessionStartResponse, error) {
+	d.lock.Lock()
+	d.starts = append(d.starts, req)
+	d.lock.Unlock()
+	return &compv1pb.SandboxSessionStartResponse{SessionId: "sess-1"}, nil
+}
+
+func (d *fakeDriver) SessionSend(ctx context.Context, req *compv1pb.SandboxSessionSendRequest) (*compv1pb.SandboxExecResponse, error) {
+	d.lock.Lock()
+	d.sends = append(d.sends, req)
+	d.lock.Unlock()
+	if d.execDelay > 0 {
+		time.Sleep(d.execDelay)
+	}
+	return &compv1pb.SandboxExecResponse{Stdout: append([]byte("echo:"), req.GetInput()...), TimedOut: true}, nil
+}
+
+func (d *fakeDriver) SessionClose(ctx context.Context, req *compv1pb.SandboxSessionCloseRequest) (*compv1pb.SandboxSessionCloseResponse, error) {
+	d.lock.Lock()
+	d.closes = append(d.closes, req)
+	d.lock.Unlock()
+	return &compv1pb.SandboxSessionCloseResponse{}, nil
+}
+
+func (d *fakeDriver) Release(ctx context.Context, req *compv1pb.SandboxReleaseRequest) (*compv1pb.SandboxReleaseResponse, error) {
+	d.releaseStarted.Add(1)
+	if d.releaseBlock != nil {
+		select {
+		case <-d.releaseBlock:
+		case <-ctx.Done():
+		}
+	}
+	d.lock.Lock()
+	d.released = append(d.released, req.GetInstanceId())
+	d.lock.Unlock()
+	d.releaseCount.Add(1)
+	return &compv1pb.SandboxReleaseResponse{}, nil
+}
+
+func (d *fakeDriver) Reconcile(context.Context, *compv1pb.SandboxReconcileRequest) (*compv1pb.SandboxReconcileResponse, error) {
+	return &compv1pb.SandboxReconcileResponse{}, nil
+}
+
+func (d *fakeDriver) releasedIDs() []string {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	return append([]string(nil), d.released...)
+}
+
+func newFactory(t *testing.T, d *fakeDriver, opts ...func(*Options)) *Factory {
+	t.Helper()
+	o := Options{
+		ActorType:   testActorType,
+		Component:   "mysandbox",
+		Driver:      d,
+		IdleTimeout: 5 * time.Minute,
+	}
+	for _, fn := range opts {
+		fn(&o)
+	}
+	f := New(o)
+	t.Cleanup(func() {
+		require.NoError(t, f.HaltAll(context.Background()))
+	})
+	return f
+}
+
+func invoke(t *testing.T, f *Factory, id, method string, in proto.Message) (*internalv1pb.InternalInvokeResponse, error) {
+	t.Helper()
+	var data []byte
+	if in != nil {
+		var err error
+		data, err = proto.Marshal(in)
+		require.NoError(t, err)
+	}
+	req := internalv1pb.NewInternalInvokeRequest(method).
+		WithActor(testActorType, id).
+		WithData(data).
+		WithContentType(internalv1pb.ProtobufContentType)
+	return f.GetOrCreate(id).InvokeMethod(t.Context(), req)
+}
+
+func execOK(t *testing.T, f *Factory, id string, in *runtimev1pb.SandboxExecRequestAlpha1) *runtimev1pb.SandboxExecResponseAlpha1 {
+	t.Helper()
+	res, err := invoke(t, f, id, MethodExec, in)
+	require.NoError(t, err)
+	var out runtimev1pb.SandboxExecResponseAlpha1
+	require.NoError(t, proto.Unmarshal(res.GetMessage().GetData().GetValue(), &out))
+	return &out
+}
+
+func requireLost(t *testing.T, err error) {
+	t.Helper()
+	require.Error(t, err)
+	s, ok := status.FromError(err)
+	require.True(t, ok, "expected a gRPC status, got %v", err)
+	assert.Equal(t, codes.FailedPrecondition, s.Code())
+	var found bool
+	for _, d := range s.Details() {
+		if info, ok := d.(*errdetails.ErrorInfo); ok {
+			assert.Equal(t, ReasonSandboxLost, info.GetReason())
+			assert.Equal(t, ErrorDomain, info.GetDomain())
+			found = true
+		}
+	}
+	assert.True(t, found, "expected an ErrorInfo detail")
+	assert.True(t, IsSandboxLost(err))
+}
+
+// stepUntil keeps stepping the fake clock until cond holds. The idler queue
+// reads Now before it arms a timer, so a Step landing in between arms the
+// timer late by that step; checks that something does happen therefore keep
+// stepping, while checks that nothing happens yet use a single Step.
+func stepUntil(t *testing.T, clock *clocktesting.FakeClock, cond func() bool) {
+	t.Helper()
+	assert.Eventually(t, func() bool {
+		if cond() {
+			return true
+		}
+		clock.Step(10 * time.Second)
+		return false
+	}, 5*time.Second, 10*time.Millisecond)
+}
+
+func TestFirstCallAcquiresOnce(t *testing.T) {
+	d := &fakeDriver{acquireDelay: 50 * time.Millisecond}
+	f := newFactory(t, d)
+
+	var wg sync.WaitGroup
+	results := make([]*runtimev1pb.SandboxExecResponseAlpha1, 2)
+	for i := range results {
+		wg.Go(func() {
+			results[i] = execOK(t, f, "sb1", &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+		})
+	}
+	wg.Wait()
+
+	assert.Equal(t, int32(1), d.acquireCount.Load())
+	assert.Equal(t, int32(2), d.execCount.Load())
+	require.NotEmpty(t, results[0].GetActivation())
+	assert.Equal(t, results[0].GetActivation(), results[1].GetActivation())
+	assert.Equal(t, "sb1", results[0].GetSandboxId())
+	assert.Equal(t, []byte("out:ls"), results[0].GetStdout())
+	assert.Equal(t, int32(3), results[0].GetExitCode())
+	assert.Equal(t, []string{"inst-1"}, f.LiveInstanceIDs())
+}
+
+func TestExpectedActivationMismatch(t *testing.T) {
+	d := &fakeDriver{}
+	f := newFactory(t, d)
+
+	_, err := invoke(t, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{
+		Command:            "ls",
+		ExpectedActivation: "stale-token",
+	})
+	requireLost(t, err)
+	assert.Equal(t, int32(0), d.acquireCount.Load())
+	assert.Equal(t, int32(0), d.execCount.Load())
+	assert.False(t, f.Exists("sb1"))
+
+	t.Run("live sandbox is kept for other callers", func(t *testing.T) {
+		res := execOK(t, f, "sb2", &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+
+		_, err := invoke(t, f, "sb2", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{
+			Command:            "ls",
+			ExpectedActivation: "stale-token",
+		})
+		requireLost(t, err)
+		assert.True(t, f.Exists("sb2"))
+		assert.Equal(t, int32(0), d.releaseCount.Load())
+
+		again := execOK(t, f, "sb2", &runtimev1pb.SandboxExecRequestAlpha1{
+			Command:            "ls",
+			ExpectedActivation: res.GetActivation(),
+		})
+		assert.Equal(t, res.GetActivation(), again.GetActivation())
+		assert.Equal(t, int32(1), d.acquireCount.Load())
+	})
+}
+
+func TestHostFullRemovesTarget(t *testing.T) {
+	d := &fakeDriver{acquireErr: status.Error(codes.ResourceExhausted, "host is full")}
+	f := newFactory(t, d)
+
+	_, err := invoke(t, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+	require.Error(t, err)
+	assert.Equal(t, codes.ResourceExhausted, status.Code(err))
+	assert.False(t, f.Exists("sb1"))
+	assert.Equal(t, 0, f.Len())
+	assert.Empty(t, f.LiveInstanceIDs())
+
+	_, err = invoke(t, f, "sb1", MethodActivate, &runtimev1pb.SandboxCreateRequestAlpha1{})
+	assert.Equal(t, codes.ResourceExhausted, status.Code(err))
+	assert.False(t, f.Exists("sb1"))
+}
+
