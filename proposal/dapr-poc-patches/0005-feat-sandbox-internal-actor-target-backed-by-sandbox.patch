+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Package sandbox implements the internal actor target of the Sandbox
+// building block: each sandbox ID is an actor whose VM comes from a sandbox
+// driver.
+package sandbox
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"google.golang.org/genproto/googleapis/rpc/errdetails"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/anypb"
+
+	"github.com/dapr/dapr/pkg/actors/api"
+	targetserrors "github.com/dapr/dapr/pkg/actors/targets/errors"
+	commonv1pb "github.com/dapr/dapr/pkg/proto/common/v1"
+	compv1pb "github.com/dapr/dapr/pkg/proto/components/v1"
+	internalv1pb "github.com/dapr/dapr/pkg/proto/internals/v1"
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+	"github.com/dapr/kit/logger"
+)
+
+var log = logger.NewLogger("dapr.runtime.actors.targets.sandbox")
+
+// Actor methods. Request and response data are proto-marshalled runtime
+// messages.
+const (
+	// MethodActivate acquires the VM if needed (idempotent).
+	// SandboxCreateRequestAlpha1 -> SandboxCreateResponseAlpha1.
+	MethodActivate = "activate"
+	// MethodExec runs a one-shot command.
+	// SandboxExecRequestAlpha1 -> SandboxExecResponseAlpha1.
+	MethodExec = "exec"
+	// MethodRelease releases the VM and removes the sandbox.
+	// SandboxDeleteRequestAlpha1 -> empty data.
+	MethodRelease = "release"
+	// MethodSessionStart starts a long-lived process.
+	// SandboxSessionStartRequestAlpha1 -> SandboxSessionStartResponseAlpha1.
+	MethodSessionStart = "session.start"
+	// MethodSessionSend writes to a session and reads its output.
+	// SandboxSessionSendRequestAlpha1 -> SandboxExecResponseAlpha1.
+	MethodSessionSend = "session.send"
+	// MethodSessionClose closes a session.
+	// SandboxSessionCloseRequestAlpha1 -> empty data.
+	MethodSessionClose = "session.close"
+)
+
+const (
+	// ReasonSandboxLost is the ErrorInfo reason of the "sandbox lost" error:
+	// the caller's expected activation token no longer matches, or the
+	// driver no longer knows the sandbox's VM.
+	ReasonSandboxLost = "DAPR_SANDBOX_LOST"
+	// ErrorDomain is the ErrorInfo domain of the errors of this package.
+	ErrorDomain = "dapr.io"
+)
+
+// ErrSandboxLost returns the "sandbox lost" error: FailedPrecondition with an
+// ErrorInfo detail whose reason is ReasonSandboxLost.
+func ErrSandboxLost() error {
+	st, err := status.New(codes.FailedPrecondition, "sandbox lost").WithDetails(&errdetails.ErrorInfo{
+		Reason: ReasonSandboxLost,
+		Domain: ErrorDomain,
+	})
+	if err != nil {
+		return status.Error(codes.FailedPrecondition, "sandbox lost")
+	}
+	return st.Err()
+}
+
+// IsSandboxLost reports whether err is the "sandbox lost" error.
+func IsSandboxLost(err error) bool {
+	st, ok := status.FromError(err)
+	if !ok || st.Code() != codes.FailedPrecondition {
+		return false
+	}
+	for _, d := range st.Details() {
+		if info, ok := d.(*errdetails.ErrorInfo); ok && info.GetReason() == ReasonSandboxLost {
+			return true
+		}
+	}
+	return false
+}
+
+// target is the actor for one sandbox ID.
+type target struct {
+	factory *Factory
+
+	actorID    string
+	activation string
+
+	// idleAt is when the target becomes idle; it is pushed back at the start
+	// and the end of every call.
+	idleAt atomic.Pointer[time.Time]
+	// inflight counts calls that entered InvokeMethod and have not returned.
+	// It is only incremented while holding factory.lock for reading, so
+	// holding it for writing gives a stable value.
+	inflight atomic.Int32
+
+	// lock makes calls turn-based: every InvokeMethod holds it for the whole
+	// call.
+	lock sync.Mutex
+
+	// instanceID is the driver instance, or "" before it was acquired. It is
+	// written while holding both lock and factory.lock; reading it requires
+	// either.
+	instanceID string
+	// removed is set once the target left the table. Guarded by
+	// factory.lock.
+	removed bool
+}
+
+// InvokeMethod runs one sandbox operation. The VM is acquired on the first
+// call that needs it.
+func (t *target) InvokeMethod(ctx context.Context, req *internalv1pb.InternalInvokeRequest) (*internalv1pb.InternalInvokeResponse, error) {
+	start := t.factory.clock.Now()
+	method := req.GetMessage().GetMethod()
+
+	if !t.enter() {
+		return nil, targetserrors.NewClosed(method)
+	}
+	defer t.exit()
+
+	t.lock.Lock()
+	defer t.lock.Unlock()
+
+	// The target may have been removed while this call waited for its turn.
+	// The router then retries on a new target.
+	if t.isRemoved() {
+		return nil, targetserrors.NewClosed(method)
+	}
+
+	data := req.GetMessage().GetData().GetValue()
+
+	var (
+		res proto.Message
+		err error
+	)
+	switch method {
+	case MethodActivate:
+		res, err = t.activate(ctx, data, start)
+	case MethodExec:
+		res, err = t.exec(ctx, data, start)
+	case MethodRelease:
+		err = t.release(data)
+	case MethodSessionStart:
+		res, err = t.sessionStart(ctx, data)
+	case MethodSessionSend:
+		res, err = t.sessionSend(ctx, data, start)
+	case MethodSessionClose:
+		err = t.sessionClose(ctx, data)
+	default:
+		return nil, status.Errorf(codes.InvalidArgument, "unknown sandbox actor method %q", method)
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	return newResponse(res)
+}
+
+func (t *target) activate(ctx context.Context, data []byte, start time.Time) (proto.Message, error) {
+	var req runtimev1pb.SandboxCreateRequestAlpha1
+	if err := unmarshal(MethodActivate, data, &req); err != nil {
+		return nil, err
+	}
+
+	timing := new(runtimev1pb.SandboxTimingAlpha1)
+	if _, err := t.acquire(ctx, timing); err != nil {
+		return nil, err
+	}
+
+	timing.HostUs = t.factory.sinceUs(start)
+	return &runtimev1pb.SandboxCreateResponseAlpha1{
+		SandboxId:  t.actorID,
+		Activation: t.activation,
+		Timing:     timing,
+	}, nil
+}
+
+func (t *target) exec(ctx context.Context, data []byte, start time.Time) (proto.Message, error) {
+	var req runtimev1pb.SandboxExecRequestAlpha1
+	if err := unmarshal(MethodExec, data, &req); err != nil {
+		return nil, err
+	}
+	if err := t.checkActivation(req.GetExpectedActivation()); err != nil {
+		return nil, err
+	}
+
+	timing := new(runtimev1pb.SandboxTimingAlpha1)
+	instanceID, err := t.acquire(ctx, timing)
+	if err != nil {
+		return nil, err
+	}
+
+	execStart := t.factory.clock.Now()
+	res, err := t.factory.driver.Exec(ctx, &compv1pb.SandboxExecRequest{
+		InstanceId: instanceID,
+		Spec: &compv1pb.SandboxExecSpec{
+			Command:   req.GetCommand(),
+			Args:      req.GetArgs(),
+			Env:       req.GetEnv(),
+			Cwd:       req.GetCwd(),
+			Stdin:     req.GetStdin(),
+			TimeoutMs: req.GetTimeoutMs(),
+		},
+	})
+	timing.ExecUs = t.factory.sinceUs(execStart)
+	if err != nil {
+		return nil, t.instanceErr("exec", err)
+	}
+
+	return t.execResponse(res, timing, start), nil
+}
+
+func (t *target) release(data []byte) error {
+	var req runtimev1pb.SandboxDeleteRequestAlpha1
+	if err := unmarshal(MethodRelease, data, &req); err != nil {
+		return err
+	}
+
+	t.factory.remove(t)
+	return nil
+}
+
+func (t *target) sessionStart(ctx context.Context, data []byte) (proto.Message, error) {
+	var req runtimev1pb.SandboxSessionStartRequestAlpha1
+	if err := unmarshal(MethodSessionStart, data, &req); err != nil {
+		return nil, err
+	}
+	if err := t.checkActivation(req.GetExpectedActivation()); err != nil {
+		return nil, err
+	}
+
+	instanceID, err := t.acquire(ctx, new(runtimev1pb.SandboxTimingAlpha1))
+	if err != nil {
+		return nil, err
+	}
+
+	res, err := t.factory.driver.SessionStart(ctx, &compv1pb.SandboxSessionStartRequest{
+		InstanceId: instanceID,
+		Spec: &compv1pb.SandboxExecSpec{
+			Command: req.GetCommand(),
+			Args:    req.GetArgs(),
+			Env:     req.GetEnv(),
+			Cwd:     req.GetCwd(),
+		},
+	})
+	if err != nil {
+		return nil, t.instanceErr("session start", err)
+	}
+
+	return &runtimev1pb.SandboxSessionStartResponseAlpha1{
+		SessionId:  res.GetSessionId(),
+		Activation: t.activation,
+	}, nil
+}
+
+func (t *target) sessionSend(ctx context.Context, data []byte, start time.Time) (proto.Message, error) {
+	var req runtimev1pb.SandboxSessionSendRequestAlpha1
+	if err := unmarshal(MethodSessionSend, data, &req); err != nil {
+		return nil, err
+	}
+	if err := t.checkActivation(req.GetExpectedActivation()); err != nil {
+		return nil, err
+	}
+	// A sandbox without a VM has no sessions: don't acquire one just to fail.
+	if t.instanceID == "" {
+		return nil, unknownSession(req.GetSessionId())
+	}
+
+	timing := new(runtimev1pb.SandboxTimingAlpha1)
+	execStart := t.factory.clock.Now()
+	res, err := t.factory.driver.SessionSend(ctx, &compv1pb.SandboxSessionSendRequest{
+		InstanceId: t.instanceID,
+		SessionId:  req.GetSessionId(),
+		Input:      req.GetInput(),
+		Until:      req.GetUntil(),
+		TimeoutMs:  req.GetTimeoutMs(),
+	})
+	timing.ExecUs = t.factory.sinceUs(execStart)
+	if err != nil {
+		// NotFound here can mean an unknown session, so it is not treated as
+		// a lost sandbox.
+		return nil, driverErr("session send", err)
+	}
+
+	return t.execResponse(res, timing, start), nil
+}
+
+func (t *target) sessionClose(ctx context.Context, data []byte) error {
+	var req runtimev1pb.SandboxSessionCloseRequestAlpha1
+	if err := unmarshal(MethodSessionClose, data, &req); err != nil {
+		return err
+	}
+	if t.instanceID == "" {
+		return unknownSession(req.GetSessionId())
+	}
+
+	_, err := t.factory.driver.SessionClose(ctx, &compv1pb.SandboxSessionCloseRequest{
+		InstanceId: t.instanceID,
+		SessionId:  req.GetSessionId(),
+	})
+	if err != nil {
+		return driverErr("session close", err)
+	}
+	return nil
+}
+
+func (t *target) execResponse(res *compv1pb.SandboxExecResponse, timing *runtimev1pb.SandboxTimingAlpha1, start time.Time) *runtimev1pb.SandboxExecResponseAlpha1 {
+	timing.HostUs = t.factory.sinceUs(start)
+	return &runtimev1pb.SandboxExecResponseAlpha1{
+		SandboxId:  t.actorID,
+		Activation: t.activation,
+		Stdout:     res.GetStdout(),
+		Stderr:     res.GetStderr(),
+		ExitCode:   res.GetExitCode(),
+		Truncated:  res.GetTruncated(),
+		TimedOut:   res.GetTimedOut(),
+		Timing:     timing,
+	}
+}
+
+// checkActivation returns the "sandbox lost" error if the caller expects a
+// different activation than this one. Must be called with t.lock held.
+func (t *target) checkActivation(expected string) error {
+	if expected == "" || expected == t.activation {
+		return nil
+	}
+	// A target without a VM exists only because of this call, so drop it.
+	// One with a VM is a newer activation that other callers may be using.
+	if t.instanceID == "" {
+		t.factory.remove(t)
+	}
+	return ErrSandboxLost()
+}
+
+// acquire returns the target's driver instance, acquiring it on first use
+// and recording the activation time and path in timing. On a driver error
+// the target is removed: it holds no VM, and a later call starts over with a
+// new activation. Must be called with t.lock held.
+func (t *target) acquire(ctx context.Context, timing *runtimev1pb.SandboxTimingAlpha1) (string, error) {
+	if t.instanceID != "" {
+		return t.instanceID, nil
+	}
+
+	f := t.factory
+	start := f.clock.Now()
+	res, err := f.driver.Acquire(ctx, &compv1pb.SandboxAcquireRequest{
+		SandboxId:    t.actorID,
+		ActivationId: t.activation,
+	})
+	activateUs := f.sinceUs(start)
+	if err == nil && res.GetInstanceId() == "" {
+		err = status.Error(codes.Internal, "sandbox driver returned no instance ID")
+	}
+	if err != nil {
+		f.remove(t)
+		return "", driverErr("acquire", err)
+	}
+
+	f.lock.Lock()
+	if t.removed {
+		// Halted or idle while acquiring: hand the VM straight back and let
+		// the router retry on a new target. No command ran yet.
+		f.lock.Unlock()
+		f.releaseAsync(res.GetInstanceId())
+		return "", targetserrors.NewClosed("acquire")
+	}
+	t.instanceID = res.GetInstanceId()
+	f.lock.Unlock()
+
+	timing.ActivateUs = activateUs
+	if path := res.GetPath(); path != compv1pb.SandboxAcquirePath_SANDBOX_ACQUIRE_PATH_UNSPECIFIED {
+		timing.AcquirePath = path.String()
+	}
+	return t.instanceID, nil
+}
+
+// instanceErr maps a driver error for a call on the instance itself: NotFound
+// means the VM is gone, so the sandbox is lost and the target is removed.
+func (t *target) instanceErr(op string, err error) error {
+	if status.Code(err) == codes.NotFound {
+		log.Debugf("Sandbox actor '%s' lost its instance: %v", t.Key(), err)
+		t.factory.remove(t)
+		return ErrSandboxLost()
+	}
+	return driverErr(op, err)
+}
+
+// enter registers a call and pushes back the idle deadline. It returns false
+// if the target was already removed.
+func (t *target) enter() bool {
+	t.factory.lock.RLock()
+	defer t.factory.lock.RUnlock()
+
+	if t.removed {
+		return false
+	}
+	t.inflight.Add(1)
+	t.touchIdleLocked()
+	return true
+}
+
+// exit ends a call and restarts the idle period.
+func (t *target) exit() {
+	t.factory.lock.RLock()
+	defer t.factory.lock.RUnlock()
+
+	t.inflight.Add(-1)
+	if !t.removed {
+		t.touchIdleLocked()
+	}
+}
+
+// touchIdleLocked must be called with factory.lock held and t not removed.
+func (t *target) touchIdleLocked() {
+	t.idleAt.Store(new(t.factory.clock.Now().Add(t.factory.idleTimeout)))
+	t.factory.idlerQueue.Enqueue(t)
+}
+
+func (t *target) isRemoved() bool {
+	t.factory.lock.RLock()
+	defer t.factory.lock.RUnlock()
+	return t.removed
+}
+
+func (t *target) InvokeReminder(context.Context, *api.Reminder) error {
+	return status.Error(codes.Unimplemented, "sandbox actors do not support reminders")
+}
+
+func (t *target) InvokeTimer(context.Context, *api.Reminder) error {
+	return status.Error(codes.Unimplemented, "sandbox actors do not support timers")
+}
+
+func (t *target) InvokeStream(context.Context, *internalv1pb.InternalInvokeRequest, func(*internalv1pb.InternalInvokeResponse) (bool, error)) error {
+	return status.Error(codes.Unimplemented, "sandbox actors do not support streams")
+}
+
+// Deactivate removes the target and releases its VM in the background. It
+// does not wait for the driver or for a running call.
+func (t *target) Deactivate(context.Context) error {
+	t.factory.remove(t)
+	return nil
+}
+
+// Key returns the key for this unique actor.
+func (t *target) Key() string {
+	return t.factory.actorType + api.DaprSeparator + t.actorID
+}
+
+// Type returns the actor type.
+func (t *target) Type() string {
+	return t.factory.actorType
+}
+
+// ID returns the sandbox ID.
+func (t *target) ID() string {
+	return t.actorID
+}
+
+// ScheduledTime returns when the target becomes idle, for the idler queue.
+func (t *target) ScheduledTime() time.Time {
+	return *t.idleAt.Load()
+}
+
+func newResponse(msg proto.Message) (*internalv1pb.InternalInvokeResponse, error) {
+	var data []byte
+	if msg != nil {
+		var err error
+		data, err = proto.Marshal(msg)
+		if err != nil {
+			return nil, status.Errorf(codes.Internal, "failed to marshal sandbox response: %v", err)
+		}
+	}
+
+	return &internalv1pb.InternalInvokeResponse{
+		Status: &internalv1pb.Status{Code: int32(codes.OK)},
+		Message: &commonv1pb.InvokeResponse{
+			Data:        &anypb.Any{Value: data},
+			ContentType: internalv1pb.ProtobufContentType,
+		},
+	}, nil
+}
+
+func unmarshal(method string, data []byte, msg proto.Message) error {
+	if err := proto.Unmarshal(data, msg); err != nil {
+		return status.Errorf(codes.InvalidArgument, "invalid %s request: %v", method, err)
+	}
+	return nil
+}
+
+func unknownSession(id string) error {
+	return status.Errorf(codes.NotFound, "unknown session %q", id)
+}
+
+// driverErr keeps gRPC status errors from the driver and turns anything else
+// into one.
+func driverErr(op string, err error) error {
+	if _, ok := status.FromError(err); ok {
+		return err
+	}
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return status.FromContextError(err).Err()
+	}
+	return status.Errorf(codes.Internal, "sandbox %s: %v", op, err)
+}
