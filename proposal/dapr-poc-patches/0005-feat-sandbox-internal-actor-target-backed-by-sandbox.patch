+syntax = "proto3";
+
+package dapr.proto.runtime.v1;
+
+option csharp_namespace = "Dapr.Client.Autogen.Grpc.v1";
+option java_outer_classname = "DaprSandboxProtos";
+option java_package = "io.dapr.v1";
+option go_package = "github.com/dapr/dapr/pkg/proto/runtime/v1;runtime";
+
+// SandboxTimingAlpha1 is a per-call latency breakdown, in microseconds.
+message SandboxTimingAlpha1 {
+  // Time from the API receiving the request to sending the response.
+  uint64 total_us = 1;
+  // Time spent inside the sandbox actor on the hosting sidecar.
+  uint64 host_us = 2;
+  // Time spent acquiring the sandbox from the driver on this call (0 when it
+  // was already acquired).
+  uint64 activate_us = 3;
+  // Time spent in the driver's exec or session send call.
+  uint64 exec_us = 4;
+  // How the driver acquired the sandbox: POOL, RESTORE or BOOT. Only set on
+  // the call that acquired it.
+  string acquire_path = 5;
+}
+
+// SandboxExecRequestAlpha1 runs a one-shot command in a sandbox.
+message SandboxExecRequestAlpha1 {
+  // Name of the sandbox component.
+  string component = 1;
+  // ID of the sandbox. The first call for an unknown ID activates it.
+  string sandbox_id = 2;
+  // App ID hosting the sandbox. Defaults to the caller's own app ID.
+  string app_id = 3;
+  // Optional activation token from an earlier response. If the sandbox was
+  // recreated since, the call fails with a "sandbox lost" error.
+  string expected_activation = 4;
+  string command = 5;
+  repeated string args = 6;
+  map<string, string> env = 7;
+  string cwd = 8;
+  bytes stdin = 9;
+  uint32 timeout_ms = 10;
+}
+
+// SandboxExecResponseAlpha1 is the result of a command or a session send.
+message SandboxExecResponseAlpha1 {
+  string sandbox_id = 1;
+  // Activation token of the sandbox that served the call.
+  string activation = 2;
+  bytes stdout = 3;
+  bytes stderr = 4;
+  int32 exit_code = 5;
+  bool truncated = 6;
+  bool timed_out = 7;
+  SandboxTimingAlpha1 timing = 8;
+}
+
+// SandboxCreateRequestAlpha1 creates a sandbox with an ID chosen by the
+// sidecar.
+message SandboxCreateRequestAlpha1 {
+  string component = 1;
+  string app_id = 2;
+}
+
+// SandboxCreateResponseAlpha1 is the response for creating a sandbox.
+message SandboxCreateResponseAlpha1 {
+  string sandbox_id = 1;
+  string activation = 2;
+  SandboxTimingAlpha1 timing = 3;
+}
+
+// SandboxDeleteRequestAlpha1 releases a sandbox.
+message SandboxDeleteRequestAlpha1 {
+  string component = 1;
+  string sandbox_id = 2;
+  string app_id = 3;
+}
+
+// SandboxSessionStartRequestAlpha1 starts a long-lived process in a sandbox.
+message SandboxSessionStartRequestAlpha1 {
+  string component = 1;
+  string sandbox_id = 2;
+  string app_id = 3;
+  string expected_activation = 4;
+  string command = 5;
+  repeated string args = 6;
+  map<string, string> env = 7;
+  string cwd = 8;
+}
+
+// SandboxSessionStartResponseAlpha1 is the response for starting a session.
+message SandboxSessionStartResponseAlpha1 {
+  string session_id = 1;
+  string activation = 2;
+}
+
+// SandboxSessionSendRequestAlpha1 writes input to a session and reads its
+// output until the `until` marker or the timeout. The response is a
+// SandboxExecResponseAlpha1.
+message SandboxSessionSendRequestAlpha1 {
+  string component = 1;
+  string sandbox_id = 2;
+  string app_id = 3;
+  string expected_activation = 4;
+  string session_id = 5;
+  bytes input = 6;
+  bytes until = 7;
+  uint32 timeout_ms = 8;
+}
+
+// SandboxSessionCloseRequestAlpha1 closes a session.
+message SandboxSessionCloseRequestAlpha1 {
+  string component = 1;
+  string sandbox_id = 2;
+  string app_id = 3;
+  string session_id = 4;
+}
