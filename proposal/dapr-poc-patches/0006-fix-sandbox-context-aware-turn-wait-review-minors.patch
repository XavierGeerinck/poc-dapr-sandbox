+func TestQueuedCallWakesOnRemoval(t *testing.T) {
+	d := &fakeDriver{execStarted: make(chan struct{}, 1), execBlock: make(chan struct{})}
+	f := newFactory(t, d)
+
+	running := goInvoke(t.Context(), f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "sleep"})
