+	tgt := f.GetOrCreate("sb1").(*target)
+
+	queued := goInvoke(t.Context(), f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "queued"})
+	assert.Eventually(t, func() bool { return tgt.inflight.Load() == 2 }, 5*time.Second, time.Millisecond)
+	require.NoError(t, tgt.Deactivate(t.Context()))
+
+	// The waiter wakes with Closed (the router retries it on a new target)
+	// while the running exec is still blocked.
+	c := await(t, queued)
+	assert.True(t, targetserrors.IsClosed(c.err), "expected Closed, got %v", c.err)
+
+	close(d.execBlock)
+	await(t, running)
+	assert.Equal(t, int32(1), d.execCount.Load())
+	assert.Equal(t, int32(0), tgt.inflight.Load())
+}
