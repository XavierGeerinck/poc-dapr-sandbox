+func TestQueuedCallHonoursContext(t *testing.T) {
+	for name, tc := range map[string]struct {
+		newCtx func(context.Context) (context.Context, context.CancelFunc)
+		// giveUp ends the caller's wait: an explicit cancel, or nothing for
+		// the deadline to pass on its own.
+		giveUp func(context.CancelFunc)
+		code   codes.Code
+	}{
+		"cancelled": {
+			newCtx: func(ctx context.Context) (context.Context, context.CancelFunc) { return context.WithCancel(ctx) },
+			giveUp: func(cancel context.CancelFunc) { cancel() },
+			code:   codes.Canceled,
+		},
+		"deadline": {
+			newCtx: func(ctx context.Context) (context.Context, context.CancelFunc) {
+				return context.WithTimeout(ctx, 200*time.Millisecond)
+			},
+			giveUp: func(context.CancelFunc) {},
+			code:   codes.DeadlineExceeded,
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := &fakeDriver{execStarted: make(chan struct{}, 1), execBlock: make(chan struct{})}
+			f := newFactory(t, d)
+
+			running := goInvoke(t.Context(), f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "sleep"})
+			await(t, d.execStarted)
+			tgt := f.GetOrCreate("sb1").(*target)
+
+			ctx, cancel := tc.newCtx(t.Context())
+			defer cancel()
+			queued := goInvoke(ctx, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "queued"})
+			assert.Eventually(t, func() bool { return tgt.inflight.Load() == 2 }, 5*time.Second, time.Millisecond)
+			tc.giveUp(cancel)
+
+			// The queued call returns while the running exec is still blocked.
+			c := await(t, queued)
+			require.Error(t, c.err)
+			assert.Equal(t, tc.code, status.Code(c.err))
+			assert.Equal(t, int32(1), tgt.inflight.Load())
+			assert.True(t, f.Exists("sb1"))
+
+			close(d.execBlock)
+			res := execResult(t, await(t, running))
+			assert.Equal(t, []byte("out:sleep"), res.GetStdout())
+
+			// The queued call never reached the driver.
+			assert.Equal(t, int32(1), d.acquireCount.Load())
+			assert.Equal(t, int32(1), d.execCount.Load())
+			assert.Equal(t, int32(0), tgt.inflight.Load())
+			assert.True(t, f.Exists("sb1"))
+		})
+	}
+}
