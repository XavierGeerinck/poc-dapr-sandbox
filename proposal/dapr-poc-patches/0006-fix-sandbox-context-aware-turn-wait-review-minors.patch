+func TestDeadContextDoesNotReachDriver(t *testing.T) {
+	d := &fakeDriver{}
+	f := newFactory(t, d)
+
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	// The turn is free and the context is done: whichever the select picks,
+	// the call stops before the driver. Repeat to cover both.
+	for range 20 {
+		c := invokeCtx(ctx, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+		assert.Equal(t, codes.Canceled, status.Code(c.err))
+	}
+	assert.Equal(t, int32(0), d.acquireCount.Load())
+	assert.Equal(t, int32(0), d.execCount.Load())
+	assert.True(t, f.Exists("sb1"))
+	assert.Equal(t, int32(0), f.GetOrCreate("sb1").(*target).inflight.Load())
+}
