+
+	running := goInvoke(t.Context(), f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+	await(t, d.acquireStarted)
+	require.NoError(t, f.GetOrCreate("sb1").Deactivate(t.Context()))
+	assert.Equal(t, int32(0), d.releaseStarted.Load())
+
+	close(d.acquireBlock)
+	c := await(t, running)
+	assert.True(t, targetserrors.IsClosed(c.err), "expected Closed, got %v", c.err)
+	assert.Contains(t, c.err.Error(), MethodExec)
+
+	// The instance acquired for the removed target is handed back.
+	assert.Eventually(t, func() bool { return d.releaseCount.Load() == 1 }, 5*time.Second, 10*time.Millisecond)
+	assert.Equal(t, []string{"inst-1"}, d.releasedIDs())
+	assert.Equal(t, int32(0), d.execCount.Load())
+	assert.False(t, f.Exists("sb1"))
+	assert.Empty(t, f.LiveInstanceIDs())
+}
+
+func TestSessionStartNotFoundIsLost(t *testing.T) {
+	d := &fakeDriver{sessionStartErr: status.Error(codes.NotFound, "unknown instance")}
+	f := newFactory(t, d)
+
+	_, err := invoke(t, f, "sb1", MethodSessionStart, &runtimev1pb.SandboxSessionStartRequestAlpha1{Command: "sh"})
+	requireLost(t, err)
+	assert.False(t, f.Exists("sb1"))
+	assert.Eventually(t, func() bool { return d.releaseCount.Load() == 1 }, 5*time.Second, 10*time.Millisecond)
+	assert.Equal(t, []string{"inst-1"}, d.releasedIDs())
+}
