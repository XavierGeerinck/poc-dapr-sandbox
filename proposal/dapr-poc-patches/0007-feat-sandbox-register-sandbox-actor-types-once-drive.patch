 import (
 	"context"
+	"sync"
 	"time"
 
 	"github.com/dapr/dapr/pkg/actors"
+	"github.com/dapr/dapr/pkg/actors/table"
+	sandboxtarget "github.com/dapr/dapr/pkg/actors/targets/sandbox"
 	"github.com/dapr/dapr/pkg/components/sandbox"
+	compv1pb "github.com/dapr/dapr/pkg/proto/components/v1"
+	"github.com/dapr/kit/logger"
 )
 
+const (
+	defaultReadyPollInterval = 100 * time.Millisecond
+	defaultReconcileInterval = 30 * time.Second
+
+	// notReadyLogInterval is the minimum time between logs of the driver's
+	// not-ready reason.
+	notReadyLogInterval = 5 * time.Second
+	// readyCallTimeout bounds each driver Ready call.
+	readyCallTimeout = 5 * time.Second
+	// reconcileTimeout bounds each driver Reconcile call.
+	reconcileTimeout = 10 * time.Second
+	// stopTimeout bounds how long Remove waits for a component's goroutine.
+	stopTimeout = 10 * time.Second
+)
+
+var log = logger.NewLogger("dapr.runtime.sandboxhost")
+
 // Options are the options for a Host.
 type Options struct {
 	Actors            actors.Interface
@@ -35,24 +57,228 @@ type Options struct {
 // Host manages sandbox drivers and registers their internal actor types.
 type Host struct {
 	opts Options
+
+	// opLock serializes Add and Remove.
+	opLock sync.Mutex
+
+	lock    sync.Mutex
+	entries map[string]*entry
+}
+
+// entry is one hosted sandbox component.
+type entry struct {
+	component string
+	actorType string
+	driver    sandbox.Sandbox
+	cancel    context.CancelFunc
+	done      chan struct{}
+
+	// lock guards tbl and registered, which the component goroutine sets.
+	lock       sync.Mutex
+	tbl        table.Interface
+	registered bool
 }
 
 // New returns a new Host.
 func New(opts Options) *Host {
-	return &Host{opts: opts}
+	if opts.ReadyPollInterval <= 0 {
+		opts.ReadyPollInterval = defaultReadyPollInterval
+	}
+	if opts.ReconcileInterval <= 0 {
+		opts.ReconcileInterval = defaultReconcileInterval
+	}
+	return &Host{opts: opts, entries: make(map[string]*entry)}
 }
 
-// Add registers a sandbox component with the host.
-func (h *Host) Add(_ context.Context, _ string, _ sandbox.Sandbox, _ sandbox.Config) {
-	// TODO(Task 6): register the internal actor type and start warm pool management.
+// Add starts hosting a sandbox component. It returns immediately: waiting for
+// the driver and the actor runtime, registering the actor type and the
+// periodic reconcile all happen in a goroutine owned by the host, which lives
+// until Remove. An existing component with the same name is stopped first.
+func (h *Host) Add(_ context.Context, component string, d sandbox.Sandbox, cfg sandbox.Config) {
+	h.opLock.Lock()
+	defer h.opLock.Unlock()
+
+	h.stop(component)
+
+	// The host owns this context: the context passed to Add belongs to the
+	// processor's init and ends long before the component does.
+	ctx, cancel := context.WithCancel(context.Background())
+	e := &entry{
+		component: component,
+		actorType: ActorType(h.opts.Namespace, h.opts.AppID, component),
+		driver:    d,
+		cancel:    cancel,
+		done:      make(chan struct{}),
+	}
+
+	h.lock.Lock()
+	h.entries[component] = e
+	h.lock.Unlock()
+
+	go func() {
+		defer close(e.done)
+		h.run(ctx, e, cfg)
+	}()
 }
 
-// Remove unregisters a sandbox component from the host.
-func (h *Host) Remove(_ context.Context, _ string) error {
-	// TODO(Task 6): unregister the actor type and stop management.
+// Remove stops hosting a sandbox component: it stops the component's
+// goroutine, unregisters the actor type if it was registered (which releases
+// every VM) and asks the driver to reconcile to an empty set. Removing an
+// unknown component is a no-op.
+func (h *Host) Remove(_ context.Context, component string) error {
+	h.opLock.Lock()
+	defer h.opLock.Unlock()
+
+	h.stop(component)
 	return nil
 }
 
+// stop must be called with opLock held.
+func (h *Host) stop(component string) {
+	h.lock.Lock()
+	e, ok := h.entries[component]
+	delete(h.entries, component)
+	h.lock.Unlock()
+	if !ok {
+		return
+	}
+
+	e.cancel()
+
+	var exited bool
+	timer := time.NewTimer(stopTimeout)
+	select {
+	case <-e.done:
+		exited = true
+	case <-timer.C:
+		log.Warnf("Sandbox component '%s' did not stop within %s", component, stopTimeout)
+	}
+	timer.Stop()
+
+	e.lock.Lock()
+	tbl, registered := e.tbl, e.registered
+	e.lock.Unlock()
+
+	// Only a goroutine that has exited can no longer register the type.
+	if exited && registered {
+		if err := tbl.UnRegisterActorTypes(e.actorType); err != nil {
+			log.Errorf("Failed to unregister sandbox actor type '%s': %v", e.actorType, err)
+		}
+	}
+
+	// The driver may hold warm VMs whether or not the type was registered.
+	ctx, cancel := context.WithTimeout(context.Background(), reconcileTimeout)
+	defer cancel()
+	if _, err := e.driver.Reconcile(ctx, &compv1pb.SandboxReconcileRequest{LiveInstanceIds: []string{}}); err != nil {
+		log.Errorf("Failed to reconcile sandbox component '%s' on removal: %v", component, err)
+	}
+}
+
+func (h *Host) run(ctx context.Context, e *entry, cfg sandbox.Config) {
+	if !h.waitReady(ctx, e) {
+		return
+	}
+
+	// Table blocks until the actor runtime is ready, which needs placement
+	// and an actor state store and may never happen.
+	tbl, err := h.opts.Actors.Table(ctx)
+	if err != nil || tbl == nil {
+		if ctx.Err() == nil {
+			log.Errorf("Failed to get the actor table for sandbox component '%s': %v", e.component, err)
+		}
+		return
+	}
+
+	factory, err := sandboxtarget.New(sandboxtarget.Options{
+		ActorType:   e.actorType,
+		Component:   e.component,
+		Driver:      e.driver,
+		IdleTimeout: cfg.IdleTimeout,
+	})
+	if err != nil {
+		log.Errorf("Failed to create the actor factory for sandbox component '%s': %v", e.component, err)
+		return
+	}
+
+	if ctx.Err() != nil {
+		return
+	}
+
+	e.lock.Lock()
+	e.tbl = tbl
+	e.registered = true
+	e.lock.Unlock()
+	tbl.RegisterActorTypes(table.RegisterActorTypeOptions{
+		Factories: []table.ActorTypeFactory{{Type: e.actorType, Factory: factory}},
+	})
+	log.Infof("Registered sandbox actor type '%s'", e.actorType)
+
+	h.reconcileLoop(ctx, e, factory)
+}
+
+// waitReady polls the driver until it is ready. It returns false if ctx ended
+// first.
+func (h *Host) waitReady(ctx context.Context, e *entry) bool {
+	var lastLog time.Time
+	for {
+		callCtx, cancel := context.WithTimeout(ctx, readyCallTimeout)
+		res, err := e.driver.Ready(callCtx, &compv1pb.SandboxReadyRequest{})
+		cancel()
+
+		switch {
+		case ctx.Err() != nil:
+			return false
+		case err == nil && res.GetReady():
+			return true
+		case time.Since(lastLog) >= notReadyLogInterval:
+			lastLog = time.Now()
+			if err != nil {
+				log.Infof("Sandbox component '%s' is not ready: %v", e.component, err)
+			} else {
+				log.Infof("Sandbox component '%s' is not ready: %s", e.component, res.GetReason())
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			return false
+		case <-time.After(h.opts.ReadyPollInterval):
+		}
+	}
+}
+
+func (h *Host) reconcileLoop(ctx context.Context, e *entry, factory *sandboxtarget.Factory) {
+	ticker := time.NewTicker(h.opts.ReconcileInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+
+		// An instance being acquired is not in LiveInstanceIDs yet, so
+		// reconciling now could release a VM that was just handed out.
+		if n := factory.AcquiresInFlight(); n > 0 {
+			log.Debugf("Skipping reconcile of sandbox component '%s': %d acquire(s) in flight", e.component, n)
+			continue
+		}
+		ids := factory.LiveInstanceIDs()
+		if n := factory.AcquiresInFlight(); n > 0 {
+			log.Debugf("Skipping reconcile of sandbox component '%s': %d acquire(s) in flight", e.component, n)
+			continue
+		}
+
+		callCtx, cancel := context.WithTimeout(ctx, reconcileTimeout)
+		_, err := e.driver.Reconcile(callCtx, &compv1pb.SandboxReconcileRequest{LiveInstanceIds: ids})
+		cancel()
+		if err != nil && ctx.Err() == nil {
+			log.Errorf("Failed to reconcile sandbox component '%s': %v", e.component, err)
+		}
+	}
+}
+
 // ActorType returns the internal actor type name for a sandbox component.
 func ActorType(namespace, appID, component string) string {
 	return "dapr.internal." + namespace + "." + appID + ".sandbox." + component
