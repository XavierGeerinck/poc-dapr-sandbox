+func TestAcquiresInFlight(t *testing.T) {
+	for name, acquireErr := range map[string]error{
+		"success": nil,
+		"failure": status.Error(codes.Unavailable, "boom"),
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := &fakeDriver{
+				acquireStarted: make(chan struct{}, 1),
+				acquireBlock:   make(chan struct{}),
+				acquireErr:     acquireErr,
+			}
+			f := newFactory(t, d)
+			assert.Equal(t, 0, f.AcquiresInFlight())
+
+			running := goInvoke(t.Context(), f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+			await(t, d.acquireStarted)
+			assert.Equal(t, 1, f.AcquiresInFlight())
+
+			close(d.acquireBlock)
+			await(t, running)
+			assert.Equal(t, 0, f.AcquiresInFlight())
+		})
+	}
+}
