+
+const wantType = "dapr.internal.default.app1.sandbox.py"
+
+type fakeDriver struct {
+	notReadyPolls int32
+
+	readyCalls atomic.Int32
+
+	lock       sync.Mutex
+	reconciles [][]string
+	// events records "ready", "register", "unregister" and "reconcile" in order.
+	events []string
+}
+
+var _ sandbox.Sandbox = (*fakeDriver)(nil)
+
+func (d *fakeDriver) record(e string) {
+	d.lock.Lock()
+	d.events = append(d.events, e)
+	d.lock.Unlock()
+}
+
+func (d *fakeDriver) Init(context.Context, metadata.Base) error { return nil }
+func (d *fakeDriver) Close() error                              { return nil }
+func (d *fakeDriver) Ready(context.Context, *compv1pb.SandboxReadyRequest) (*compv1pb.SandboxReadyResponse, error) {
+	n := d.readyCalls.Add(1)
+	d.record("ready")
+	if n <= d.notReadyPolls {
+		return &compv1pb.SandboxReadyResponse{Reason: "warming up"}, nil
+	}
+	return &compv1pb.SandboxReadyResponse{Ready: true}, nil
+}
+
+func (d *fakeDriver) Acquire(context.Context, *compv1pb.SandboxAcquireRequest) (*compv1pb.SandboxAcquireResponse, error) {
+	return &compv1pb.SandboxAcquireResponse{InstanceId: "i1"}, nil
+}
+
+func (d *fakeDriver) Exec(context.Context, *compv1pb.SandboxExecRequest) (*compv1pb.SandboxExecResponse, error) {
+	return &compv1pb.SandboxExecResponse{}, nil
+}
+
+func (d *fakeDriver) SessionStart(context.Context, *compv1pb.SandboxSessionStartRequest) (*compv1pb.SandboxSessionStartResponse, error) {
+	return &compv1pb.SandboxSessionStartResponse{}, nil
+}
+
+func (d *fakeDriver) SessionSend(context.Context, *compv1pb.SandboxSessionSendRequest) (*compv1pb.SandboxExecResponse, error) {
+	return &compv1pb.SandboxExecResponse{}, nil
+}
+
+func (d *fakeDriver) SessionClose(context.Context, *compv1pb.SandboxSessionCloseRequest) (*compv1pb.SandboxSessionCloseResponse, error) {
+	return &compv1pb.SandboxSessionCloseResponse{}, nil
+}
+
+func (d *fakeDriver) Release(context.Context, *compv1pb.SandboxReleaseRequest) (*compv1pb.SandboxReleaseResponse, error) {
+	return &compv1pb.SandboxReleaseResponse{}, nil
+}
+
+func (d *fakeDriver) Reconcile(_ context.Context, req *compv1pb.SandboxReconcileRequest) (*compv1pb.SandboxReconcileResponse, error) {
+	d.lock.Lock()
+	d.reconciles = append(d.reconciles, append([]string{}, req.GetLiveInstanceIds()...))
+	d.events = append(d.events, "reconcile")
+	d.lock.Unlock()
+	return &compv1pb.SandboxReconcileResponse{}, nil
+}
+
+func (d *fakeDriver) snapshot() ([][]string, []string) {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	return append([][]string(nil), d.reconciles...), append([]string(nil), d.events...)
+}
+
+type fakeTable struct {
+	*tablefake.Fake
+	registered   atomic.Int32
+	unregistered chan []string
+	regTypes     chan string
+	readyAtReg   atomic.Int32
+}
+
+func newFixture(d *fakeDriver) (*Host, *fakeTable) {
+	ft := &fakeTable{
+		unregistered: make(chan []string, 10),
+		regTypes:     make(chan string, 10),
+	}
+	ft.Fake = tablefake.New().
+		WithRegisterActorTypes(func(opts table.RegisterActorTypeOptions) {
+			ft.readyAtReg.Store(d.readyCalls.Load())
+			d.record("register")
+			ft.registered.Add(1)
+			for _, f := range opts.Factories {
+				ft.regTypes <- f.Type
+			}
+		}).
+		WithUnRegisterActorTypes(func(types ...string) error {
+			d.record("unregister")
+			ft.unregistered <- types
+			return nil
+		})
+
+	a := actorsfake.New().WithTable(func(context.Context) (table.Interface, error) {
+		return ft, nil
+	})
+	return New(Options{
+		Actors:            a,
+		AppID:             "app1",
+		Namespace:         "default",
+		ReadyPollInterval: time.Millisecond,
+		ReconcileInterval: 10 * time.Millisecond,
+	}), ft
+}
+
+func TestRegistersOnlyAfterReady(t *testing.T) {
+	d := &fakeDriver{notReadyPolls: 3}
+	h, ft := newFixture(d)
+
+	h.Add(t.Context(), "py", d, sandbox.Config{})
+	t.Cleanup(func() { assert.NoError(t, h.Remove(context.Background(), "py")) })
+
+	select {
+	case typ := <-ft.regTypes:
+		assert.Equal(t, wantType, typ)
+	case <-time.After(5 * time.Second):
+		require.Fail(t, "actor type was never registered")
+	}
+
+	assert.Equal(t, int32(4), ft.readyAtReg.Load(), "registered before the 4th Ready poll")
+	assert.Equal(t, int32(1), ft.registered.Load())
+	select {
+	case typ := <-ft.regTypes:
+		assert.Fail(t, "registered twice", typ)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func TestReconcileLoop(t *testing.T) {
+	d := &fakeDriver{}
+	h, _ := newFixture(d)
+
+	h.Add(t.Context(), "py", d, sandbox.Config{})
+	t.Cleanup(func() { assert.NoError(t, h.Remove(context.Background(), "py")) })
+
+	assert.EventuallyWithT(t, func(c *assert.CollectT) {
+		recs, _ := d.snapshot()
+		assert.GreaterOrEqual(c, len(recs), 2)
+	}, 5*time.Second, 5*time.Millisecond)
+
+	recs, _ := d.snapshot()
+	for _, r := range recs {
+		assert.Empty(t, r, "no active targets, so no live IDs")
+	}
+}
+
+func TestRemoveReleasesAll(t *testing.T) {
+	d := &fakeDriver{}
+	h, ft := newFixture(d)
+
+	h.Add(t.Context(), "py", d, sandbox.Config{})
+	select {
+	case <-ft.regTypes:
+	case <-time.After(5 * time.Second):
+		require.Fail(t, "actor type was never registered")
+	}
+
+	require.NoError(t, h.Remove(context.Background(), "py"))
+
+	select {
+	case types := <-ft.unregistered:
+		assert.Equal(t, []string{wantType}, types)
+	default:
+		require.Fail(t, "UnRegisterActorTypes not called")
+	}
+
+	recs, events := d.snapshot()
+	require.NotEmpty(t, recs)
+	assert.Empty(t, recs[len(recs)-1])
+	assert.Equal(t, "reconcile", events[len(events)-1])
+
+	// The loop is stopped: no more reconciles after Remove.
+	n := len(recs)
+	time.Sleep(50 * time.Millisecond)
+	recs, _ = d.snapshot()
+	assert.Len(t, recs, n)
+
+	// Removing again is a no-op.
+	assert.NoError(t, h.Remove(context.Background(), "py"))
+}
+
+func TestRemoveBeforeReadyDoesNotUnregister(t *testing.T) {
+	d := &fakeDriver{notReadyPolls: 1 << 30}
+	h, ft := newFixture(d)
+
+	h.Add(t.Context(), "py", d, sandbox.Config{})
+	require.NoError(t, h.Remove(context.Background(), "py"))
+
+	assert.Equal(t, int32(0), ft.registered.Load())
+	assert.Empty(t, ft.unregistered)
+	recs, _ := d.snapshot()
+	require.Len(t, recs, 1)
+	assert.Empty(t, recs[0])
+}
+
+func TestAddDoesNotBlockOnTable(t *testing.T) {
+	d := &fakeDriver{}
+	a := actorsfake.New().WithTable(func(ctx context.Context) (table.Interface, error) {
+		<-ctx.Done()
+		return nil, ctx.Err()
+	})
+	h := New(Options{Actors: a, AppID: "app1", Namespace: "default", ReadyPollInterval: time.Millisecond})
+
+	done := make(chan struct{})
+	go func() {
+		h.Add(t.Context(), "py", d, sandbox.Config{})
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		require.Fail(t, "Add blocked")
+	}
+
+	// Remove cancels the goroutine stuck in Table.
+	require.NoError(t, h.Remove(context.Background(), "py"))
+}
+
+func TestActorType(t *testing.T) {
+	assert.Equal(t, wantType, ActorType("default", "app1", "py"))
+}
