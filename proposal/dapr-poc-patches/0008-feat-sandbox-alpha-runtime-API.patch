+func TestDeleteAndSessionMethods(t *testing.T) {
+	u, rec := newSandboxUniversal(t, true, func(_ int, req *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		if req.GetMessage().GetMethod() == "session.start" {
+			return &runtimev1pb.SandboxSessionStartResponseAlpha1{SessionId: "s1"}, nil
+		}
+		return nil, nil
+	})
+	ctx := t.Context()
+	_, err := u.SandboxDeleteAlpha1(ctx, &runtimev1pb.SandboxDeleteRequestAlpha1{Component: "py", SandboxId: "sb"})
+	require.NoError(t, err)
+	st, err := u.SandboxSessionStartAlpha1(ctx, &runtimev1pb.SandboxSessionStartRequestAlpha1{Component: "py", SandboxId: "sb", Command: "sh"})
+	require.NoError(t, err)
+	assert.Equal(t, "s1", st.GetSessionId())
+	_, err = u.SandboxSessionCloseAlpha1(ctx, &runtimev1pb.SandboxSessionCloseRequestAlpha1{Component: "py", SandboxId: "sb", SessionId: "s1"})
+	require.NoError(t, err)
+	require.Equal(t, 3, rec.len())
+	assert.Equal(t, "release", rec.reqs[0].GetMessage().GetMethod())
+	assert.Equal(t, "session.start", rec.reqs[1].GetMessage().GetMethod())
+	assert.Equal(t, "session.close", rec.reqs[2].GetMessage().GetMethod())
+}
