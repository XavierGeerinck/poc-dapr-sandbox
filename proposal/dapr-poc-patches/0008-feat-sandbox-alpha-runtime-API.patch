+package universal
+
+import (
+	"context"
+	"time"
+
+	"github.com/google/uuid"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	sandboxtarget "github.com/dapr/dapr/pkg/actors/targets/sandbox"
+	"github.com/dapr/dapr/pkg/messages"
+	internalsv1pb "github.com/dapr/dapr/pkg/proto/internals/v1"
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+	"github.com/dapr/dapr/pkg/runtime/sandboxhost"
+)
+
+const (
+	// maxCreateAttempts is how many times Create retries with a fresh ID when
+	// the host reports it is full.
+	maxCreateAttempts = 5
+	// sandboxTimeoutGrace is added to the caller's timeoutMs when calling the
+	// router, so the driver's own timeout fires first.
+	sandboxTimeoutGrace = 30 * time.Second
+)
+
+// sandboxCall routes a sandbox actor method call and returns the raw response
+// data. Errors are already mapped to API errors.
+func (a *Universal) sandboxCall(ctx context.Context, component, appID, sandboxID, method string, timeoutMs uint32, req proto.Message) ([]byte, error) {
+	if component == "" {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+
+	target := appID
+	if target == "" {
+		target = a.appID
+	}
+	if target == a.appID {
+		if _, ok := a.compStore.GetSandbox(component); !ok {
+			err := messages.ErrSandboxNotFound.WithFormat(component)
+			a.logger.Debug(err)
+			return nil, err
+		}
+	}
+
+	data, err := proto.Marshal(req)
+	if err != nil {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+
+	router, err := a.ActorRouter(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	if timeoutMs > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, time.Duration(timeoutMs)*time.Millisecond+sandboxTimeoutGrace)
+		defer cancel()
+	}
+
+	ireq := internalsv1pb.
+		NewInternalInvokeRequest(method).
+		WithActor(sandboxhost.ActorType(a.namespace, target, component), sandboxID).
+		WithData(data).
+		WithContentType("application/x-protobuf")
+
+	res, err := router.Call(ctx, ireq)
+	if err != nil {
+		return nil, a.mapSandboxError(err)
+	}
+	return res.GetMessage().GetData().GetValue(), nil
+}
+
+// mapSandboxError maps the gRPC status code of a router error to an API error.
+func (a *Universal) mapSandboxError(err error) error {
+	st, ok := status.FromError(err)
+	if !ok {
+		a.logger.Debugf("sandbox call failed: %v", err)
+		return messages.ErrSandboxExec
+	}
+	switch st.Code() {
+	case codes.FailedPrecondition:
+		return messages.ErrSandboxLost
+	case codes.ResourceExhausted:
+		return messages.ErrSandboxHostFull
+	case codes.InvalidArgument, codes.NotFound:
+		a.logger.Debugf("sandbox invalid request: %s", st.Message())
+		return messages.ErrSandboxInvalidRequest
+	case codes.DeadlineExceeded, codes.Canceled:
+		return err
+	default:
+		a.logger.Debugf("sandbox call failed: %s", st.Message())
+		return messages.ErrSandboxExec
+	}
+}
+
+func setTotalUs(t *runtimev1pb.SandboxTimingAlpha1, start time.Time) *runtimev1pb.SandboxTimingAlpha1 {
+	if t == nil {
+		t = &runtimev1pb.SandboxTimingAlpha1{}
+	}
+	t.TotalUs = max(uint64(time.Since(start).Microseconds()), 1)
+	return t
+}
+
+// SandboxCreateAlpha1 creates a sandbox with a generated ID. If the host is
+// full it retries with a fresh ID, up to maxCreateAttempts.
+func (a *Universal) SandboxCreateAlpha1(ctx context.Context, in *runtimev1pb.SandboxCreateRequestAlpha1) (*runtimev1pb.SandboxCreateResponseAlpha1, error) {
+	start := time.Now()
+	for range maxCreateAttempts {
+		id := uuid.NewString()
+		data, err := a.sandboxCall(ctx, in.GetComponent(), in.GetAppId(), id, sandboxtarget.MethodActivate, 0, in)
+		if err != nil {
+			if messages.ErrSandboxHostFull.Is(err) {
+				continue
+			}
+			return nil, err
+		}
+		res := new(runtimev1pb.SandboxCreateResponseAlpha1)
+		if err = proto.Unmarshal(data, res); err != nil {
+			a.logger.Debugf("sandbox create: bad actor response: %v", err)
+			return nil, messages.ErrSandboxExec
+		}
+		res.SandboxId = id
+		res.Timing = setTotalUs(res.GetTiming(), start)
+		return res, nil
+	}
+	return nil, messages.ErrSandboxHostFull
+}
+
+// SandboxExecAlpha1 runs a one-shot command in a sandbox.
+func (a *Universal) SandboxExecAlpha1(ctx context.Context, in *runtimev1pb.SandboxExecRequestAlpha1) (*runtimev1pb.SandboxExecResponseAlpha1, error) {
+	start := time.Now()
+	if in.GetSandboxId() == "" || in.GetCommand() == "" {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+	data, err := a.sandboxCall(ctx, in.GetComponent(), in.GetAppId(), in.GetSandboxId(), sandboxtarget.MethodExec, in.GetTimeoutMs(), in)
+	if err != nil {
+		return nil, err
+	}
+	res := new(runtimev1pb.SandboxExecResponseAlpha1)
+	if err = proto.Unmarshal(data, res); err != nil {
+		a.logger.Debugf("sandbox exec: bad actor response: %v", err)
+		return nil, messages.ErrSandboxExec
+	}
+	res.Timing = setTotalUs(res.GetTiming(), start)
+	return res, nil
+}
+
+// SandboxDeleteAlpha1 releases a sandbox. It is idempotent.
+func (a *Universal) SandboxDeleteAlpha1(ctx context.Context, in *runtimev1pb.SandboxDeleteRequestAlpha1) (*emptypb.Empty, error) {
+	if in.GetSandboxId() == "" {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+	if _, err := a.sandboxCall(ctx, in.GetComponent(), in.GetAppId(), in.GetSandboxId(), sandboxtarget.MethodRelease, 0, in); err != nil {
+		return nil, err
+	}
+	return &emptypb.Empty{}, nil
+}
+
+// SandboxSessionStartAlpha1 starts a long-lived process in a sandbox.
+func (a *Universal) SandboxSessionStartAlpha1(ctx context.Context, in *runtimev1pb.SandboxSessionStartRequestAlpha1) (*runtimev1pb.SandboxSessionStartResponseAlpha1, error) {
+	if in.GetSandboxId() == "" || in.GetCommand() == "" {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+	data, err := a.sandboxCall(ctx, in.GetComponent(), in.GetAppId(), in.GetSandboxId(), sandboxtarget.MethodSessionStart, 0, in)
+	if err != nil {
+		return nil, err
+	}
+	res := new(runtimev1pb.SandboxSessionStartResponseAlpha1)
+	if err = proto.Unmarshal(data, res); err != nil {
+		a.logger.Debugf("sandbox session start: bad actor response: %v", err)
+		return nil, messages.ErrSandboxExec
+	}
+	return res, nil
+}
+
+// SandboxSessionSendAlpha1 writes input to a session and reads its output.
+func (a *Universal) SandboxSessionSendAlpha1(ctx context.Context, in *runtimev1pb.SandboxSessionSendRequestAlpha1) (*runtimev1pb.SandboxExecResponseAlpha1, error) {
+	start := time.Now()
+	if in.GetSandboxId() == "" || in.GetSessionId() == "" {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+	data, err := a.sandboxCall(ctx, in.GetComponent(), in.GetAppId(), in.GetSandboxId(), sandboxtarget.MethodSessionSend, in.GetTimeoutMs(), in)
+	if err != nil {
+		return nil, err
+	}
+	res := new(runtimev1pb.SandboxExecResponseAlpha1)
+	if err = proto.Unmarshal(data, res); err != nil {
+		a.logger.Debugf("sandbox session send: bad actor response: %v", err)
+		return nil, messages.ErrSandboxExec
+	}
+	res.Timing = setTotalUs(res.GetTiming(), start)
+	return res, nil
+}
+
+// SandboxSessionCloseAlpha1 closes a session.
+func (a *Universal) SandboxSessionCloseAlpha1(ctx context.Context, in *runtimev1pb.SandboxSessionCloseRequestAlpha1) (*emptypb.Empty, error) {
+	if in.GetSandboxId() == "" || in.GetSessionId() == "" {
+		return nil, messages.ErrSandboxInvalidRequest
+	}
+	if _, err := a.sandboxCall(ctx, in.GetComponent(), in.GetAppId(), in.GetSandboxId(), sandboxtarget.MethodSessionClose, 0, in); err != nil {
+		return nil, err
+	}
+	return &emptypb.Empty{}, nil
+}
