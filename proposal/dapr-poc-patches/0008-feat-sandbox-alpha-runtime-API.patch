+)
+
+type sandboxCallRec struct {
+	mu       sync.Mutex
+	reqs     []*internalsv1pb.InternalInvokeRequest
+	deadline []bool
+}
+
+func (r *sandboxCallRec) len() int {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return len(r.reqs)
+}
+
+func newSandboxUniversal(t *testing.T, withLocal bool, fn func(n int, req *internalsv1pb.InternalInvokeRequest) (proto.Message, error)) (*Universal, *sandboxCallRec) {
+	t.Helper()
+	rec := new(sandboxCallRec)
+	rt := routerfake.New().WithCallFn(func(ctx context.Context, req *internalsv1pb.InternalInvokeRequest) (*internalsv1pb.InternalInvokeResponse, error) {
+		rec.mu.Lock()
+		rec.reqs = append(rec.reqs, req)
+		rec.deadline = append(rec.deadline, func() bool { _, ok := ctx.Deadline(); return ok }())
+		n := len(rec.reqs)
+		rec.mu.Unlock()
+		msg, err := fn(n, req)
+		if err != nil {
+			return nil, err
+		}
+		res := &internalsv1pb.InternalInvokeResponse{Message: &commonv1.InvokeResponse{}}
+		if msg != nil {
+			a, aerr := anypb.New(msg)
+			require.NoError(t, aerr)
+			res.Message.Data = &anypb.Any{Value: a.GetValue()}
+		}
+		return res, nil
+	})
+	cs := compstore.New()
+	if withLocal {
+		cs.AddSandbox("py", sandbox.Sandbox(nil))
+	}
+	return &Universal{
+		appID:      "me",
+		namespace:  "default",
+		logger:     testLogger,
+		resiliency: resiliency.New(nil),
+		compStore:  cs,
+		actors: actorsfake.New().WithRouter(func(context.Context) (router.Interface, error) {
+			return rt, nil
+		}),
+	}, rec
+}
+
+func TestExecRoutesToActorType(t *testing.T) {
+	u, rec := newSandboxUniversal(t, false, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		time.Sleep(time.Millisecond)
+		return &runtimev1pb.SandboxExecResponseAlpha1{
+			SandboxId: "sb1",
+			Stdout:    []byte("hi"),
+			Timing:    &runtimev1pb.SandboxTimingAlpha1{ExecUs: 7, AcquirePath: "POOL"},
+		}, nil
+	})
+	res, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{
+		Component: "py", SandboxId: "sb1", AppId: "pool", Command: "echo", TimeoutMs: 1000,
+	})
+	require.NoError(t, err)
+	require.Equal(t, 1, rec.len())
+	req := rec.reqs[0]
+	assert.Equal(t, "dapr.internal.default.pool.sandbox.py", req.GetActor().GetActorType())
+	assert.Equal(t, "sb1", req.GetActor().GetActorId())
+	assert.Equal(t, "exec", req.GetMessage().GetMethod())
+	assert.True(t, rec.deadline[0])
+	assert.Positive(t, res.GetTiming().GetTotalUs())
+	assert.EqualValues(t, 7, res.GetTiming().GetExecUs())
+	assert.Equal(t, "POOL", res.GetTiming().GetAcquirePath())
+	assert.Equal(t, "hi", string(res.GetStdout()))
+}
+
+func TestExecNoTimeoutUsesCallerCtx(t *testing.T) {
+	u, rec := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		return &runtimev1pb.SandboxExecResponseAlpha1{}, nil
+	})
+	_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb1", Command: "x"})
+	require.NoError(t, err)
+	assert.False(t, rec.deadline[0])
+	assert.Equal(t, "dapr.internal.default.me.sandbox.py", rec.reqs[0].GetActor().GetActorType())
+}
+
+func TestExecSelfMissingComponent(t *testing.T) {
+	u, rec := newSandboxUniversal(t, false, nil)
+	_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb1", Command: "x"})
+	require.ErrorIs(t, err, messages.ErrSandboxNotFound)
+	assert.Equal(t, 0, rec.len())
+}
+
+func TestCreateRetriesOnFull(t *testing.T) {
+	u, rec := newSandboxUniversal(t, true, func(n int, req *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		if n <= 2 {
+			return nil, status.Error(codes.ResourceExhausted, "full")
+		}
+		return &runtimev1pb.SandboxCreateResponseAlpha1{Activation: "a1", Timing: &runtimev1pb.SandboxTimingAlpha1{HostUs: 3}}, nil
+	})
+	res, err := u.SandboxCreateAlpha1(t.Context(), &runtimev1pb.SandboxCreateRequestAlpha1{Component: "py"})
+	require.NoError(t, err)
+	require.Equal(t, 3, rec.len())
+	ids := map[string]struct{}{}
+	for _, r := range rec.reqs {
+		assert.Equal(t, "activate", r.GetMessage().GetMethod())
+		ids[r.GetActor().GetActorId()] = struct{}{}
+	}
+	assert.Len(t, ids, 3)
+	assert.Equal(t, rec.reqs[2].GetActor().GetActorId(), res.GetSandboxId())
+	assert.Equal(t, "a1", res.GetActivation())
+	assert.Positive(t, res.GetTiming().GetTotalUs())
+	assert.EqualValues(t, 3, res.GetTiming().GetHostUs())
+}
+
+func TestCreateGivesUp(t *testing.T) {
+	u, rec := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		return nil, status.Error(codes.ResourceExhausted, "full")
+	})
+	_, err := u.SandboxCreateAlpha1(t.Context(), &runtimev1pb.SandboxCreateRequestAlpha1{Component: "py"})
+	require.ErrorIs(t, err, messages.ErrSandboxHostFull)
+	assert.Equal(t, 5, rec.len())
+}
+
+func TestErrorMapping(t *testing.T) {
+	tests := map[string]struct {
+		code codes.Code
+		want error
+	}{
+		"lost":     {codes.FailedPrecondition, messages.ErrSandboxLost},
+		"full":     {codes.ResourceExhausted, messages.ErrSandboxHostFull},
+		"invalid":  {codes.InvalidArgument, messages.ErrSandboxInvalidRequest},
+		"notfound": {codes.NotFound, messages.ErrSandboxInvalidRequest},
+		"internal": {codes.Internal, messages.ErrSandboxExec},
+		"unknown":  {codes.Unavailable, messages.ErrSandboxExec},
+	}
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			u, rec := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+				return nil, status.Error(tc.code, "boom")
+			})
+			_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb", Command: "x"})
+			require.ErrorIs(t, err, tc.want)
+			assert.Equal(t, 1, rec.len(), "exec must not retry")
+		})
+	}
+}
+
+func TestDeadlineAndCancelPassThrough(t *testing.T) {
+	for _, c := range []codes.Code{codes.DeadlineExceeded, codes.Canceled} {
+		u, _ := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+			return nil, status.Error(c, "x")
+		})
+		_, err := u.SandboxSessionSendAlpha1(t.Context(), &runtimev1pb.SandboxSessionSendRequestAlpha1{Component: "py", SandboxId: "sb", SessionId: "s"})
+		require.Equal(t, c, status.Code(err))
+	}
+}
+
+func TestLostMapsToSandboxLost(t *testing.T) {
+	u, _ := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		return nil, status.Error(codes.FailedPrecondition, "")
+	})
+	_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb", Command: "x"})
+	require.ErrorIs(t, err, messages.ErrSandboxLost)
+}
+
+func TestValidation(t *testing.T) {
+	u, rec := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		return nil, nil
+	})
+	ctx := t.Context()
+	var err error
+
+	_, err = u.SandboxExecAlpha1(ctx, &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", Command: "x"})
