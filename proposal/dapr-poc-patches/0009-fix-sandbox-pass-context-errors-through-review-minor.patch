-func TestLostMapsToSandboxLost(t *testing.T) {
+func TestSandboxPlainContextErrorsPassThrough(t *testing.T) {
+	for want, cerr := range map[codes.Code]error{
+		codes.DeadlineExceeded: context.DeadlineExceeded,
+		codes.Canceled:         context.Canceled,
+	} {
+		u, _ := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+			return nil, fmt.Errorf("wrapped: %w", cerr)
+		})
+		_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb", Command: "x"})
+		require.Error(t, err)
+		assert.Equal(t, want, status.Code(err))
+		assert.NotErrorIs(t, err, messages.ErrSandboxExec)
+	}
+}
+
+func TestSandboxRequestReachesActor(t *testing.T) {
+	u, rec := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		return &runtimev1pb.SandboxExecResponseAlpha1{}, nil
+	})
+	in := &runtimev1pb.SandboxExecRequestAlpha1{
+		Component: "py", SandboxId: "sb", Command: "echo", Args: []string{"a", "b"},
+		Env: map[string]string{"K": "V"}, Cwd: "/w", Stdin: []byte("in"), ExpectedActivation: "act",
+	}
+	_, err := u.SandboxExecAlpha1(t.Context(), in)
+	require.NoError(t, err)
+	got := new(runtimev1pb.SandboxExecRequestAlpha1)
+	require.NoError(t, proto.Unmarshal(rec.reqs[0].GetMessage().GetData().GetValue(), got))
+	assert.True(t, proto.Equal(in, got))
+	assert.Equal(t, "application/x-protobuf", rec.reqs[0].GetMessage().GetContentType())
+}
