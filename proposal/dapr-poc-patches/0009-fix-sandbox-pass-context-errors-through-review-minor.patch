+// unmarshalSandboxResponse decodes actor response data into a new T.
+func unmarshalSandboxResponse[T any, PT interface {
+	*T
+	proto.Message
+}](a *Universal, data []byte) (PT, error) {
+	res := PT(new(T))
+	if err := proto.Unmarshal(data, res); err != nil {
+		a.logger.Debugf("sandbox: bad actor response: %v", err)
+		return nil, messages.ErrSandboxExec
+	}
+	return res, nil
+}
