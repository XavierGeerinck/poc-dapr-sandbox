+package http
+
+import (
+	"context"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	"github.com/dapr/dapr/pkg/api/http/endpoints"
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+)
+
+const (
+	// Path parameters carrying sandbox and session IDs. They are unescaped
+	// with url.PathUnescape (see unespaceRequestParametersInContext) so that
+	// "+" is preserved.
+	sandboxIDParam        = "sandboxId"
+	sandboxSessionIDParam = "sessionId"
+
+	sandboxComponentParam = "component"
+	daprAppIDHeader       = "dapr-app-id"
+)
+
+var endpointGroupSandboxV1Alpha1 = &endpoints.EndpointGroup{
+	Name:                 endpoints.EndpointGroupSandbox,
+	Version:              endpoints.EndpointGroupVersion1alpha1,
+	AppendSpanAttributes: nil,
+}
+
+// sandboxFns are the universal methods backing the sandbox endpoints.
+type sandboxFns struct {
+	create       func(context.Context, *runtimev1pb.SandboxCreateRequestAlpha1) (*runtimev1pb.SandboxCreateResponseAlpha1, error)
+	exec         func(context.Context, *runtimev1pb.SandboxExecRequestAlpha1) (*runtimev1pb.SandboxExecResponseAlpha1, error)
+	del          func(context.Context, *runtimev1pb.SandboxDeleteRequestAlpha1) (*emptypb.Empty, error)
+	sessionStart func(context.Context, *runtimev1pb.SandboxSessionStartRequestAlpha1) (*runtimev1pb.SandboxSessionStartResponseAlpha1, error)
+	sessionSend  func(context.Context, *runtimev1pb.SandboxSessionSendRequestAlpha1) (*runtimev1pb.SandboxExecResponseAlpha1, error)
+	sessionClose func(context.Context, *runtimev1pb.SandboxSessionCloseRequestAlpha1) (*emptypb.Empty, error)
+}
+
+func (a *api) constructSandboxEndpoints() []endpoints.Endpoint {
+	return constructSandboxEndpoints(sandboxFns{
+		create:       a.universal.SandboxCreateAlpha1,
+		exec:         a.universal.SandboxExecAlpha1,
+		del:          a.universal.SandboxDeleteAlpha1,
+		sessionStart: a.universal.SandboxSessionStartAlpha1,
+		sessionSend:  a.universal.SandboxSessionSendAlpha1,
+		sessionClose: a.universal.SandboxSessionCloseAlpha1,
+	})
+}
+
+// sandboxAppID returns the target app ID: the dapr-app-id header when set
+// (overriding the body), otherwise the body's value.
+func sandboxAppID(r *http.Request, bodyAppID string) string {
+	if h := r.Header.Get(daprAppIDHeader); h != "" {
+		return h
+	}
+	return bodyAppID
+}
+
+func constructSandboxEndpoints(fns sandboxFns) []endpoints.Endpoint {
+	ep := func(method, route, name string, h http.HandlerFunc) endpoints.Endpoint {
+		return endpoints.Endpoint{
+			Methods:  []string{method},
+			Route:    route,
+			Version:  apiVersionV1alpha1,
+			Group:    endpointGroupSandboxV1Alpha1,
+			Handler:  h,
+			Settings: endpoints.EndpointSettings{Name: name},
+		}
+	}
+
+	create := UniversalHTTPHandler(fns.create, UniversalHTTPHandlerOpts[*runtimev1pb.SandboxCreateRequestAlpha1, *runtimev1pb.SandboxCreateResponseAlpha1]{
+		InModifier: func(r *http.Request, in *runtimev1pb.SandboxCreateRequestAlpha1) (*runtimev1pb.SandboxCreateRequestAlpha1, error) {
+			in.Component = chi.URLParam(r, sandboxComponentParam)
+			in.AppId = sandboxAppID(r, in.GetAppId())
+			return in, nil
+		},
+	})
+	exec := UniversalHTTPHandler(fns.exec, UniversalHTTPHandlerOpts[*runtimev1pb.SandboxExecRequestAlpha1, *runtimev1pb.SandboxExecResponseAlpha1]{
+		InModifier: func(r *http.Request, in *runtimev1pb.SandboxExecRequestAlpha1) (*runtimev1pb.SandboxExecRequestAlpha1, error) {
+			in.Component = chi.URLParam(r, sandboxComponentParam)
+			in.SandboxId = chi.URLParam(r, sandboxIDParam)
+			in.AppId = sandboxAppID(r, in.GetAppId())
+			return in, nil
+		},
+	})
+	del := UniversalHTTPHandler(fns.del, UniversalHTTPHandlerOpts[*runtimev1pb.SandboxDeleteRequestAlpha1, *emptypb.Empty]{
+		InModifier: func(r *http.Request, in *runtimev1pb.SandboxDeleteRequestAlpha1) (*runtimev1pb.SandboxDeleteRequestAlpha1, error) {
+			in.Component = chi.URLParam(r, sandboxComponentParam)
+			in.SandboxId = chi.URLParam(r, sandboxIDParam)
+			in.AppId = sandboxAppID(r, in.GetAppId())
+			return in, nil
+		},
+	})
+	sessionStart := UniversalHTTPHandler(fns.sessionStart, UniversalHTTPHandlerOpts[*runtimev1pb.SandboxSessionStartRequestAlpha1, *runtimev1pb.SandboxSessionStartResponseAlpha1]{
+		InModifier: func(r *http.Request, in *runtimev1pb.SandboxSessionStartRequestAlpha1) (*runtimev1pb.SandboxSessionStartRequestAlpha1, error) {
+			in.Component = chi.URLParam(r, sandboxComponentParam)
+			in.SandboxId = chi.URLParam(r, sandboxIDParam)
+			in.AppId = sandboxAppID(r, in.GetAppId())
+			return in, nil
+		},
+	})
+	sessionSend := UniversalHTTPHandler(fns.sessionSend, UniversalHTTPHandlerOpts[*runtimev1pb.SandboxSessionSendRequestAlpha1, *runtimev1pb.SandboxExecResponseAlpha1]{
+		InModifier: func(r *http.Request, in *runtimev1pb.SandboxSessionSendRequestAlpha1) (*runtimev1pb.SandboxSessionSendRequestAlpha1, error) {
+			in.Component = chi.URLParam(r, sandboxComponentParam)
+			in.SandboxId = chi.URLParam(r, sandboxIDParam)
+			in.SessionId = chi.URLParam(r, sandboxSessionIDParam)
+			in.AppId = sandboxAppID(r, in.GetAppId())
+			return in, nil
+		},
+	})
+	sessionClose := UniversalHTTPHandler(fns.sessionClose, UniversalHTTPHandlerOpts[*runtimev1pb.SandboxSessionCloseRequestAlpha1, *emptypb.Empty]{
+		InModifier: func(r *http.Request, in *runtimev1pb.SandboxSessionCloseRequestAlpha1) (*runtimev1pb.SandboxSessionCloseRequestAlpha1, error) {
+			in.Component = chi.URLParam(r, sandboxComponentParam)
+			in.SandboxId = chi.URLParam(r, sandboxIDParam)
+			in.SessionId = chi.URLParam(r, sandboxSessionIDParam)
+			in.AppId = sandboxAppID(r, in.GetAppId())
+			return in, nil
+		},
+	})
+
+	return []endpoints.Endpoint{
+		ep(http.MethodPost, "sandboxes/{component}", "CreateSandbox", create),
+		ep(http.MethodPost, "sandboxes/{component}/{sandboxId}/exec", "ExecSandbox", exec),
+		ep(http.MethodDelete, "sandboxes/{component}/{sandboxId}", "DeleteSandbox", del),
+		ep(http.MethodPost, "sandboxes/{component}/{sandboxId}/sessions", "StartSandboxSession", sessionStart),
+		ep(http.MethodPost, "sandboxes/{component}/{sandboxId}/sessions/{sessionId}", "SendSandboxSession", sessionSend),
+		ep(http.MethodDelete, "sandboxes/{component}/{sandboxId}/sessions/{sessionId}", "CloseSandboxSession", sessionClose),
+	}
+}
