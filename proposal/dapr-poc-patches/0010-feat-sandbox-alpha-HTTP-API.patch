+package http
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/types/known/emptypb"
+
+	"github.com/dapr/dapr/pkg/api/http/endpoints"
+	"github.com/dapr/dapr/pkg/messages"
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+)
+
+type sandboxRec struct {
+	mu          sync.Mutex
+	exec        *runtimev1pb.SandboxExecRequestAlpha1
+	create      *runtimev1pb.SandboxCreateRequestAlpha1
+	del         *runtimev1pb.SandboxDeleteRequestAlpha1
+	start       *runtimev1pb.SandboxSessionStartRequestAlpha1
+	send        *runtimev1pb.SandboxSessionSendRequestAlpha1
+	closeReq    *runtimev1pb.SandboxSessionCloseRequestAlpha1
+	err         error
+	directCalls int
+}
+
+func (rec *sandboxRec) fns() sandboxFns {
+	return sandboxFns{
+		create: func(_ context.Context, in *runtimev1pb.SandboxCreateRequestAlpha1) (*runtimev1pb.SandboxCreateResponseAlpha1, error) {
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			rec.create = in
+			if rec.err != nil {
+				return nil, rec.err
+			}
+			return &runtimev1pb.SandboxCreateResponseAlpha1{SandboxId: "sb-1", Activation: "cold", Timing: &runtimev1pb.SandboxTimingAlpha1{TotalUs: 5}}, nil
+		},
+		exec: func(_ context.Context, in *runtimev1pb.SandboxExecRequestAlpha1) (*runtimev1pb.SandboxExecResponseAlpha1, error) {
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			rec.exec = in
+			if rec.err != nil {
+				return nil, rec.err
+			}
+			return &runtimev1pb.SandboxExecResponseAlpha1{
+				SandboxId: in.GetSandboxId(), Activation: "warm", Stdout: []byte("hi\n"),
+				Timing: &runtimev1pb.SandboxTimingAlpha1{TotalUs: 10},
+			}, nil
+		},
+		del: func(_ context.Context, in *runtimev1pb.SandboxDeleteRequestAlpha1) (*emptypb.Empty, error) {
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			rec.del = in
+			return &emptypb.Empty{}, nil
+		},
+		sessionStart: func(_ context.Context, in *runtimev1pb.SandboxSessionStartRequestAlpha1) (*runtimev1pb.SandboxSessionStartResponseAlpha1, error) {
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			rec.start = in
+			return &runtimev1pb.SandboxSessionStartResponseAlpha1{SessionId: "s-1"}, nil
+		},
+		sessionSend: func(_ context.Context, in *runtimev1pb.SandboxSessionSendRequestAlpha1) (*runtimev1pb.SandboxExecResponseAlpha1, error) {
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			rec.send = in
+			return &runtimev1pb.SandboxExecResponseAlpha1{Stdout: []byte("out")}, nil
+		},
+		sessionClose: func(_ context.Context, in *runtimev1pb.SandboxSessionCloseRequestAlpha1) (*emptypb.Empty, error) {
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			rec.closeReq = in
+			return &emptypb.Empty{}, nil
+		},
+	}
+}
+
+// newSandboxTestServer routes through the real server's setupRoutes (so the
+// path-parameter unescaping middleware applies) with CleanPathMiddleware, and
+// a fallback handler standing in for direct invocation.
+func newSandboxTestServer(t *testing.T, rec *sandboxRec) *httptest.Server {
+	t.Helper()
+	srv := newServer()
+	r := srv.getRouter()
+	eps := append(constructSandboxEndpoints(rec.fns()), endpoints.Endpoint{
+		Route:   "{path:*}",
+		Version: "v1.0",
+		Handler: http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			rec.mu.Lock()
+			rec.directCalls++
+			rec.mu.Unlock()
+			w.WriteHeader(http.StatusTeapot)
+		}),
+		Settings: endpoints.EndpointSettings{IsFallback: true},
+	})
+	srv.setupRoutes(r, eps)
+	s := httptest.NewServer(r)
+	t.Cleanup(s.Close)
+	return s
+}
+
+func sandboxDo(t *testing.T, s *httptest.Server, method, path, body string, hdr map[string]string) (int, string) {
+	t.Helper()
+	var rd io.Reader
+	if body != "" {
+		rd = strings.NewReader(body)
+	}
+	req, err := http.NewRequest(method, s.URL+path, rd)
+	require.NoError(t, err)
+	for k, v := range hdr {
+		req.Header.Set(k, v)
+	}
+	resp, err := s.Client().Do(req)
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	return resp.StatusCode, string(b)
+}
+
+func TestSandboxHTTP_ExecJSON(t *testing.T) {
+	rec := &sandboxRec{}
+	s := newSandboxTestServer(t, rec)
+
+	code, body := sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/sb-1/exec",
+		`{"command":"echo","args":["hi"],"component":"evil","sandboxId":"evil"}`, nil)
+	require.Equal(t, http.StatusOK, code, body)
+	assert.Contains(t, body, `"activation":"warm"`)
+	assert.Contains(t, body, `"timing"`)
+	assert.Contains(t, body, `"stdout":"aGkK"`)
+
+	rec.mu.Lock()
+	defer rec.mu.Unlock()
+	assert.Equal(t, "echo", rec.exec.GetCommand())
+	assert.Equal(t, []string{"hi"}, rec.exec.GetArgs())
+	// Path params win over body.
+	assert.Equal(t, "pool", rec.exec.GetComponent())
+	assert.Equal(t, "sb-1", rec.exec.GetSandboxId())
+}
+
+func TestSandboxHTTP_EmptyBodies(t *testing.T) {
+	rec := &sandboxRec{}
+	s := newSandboxTestServer(t, rec)
+
+	code, body := sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool", "", nil)
+	require.Equal(t, http.StatusOK, code, body)
+	assert.Contains(t, body, `"sandboxId":"sb-1"`)
+
+	code, body = sandboxDo(t, s, http.MethodDelete, "/v1.0-alpha1/sandboxes/pool/sb-1", "", nil)
+	require.Equal(t, http.StatusOK, code, body)
+	code, body = sandboxDo(t, s, http.MethodDelete, "/v1.0-alpha1/sandboxes/pool/sb-1/sessions/s-1", "", nil)
+	require.Equal(t, http.StatusOK, code, body)
+
+	rec.mu.Lock()
+	defer rec.mu.Unlock()
+	assert.Equal(t, "pool", rec.create.GetComponent())
+	assert.Equal(t, "sb-1", rec.del.GetSandboxId())
+	assert.Equal(t, "pool", rec.del.GetComponent())
+	assert.Equal(t, "s-1", rec.closeReq.GetSessionId())
+}
+
+func TestSandboxHTTP_Sessions(t *testing.T) {
+	rec := &sandboxRec{}
+	s := newSandboxTestServer(t, rec)
+
+	code, body := sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/sb-1/sessions", `{"command":"cat"}`, nil)
+	require.Equal(t, http.StatusOK, code, body)
+	assert.Contains(t, body, `"sessionId":"s-1"`)
+
+	// "hello" in base64.
+	code, body = sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/sb-1/sessions/s-1",
+		`{"input":"aGVsbG8=","sessionId":"evil"}`, nil)
+	require.Equal(t, http.StatusOK, code, body)
+
+	rec.mu.Lock()
+	defer rec.mu.Unlock()
+	assert.Equal(t, "cat", rec.start.GetCommand())
+	assert.Equal(t, "sb-1", rec.start.GetSandboxId())
+	assert.Equal(t, []byte("hello"), rec.send.GetInput())
+	assert.Equal(t, "s-1", rec.send.GetSessionId())
+}
+
+func TestSandboxHTTP_AppIDHeader(t *testing.T) {
+	rec := &sandboxRec{}
+	s := newSandboxTestServer(t, rec)
+
+	code, body := sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/sb-1/exec",
+		`{"command":"echo","appId":"fromBody"}`, map[string]string{"dapr-app-id": "pool"})
+	require.Equal(t, http.StatusOK, code, body)
+
+	rec.mu.Lock()
+	assert.Equal(t, "pool", rec.exec.GetAppId())
+	assert.Equal(t, 0, rec.directCalls, "request must not reach direct invoke")
+	rec.exec = nil
+	rec.mu.Unlock()
+
+	// Without the header, the body's appId is kept.
+	code, body = sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/sb-1/exec",
+		`{"command":"echo","appId":"fromBody"}`, nil)
+	require.Equal(t, http.StatusOK, code, body)
+	rec.mu.Lock()
+	defer rec.mu.Unlock()
+	assert.Equal(t, "fromBody", rec.exec.GetAppId())
+}
+
+func TestSandboxHTTP_UnsafeID(t *testing.T) {
+	long := strings.Repeat("x", 300)
+	tests := map[string]struct {
+		escaped string
+		want    string
+	}{
+		"colon slash utf8": {"a:b%2Fc%E2%9C%93", "a:b/c✓"},
+		"plus":             {"a+b", "a+b"},
+		"long":             {long, long},
+	}
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			rec := &sandboxRec{}
+			s := newSandboxTestServer(t, rec)
+
+			code, body := sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/"+tc.escaped+"/exec", `{"command":"echo"}`, nil)
+			require.Equal(t, http.StatusOK, code, body)
+			code, body = sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/"+tc.escaped+"/sessions/"+tc.escaped, `{}`, nil)
+			require.Equal(t, http.StatusOK, code, body)
+
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			assert.Equal(t, tc.want, rec.exec.GetSandboxId())
+			assert.Equal(t, tc.want, rec.send.GetSandboxId())
+			assert.Equal(t, tc.want, rec.send.GetSessionId())
+			assert.Equal(t, 0, rec.directCalls)
+		})
+	}
+}
+
+func TestSandboxHTTP_ErrorStatuses(t *testing.T) {
+	tests := map[string]struct {
+		err  error
+		want int
+	}{
+		"full":    {messages.ErrSandboxHostFull, http.StatusTooManyRequests},
+		"lost":    {messages.ErrSandboxLost, http.StatusGone},
+		"invalid": {messages.ErrSandboxInvalidRequest, http.StatusBadRequest},
+		"exec":    {messages.ErrSandboxExec, http.StatusInternalServerError},
+	}
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			rec := &sandboxRec{err: tc.err}
+			s := newSandboxTestServer(t, rec)
+			code, body := sandboxDo(t, s, http.MethodPost, "/v1.0-alpha1/sandboxes/pool/sb-1/exec", `{"command":"echo"}`, nil)
+			assert.Equal(t, tc.want, code, body)
+		})
+	}
+}
