 	assert.Equal(t, "session.close", rec.reqs[2].GetMessage().GetMethod())
 }
+
+// withSandboxTable makes the Universal's actor runtime return tbl (or err)
+// from Table, recording whether every call came with a done context.
+func withSandboxTable(t *testing.T, u *Universal, tbl table.Interface, err error) *atomic.Bool {
+	t.Helper()
+	blocking := new(atomic.Bool)
+	u.actors.(*actorsfake.Fake).WithTable(func(ctx context.Context) (table.Interface, error) {
+		if ctx.Err() == nil {
+			blocking.Store(true)
+		}
+		return tbl, err
+	})
+	return blocking
+}
+
+func TestSandboxSelfNotHostedYetFailsFast(t *testing.T) {
+	const actorType = "dapr.internal.default.me.sandbox.py"
+	okFn := func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+		return &runtimev1pb.SandboxExecResponseAlpha1{Stdout: []byte("hi")}, nil
+	}
+
+	t.Run("type not hosted: host full, router not called", func(t *testing.T) {
+		u, rec := newSandboxUniversal(t, true, okFn)
+		var asked []string
+		tbl := tablefake.New().WithIsActorTypeHosted(func(at string) bool {
+			asked = append(asked, at)
+			return false
+		})
+		blocking := withSandboxTable(t, u, tbl, nil)
+
+		_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb1", Command: "x"})
+		require.ErrorIs(t, err, messages.ErrSandboxHostFull)
+		assert.Equal(t, 0, rec.len())
+		assert.Equal(t, []string{actorType}, asked)
+		assert.False(t, blocking.Load(), "Table must be asked with a done context so it never blocks")
+
+		// Create gives up after its attempts without reaching the router.
+		_, err = u.SandboxCreateAlpha1(t.Context(), &runtimev1pb.SandboxCreateRequestAlpha1{Component: "py"})
+		require.ErrorIs(t, err, messages.ErrSandboxHostFull)
+		assert.Equal(t, 0, rec.len())
+	})
+
+	t.Run("type hosted: routed", func(t *testing.T) {
+		u, rec := newSandboxUniversal(t, true, okFn)
+		withSandboxTable(t, u, tablefake.New().WithIsActorTypeHosted(func(at string) bool { return at == actorType }), nil)
+
+		res, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb1", Command: "x"})
+		require.NoError(t, err)
+		assert.Equal(t, "hi", string(res.GetStdout()))
+		assert.Equal(t, 1, rec.len())
+	})
+
+	t.Run("actor runtime not ready: routed as before", func(t *testing.T) {
+		u, rec := newSandboxUniversal(t, true, okFn)
+		withSandboxTable(t, u, nil, messages.ErrActorRuntimeNotFound)
+
+		_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb1", Command: "x"})
+		require.NoError(t, err)
+		assert.Equal(t, 1, rec.len())
+	})
+
+	t.Run("other app: no local check", func(t *testing.T) {
+		u, rec := newSandboxUniversal(t, false, okFn)
+		withSandboxTable(t, u, tablefake.New(), nil)
+
+		_, err := u.SandboxExecAlpha1(t.Context(), &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb1", AppId: "pool", Command: "x"})
+		require.NoError(t, err)
+		assert.Equal(t, 1, rec.len())
+	})
+}
