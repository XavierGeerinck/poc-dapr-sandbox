From a7292f11fbe5ad52daeb2a86bafcc70bcd42653b Mon Sep 17 00:00:00 2001
From: Xavier Geerinck <xavier.geerinck@gmail.com>
Date: Wed, 28 Oct 2026 21:03:21 +0100
Subject: [PATCH 11/27] fix(sandbox): treat unavailable driver as lost; fail
 fast before ready

A driver call on an acquired instance that fails with Unavailable now
means the sandbox is lost, like NotFound: the driver itself is gone (for
example a crashed pluggable driver) and took the VM with it. The target
is removed and the caller gets ERR_SANDBOX_LOST.

A call to a sandbox component of this app whose actor type is not
registered yet (its driver is not ready) now fails at once with
ERR_SANDBOX_HOST_FULL (retry later). Before, it went through the
placement lookup retries for about 5 s and then failed with
ERR_SANDBOX_LOST. The check asks the actor table with a done context,
so it never blocks; while the actor runtime itself is not ready the
call takes the normal route.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/actors/targets/sandbox/sandbox.go      |  6 +-
 pkg/actors/targets/sandbox/sandbox_test.go | 49 +++++++++++++++
 pkg/api/universal/sandbox.go               | 31 ++++++++-
 pkg/api/universal/sandbox_test.go          | 73 ++++++++++++++++++++++
 4 files changed, 156 insertions(+), 3 deletions(-)

diff --git a/pkg/actors/targets/sandbox/sandbox.go b/pkg/actors/targets/sandbox/sandbox.go
index 6c1d27c08..a7c081324 100644
--- a/pkg/actors/targets/sandbox/sandbox.go
+++ b/pkg/actors/targets/sandbox/sandbox.go
@@ -421,9 +421,11 @@ func (t *target) acquire(ctx context.Context, method string, timing *runtimev1pb
 }
 
 // instanceErr maps a driver error for a call on the instance itself: NotFound
-// means the VM is gone, so the sandbox is lost and the target is removed.
+// means the VM is gone and Unavailable means the driver itself is gone (for
+// example a crashed pluggable driver), taking the VM with it. Either way the
+// sandbox is lost and the target is removed.
 func (t *target) instanceErr(op string, err error) error {
-	if status.Code(err) == codes.NotFound {
+	if code := status.Code(err); code == codes.NotFound || code == codes.Unavailable {
 		log.Debugf("Sandbox actor '%s' lost its instance: %v", t.Key(), err)
 		t.factory.remove(t)
 		return ErrSandboxLost()
diff --git a/pkg/actors/targets/sandbox/sandbox_test.go b/pkg/actors/targets/sandbox/sandbox_test.go
index 58b0f5fb7..dcf34a4ce 100644
--- a/pkg/actors/targets/sandbox/sandbox_test.go
+++ b/pkg/actors/targets/sandbox/sandbox_test.go
@@ -391,6 +391,55 @@ func TestDriverNotFoundIsLost(t *testing.T) {
 	assert.NotEqual(t, first.(*target).activation, res.GetActivation())
 }
 
+func TestDriverUnavailableIsLost(t *testing.T) {
+	t.Run("exec", func(t *testing.T) {
+		d := &fakeDriver{}
+		f := newFactory(t, d)
+
+		first := execOK(t, f, "sb1", &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+
+		// The driver went away (for example a crashed pluggable driver).
+		d.execErr = status.Error(codes.Unavailable, "connection refused")
+		_, err := invoke(t, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+		requireLost(t, err)
+		assert.False(t, f.Exists("sb1"))
+		assert.Empty(t, f.LiveInstanceIDs())
+		// The instance is still handed back, in case the driver returns.
+		assert.Eventually(t, func() bool { return d.releaseCount.Load() == 1 }, 5*time.Second, 10*time.Millisecond)
+		assert.Equal(t, []string{"inst-1"}, d.releasedIDs())
+
+		// A later call starts over with a new activation.
+		d.execErr = nil
+		res := execOK(t, f, "sb1", &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+		assert.Equal(t, int32(2), d.acquireCount.Load())
+		assert.NotEqual(t, first.GetActivation(), res.GetActivation())
+	})
+
+	t.Run("session start", func(t *testing.T) {
+		d := &fakeDriver{sessionStartErr: status.Error(codes.Unavailable, "connection refused")}
+		f := newFactory(t, d)
+
+		_, err := invoke(t, f, "sb1", MethodSessionStart, &runtimev1pb.SandboxSessionStartRequestAlpha1{Command: "sh"})
+		requireLost(t, err)
+		assert.False(t, f.Exists("sb1"))
+		assert.Eventually(t, func() bool { return d.releaseCount.Load() == 1 }, 5*time.Second, 10*time.Millisecond)
+	})
+
+	t.Run("other driver errors keep the sandbox", func(t *testing.T) {
+		d := &fakeDriver{}
+		f := newFactory(t, d)
+
+		execOK(t, f, "sb1", &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+		d.execErr = status.Error(codes.Internal, "boom")
+		_, err := invoke(t, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+		require.Error(t, err)
+		assert.Equal(t, codes.Internal, status.Code(err))
+		assert.False(t, IsSandboxLost(err))
+		assert.True(t, f.Exists("sb1"))
+		assert.Equal(t, []string{"inst-1"}, f.LiveInstanceIDs())
+	})
+}
