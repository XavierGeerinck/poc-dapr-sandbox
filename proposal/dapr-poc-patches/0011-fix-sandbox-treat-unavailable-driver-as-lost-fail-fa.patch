diff --git a/pkg/api/universal/sandbox.go b/pkg/api/universal/sandbox.go
index 54c5839cf..c0f0bc3e2 100644
--- a/pkg/api/universal/sandbox.go
+++ b/pkg/api/universal/sandbox.go
@@ -42,6 +42,13 @@ const (
 	sandboxTimeoutGrace = 30 * time.Second
 )
 
+// doneCtx is an already cancelled context, for calls that must not block.
+var doneCtx = func() context.Context {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	return ctx
+}()
+
 // sandboxCall routes a sandbox actor method call and returns the raw response
 // data. Errors are already mapped to API errors.
 func (a *Universal) sandboxCall(ctx context.Context, component, appID, sandboxID, method string, timeoutMs uint32, req proto.Message) ([]byte, error) {
@@ -53,12 +60,21 @@ func (a *Universal) sandboxCall(ctx context.Context, component, appID, sandboxID
 	if target == "" {
 		target = a.appID
 	}
+	actorType := sandboxhost.ActorType(a.namespace, target, component)
 	if target == a.appID {
 		if _, ok := a.compStore.GetSandbox(component); !ok {
 			err := messages.ErrSandboxNotFound.WithFormat(component)
 			a.logger.Debug(err)
 			return nil, err
 		}
+		// The component exists but its actor type is not registered yet,
+		// because the driver is not ready. Routing would retry the placement
+		// lookup for a host that does not exist yet and then fail, so tell
+		// the caller to retry later instead.
+		if a.sandboxNotHostedYet(actorType) {
+			a.logger.Debugf("sandbox component %s is not ready yet", component)
+			return nil, messages.ErrSandboxHostFull
+		}
 	}
 
 	data, err := proto.Marshal(req)
@@ -79,7 +95,7 @@ func (a *Universal) sandboxCall(ctx context.Context, component, appID, sandboxID
 
 	ireq := internalsv1pb.
 		NewInternalInvokeRequest(method).
-		WithActor(sandboxhost.ActorType(a.namespace, target, component), sandboxID).
+		WithActor(actorType, sandboxID).
 		WithData(data).
 		WithContentType("application/x-protobuf")
 
@@ -90,6 +106,19 @@ func (a *Universal) sandboxCall(ctx context.Context, component, appID, sandboxID
 	return res.GetMessage().GetData().GetValue(), nil
 }
 
+// sandboxNotHostedYet reports whether this sidecar's actor runtime is ready
+// but does not host actorType. It never blocks: Table is asked with a done
+// context, which still returns the table of a ready runtime. While the actor
+// runtime itself is not ready (or is disabled) it reports false, so the call
+// takes the normal route and gets the actor runtime's own behaviour.
+func (a *Universal) sandboxNotHostedYet(actorType string) bool {
+	tbl, err := a.actors.Table(doneCtx)
+	if err != nil || tbl == nil {
+		return false
+	}
+	return !tbl.IsActorTypeHosted(actorType)
+}
+
 // mapSandboxError maps the gRPC status code of a router error to an API error.
 func (a *Universal) mapSandboxError(err error) error {
 	if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {
diff --git a/pkg/api/universal/sandbox_test.go b/pkg/api/universal/sandbox_test.go
