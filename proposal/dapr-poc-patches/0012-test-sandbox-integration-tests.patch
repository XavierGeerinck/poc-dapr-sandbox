+
+// Package sandbox tests the alpha Sandbox building block end to end: sandbox
+// components hosted as internal actors and reached over the HTTP API.
+package sandbox
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/encoding/protojson"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/dapr/dapr/tests/integration/framework/process/daprd"
+)
+
+// unmarshalOpts decodes the API's protojson responses.
+var unmarshalOpts = protojson.UnmarshalOptions{DiscardUnknown: true}
+
+// actorType is the internal actor type of a sandbox component hosted by d.
+func actorType(d *daprd.Daprd, component string) string {
+	return "dapr.internal." + d.Namespace() + "." + d.AppID() + ".sandbox." + component
+}
+
+// sandboxURL builds an API URL under /v1.0-alpha1/sandboxes on d; parts are
+// path-escaped.
+func sandboxURL(d *daprd.Daprd, parts ...string) string {
+	u := "http://" + d.HTTPAddress() + "/v1.0-alpha1/sandboxes"
+	for _, p := range parts {
+		u += "/" + url.PathEscape(p)
+	}
+	return u
+}
+
+// result is the outcome of one API call.
+type result struct {
+	status int
+	body   []byte
+}
+
+// errorCode returns the Dapr error code of an error response, or "".
+func (r result) errorCode() string {
+	var e struct {
+		ErrorCode string `json:"errorCode"`
+	}
+	_ = json.Unmarshal(r.body, &e)
+	return e.ErrorCode
+}
+
+func (r result) String() string {
+	return fmt.Sprintf("%d %s", r.status, r.body)
+}
+
+// call sends a request with a JSON body (nil for none) and returns the
+// response. headers are key/value pairs. It reports transport failures
+// through t, so it is safe inside EventuallyWithT.
+func call(t assert.TestingT, ctx context.Context, client *http.Client, method, u string, body any, headers ...string) result {
+	var rd io.Reader
+	if body != nil {
+		b, err := json.Marshal(body)
+		if !assert.NoError(t, err) {
+			return result{}
+		}
+		rd = bytes.NewReader(b)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, u, rd)
+	if !assert.NoError(t, err) {
+		return result{}
+	}
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	for i := 0; i+1 < len(headers); i += 2 {
+		req.Header.Set(headers[i], headers[i+1])
+	}
+	resp, err := client.Do(req)
+	if !assert.NoError(t, err) {
+		return result{}
+	}
+	defer resp.Body.Close()
+	b, err := io.ReadAll(resp.Body)
+	assert.NoError(t, err)
+	return result{status: resp.StatusCode, body: b}
+}
+
+// decode requires a 200 response and decodes its body into msg.
+func decode(t require.TestingT, r result, msg proto.Message) {
+	require.Equal(t, http.StatusOK, r.status, r.String())
+	require.NoError(t, unmarshalOpts.Unmarshal(r.body, msg), r.String())
+}
+
+// execBody is the JSON body of an exec request.
+type execBody struct {
+	Command            string   `json:"command"`
+	Args               []string `json:"args,omitempty"`
+	TimeoutMs          uint32   `json:"timeoutMs,omitempty"`
+	ExpectedActivation string   `json:"expectedActivation,omitempty"`
+}
+
+// sessionStartBody is the JSON body of a session start request.
+type sessionStartBody struct {
+	Command string   `json:"command"`
+	Args    []string `json:"args,omitempty"`
+}
+
+// sessionSendBody is the JSON body of a session send request. Bytes fields
+// are base64 in protojson, which is how encoding/json marshals []byte.
+type sessionSendBody struct {
+	Input     []byte `json:"input,omitempty"`
+	Until     []byte `json:"until,omitempty"`
+	TimeoutMs uint32 `json:"timeoutMs,omitempty"`
+}
