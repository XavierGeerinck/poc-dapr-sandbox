+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+	"github.com/dapr/dapr/tests/integration/framework"
+	"github.com/dapr/dapr/tests/integration/framework/client"
+	"github.com/dapr/dapr/tests/integration/framework/process/daprd"
+	"github.com/dapr/dapr/tests/integration/framework/process/placement"
+	procsandbox "github.com/dapr/dapr/tests/integration/framework/process/sandbox"
+	"github.com/dapr/dapr/tests/integration/framework/process/scheduler"
+	"github.com/dapr/dapr/tests/integration/framework/socket"
+	"github.com/dapr/dapr/tests/integration/suite"
+)
+
+func init() {
+	suite.Register(new(pluggable))
+}
+
+// pluggable drives a fake pluggable sandbox driver through not ready, ready
+// and crashed.
+type pluggable struct {
+	daprd  *daprd.Daprd
+	place  *placement.Placement
+	sched  *scheduler.Scheduler
+	driver *procsandbox.Sandbox
+}
+
+// notReadyFor is how long the driver reports not ready at least.
+const notReadyFor = time.Second
+
+func (p *pluggable) Setup(t *testing.T) []framework.Option {
+	if runtime.GOOS == "windows" {
+		t.Skip("skipping unix socket based test on windows")
+	}
+
+	sock := socket.New(t)
+	p.driver = procsandbox.New(t,
+		procsandbox.WithSocket(sock),
+		procsandbox.WithReady(false),
+	)
+	p.place = placement.New(t)
+	p.sched = scheduler.New(t)
+	p.daprd = daprd.New(t,
+		daprd.WithSocket(t, sock),
+		daprd.WithPlacementAddresses(p.place.Address()),
+		daprd.WithSchedulerAddresses(p.sched.Address()),
+		daprd.WithInMemoryActorStateStore("mystore"),
+		daprd.WithResourceFiles(`
+apiVersion: dapr.io/v1alpha1
+kind: Component
+metadata:
+  name: fake
+spec:
+  type: sandbox.`+p.driver.SocketName()+`
+  version: v1
+  metadata:
+  - name: image
+    value: local
+`),
+	)
+
+	return []framework.Option{
+		framework.WithProcesses(p.driver, p.place, p.sched, p.daprd),
+	}
+}
+
+func (p *pluggable) Run(t *testing.T, ctx context.Context) {
+	notReadySince := time.Now()
+
+	p.place.WaitUntilRunning(t, ctx)
+	p.sched.WaitUntilRunning(t, ctx)
+	p.daprd.WaitUntilRunning(t, ctx)
+
+	// The actor runtime is up, and daprd polls the driver until it is ready.
+	require.EventuallyWithT(t, func(c *assert.CollectT) {
+		assert.True(c, p.daprd.GetMetaActorRuntime(c, ctx).HostReady)
+	}, 10*time.Second, 10*time.Millisecond)
+	require.Eventually(t, func() bool { return p.driver.ReadyCalls() > 0 }, 10*time.Second, 10*time.Millisecond)
+
+	httpClient := client.HTTP(t)
+	execURL := sandboxURL(p.daprd, "fake", "sb-1", "exec")
+
+	t.Run("exec before the driver is ready fails fast", func(t *testing.T) {
+		cctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+		defer cancel()
+		start := time.Now()
+		r := call(t, cctx, httpClient, http.MethodPost, execURL, execBody{Command: "echo", Args: []string{"hi"}})
+		elapsed := time.Since(start)
+		t.Logf("exec before ready: %s after %s", r, elapsed)
+		assert.Less(t, elapsed, 5*time.Second)
+		assert.True(t, strings.HasPrefix(r.errorCode(), "ERR_"), r.String())
+		// The actor type is not registered yet: retry later.
+		assert.Equal(t, http.StatusTooManyRequests, r.status, r.String())
+		assert.Equal(t, "ERR_SANDBOX_HOST_FULL", r.errorCode())
+		assert.Zero(t, p.driver.Acquires())
+
+		// daprd is still running.
+		p.daprd.WaitUntilRunning(t, ctx)
+	})
+
+	// Keep the driver not ready for at least notReadyFor overall.
+	time.Sleep(time.Until(notReadySince.Add(notReadyFor)))
+	p.driver.SetReady(true)
+	p.daprd.WaitUntilActorTypeHosted(t, ctx, actorType(p.daprd, "fake"))
+
+	t.Run("exec after the driver is ready succeeds", func(t *testing.T) {
+		var res runtimev1pb.SandboxExecResponseAlpha1
+		require.EventuallyWithT(t, func(c *assert.CollectT) {
+			r := call(c, ctx, httpClient, http.MethodPost, execURL, execBody{Command: "echo", Args: []string{"hi"}})
+			if assert.Equal(c, http.StatusOK, r.status, r.String()) {
+				decode(c, r, &res)
+			}
+		}, 20*time.Second, 100*time.Millisecond)
+		assert.Equal(t, "echo hi\n", string(res.GetStdout()))
+		assert.Equal(t, "POOL", res.GetTiming().GetAcquirePath())
+		assert.Equal(t, 1, p.driver.LiveInstances())
+	})
+
+	t.Run("exec after the driver died is lost", func(t *testing.T) {
+		p.driver.Kill(t)
+
+		cctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+		defer cancel()
+		start := time.Now()
+		r := call(t, cctx, httpClient, http.MethodPost, execURL, execBody{Command: "echo", Args: []string{"hi"}})
+		elapsed := time.Since(start)
+		assert.Less(t, elapsed, 5*time.Second)
+		assert.Equal(t, http.StatusGone, r.status, r.String())
+		assert.Equal(t, "ERR_SANDBOX_LOST", r.errorCode())
+
+		// daprd is still running.
+		p.daprd.WaitUntilRunning(t, ctx)
+	})
+}
