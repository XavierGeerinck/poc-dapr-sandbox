+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package sandbox
+
+import (
+	"context"
+	"net/http"
+	"runtime"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+	"github.com/dapr/dapr/tests/integration/framework"
+	"github.com/dapr/dapr/tests/integration/framework/client"
+	"github.com/dapr/dapr/tests/integration/framework/process/daprd"
+	"github.com/dapr/dapr/tests/integration/framework/process/placement"
+	"github.com/dapr/dapr/tests/integration/framework/process/scheduler"
+	"github.com/dapr/dapr/tests/integration/suite"
+)
+
+func init() {
+	suite.Register(new(process))
+}
+
+// process runs the built-in process driver in a single daprd and drives the
+// sandbox HTTP API through exec, sessions, create and the error paths.
+type process struct {
+	daprd *daprd.Daprd
+	place *placement.Placement
+	sched *scheduler.Scheduler
+}
+
+func (p *process) Setup(t *testing.T) []framework.Option {
+	if runtime.GOOS == "windows" {
+		t.Skip("the process sandbox driver is not available on windows")
+	}
+
+	p.place = placement.New(t)
+	p.sched = scheduler.New(t)
+	p.daprd = daprd.New(t,
+		daprd.WithPlacementAddresses(p.place.Address()),
+		daprd.WithSchedulerAddresses(p.sched.Address()),
+		daprd.WithInMemoryActorStateStore("mystore"),
+		daprd.WithResourceFiles(`
+apiVersion: dapr.io/v1alpha1
+kind: Component
+metadata:
+  name: py
+spec:
+  type: sandbox.process
+  version: v1
+  metadata:
+  - name: image
+    value: local
+  - name: template
+    value: none
+  - name: warmPoolSize
+    value: "2"
+`),
+	)
+
+	return []framework.Option{
+		framework.WithProcesses(p.place, p.sched, p.daprd),
+	}
+}
+
+func (p *process) Run(t *testing.T, ctx context.Context) {
+	p.place.WaitUntilRunning(t, ctx)
+	p.sched.WaitUntilRunning(t, ctx)
+	p.daprd.WaitUntilRunning(t, ctx)
+	// The type is registered once the warm pool is full and actors are ready.
+	p.daprd.WaitUntilActorTypeHosted(t, ctx, actorType(p.daprd, "py"))
+
+	httpClient := client.HTTP(t)
+
+	// The first exec on an ID can race the placement table that announces
+	// the new type, so retry it until it succeeds.
+	var first runtimev1pb.SandboxExecResponseAlpha1
+	t.Run("exec on a new ID takes a warm sandbox", func(t *testing.T) {
+		require.EventuallyWithT(t, func(c *assert.CollectT) {
+			r := call(c, ctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "py", "sb-1", "exec"),
+				execBody{Command: "echo", Args: []string{"hi"}, TimeoutMs: 5000})
+			if assert.Equal(c, http.StatusOK, r.status, r.String()) {
+				decode(c, r, &first)
+			}
+		}, 20*time.Second, 100*time.Millisecond)
+
+		assert.Equal(t, "sb-1", first.GetSandboxId())
+		assert.Equal(t, "hi\n", string(first.GetStdout()))
+		assert.NotEmpty(t, first.GetActivation())
+		assert.Equal(t, "POOL", first.GetTiming().GetAcquirePath())
+		assert.Positive(t, first.GetTiming().GetTotalUs())
+	})
+
+	t.Run("a second exec reuses the activation", func(t *testing.T) {
+		var res runtimev1pb.SandboxExecResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "py", "sb-1", "exec"),
+			execBody{Command: "echo", Args: []string{"again"}, ExpectedActivation: first.GetActivation()}), &res)
+		assert.Equal(t, first.GetActivation(), res.GetActivation())
+		assert.Equal(t, "again\n", string(res.GetStdout()))
+		// Only the call that acquired the sandbox reports a path.
+		assert.Empty(t, res.GetTiming().GetAcquirePath())
+	})
+
+	t.Run("a session keeps shell state between sends", func(t *testing.T) {
+		var started runtimev1pb.SandboxSessionStartResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "py", "sb-1", "sessions"),
+			sessionStartBody{Command: "sh", Args: []string{"-i"}}), &started)
+		require.NotEmpty(t, started.GetSessionId())
+		assert.Equal(t, first.GetActivation(), started.GetActivation())
+		sessionURL := sandboxURL(p.daprd, "py", "sb-1", "sessions", started.GetSessionId())
+
+		// No `until`: the send returns once timeoutMs has passed.
+		var set runtimev1pb.SandboxExecResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sessionURL,
+			sessionSendBody{Input: []byte("X=42\n"), TimeoutMs: 200}), &set)
+
+		var echo runtimev1pb.SandboxExecResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sessionURL,
+			sessionSendBody{Input: []byte("echo $X\n"), Until: []byte("42"), TimeoutMs: 10000}), &echo)
+		assert.Contains(t, string(echo.GetStdout()), "42")
+		assert.False(t, echo.GetTimedOut(), "stdout=%q stderr=%q", echo.GetStdout(), echo.GetStderr())
+
+		r := call(t, ctx, httpClient, http.MethodDelete, sessionURL, nil)
+		assert.Equal(t, http.StatusOK, r.status, r.String())
+	})
+
+	t.Run("a stale expected activation is lost", func(t *testing.T) {
+		r := call(t, ctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "py", "sb-1", "exec"),
+			execBody{Command: "echo", Args: []string{"x"}, ExpectedActivation: "stale-" + first.GetActivation()})
+		assert.Equal(t, http.StatusGone, r.status, r.String())
+		assert.Equal(t, "ERR_SANDBOX_LOST", r.errorCode())
+	})
+
+	t.Run("create returns an ID that can exec", func(t *testing.T) {
+		var created runtimev1pb.SandboxCreateResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "py"), nil), &created)
+		require.NotEmpty(t, created.GetSandboxId())
+		require.NotEmpty(t, created.GetActivation())
+
+		var res runtimev1pb.SandboxExecResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "py", created.GetSandboxId(), "exec"),
+			execBody{Command: "echo", Args: []string{"created"}, ExpectedActivation: created.GetActivation()}), &res)
+		assert.Equal(t, created.GetSandboxId(), res.GetSandboxId())
+		assert.Equal(t, created.GetActivation(), res.GetActivation())
+		assert.Equal(t, "created\n", string(res.GetStdout()))
+
+		r := call(t, ctx, httpClient, http.MethodDelete, sandboxURL(p.daprd, "py", created.GetSandboxId()), nil)
+		assert.Equal(t, http.StatusOK, r.status, r.String())
+	})
+
+	t.Run("an unknown component fails fast", func(t *testing.T) {
+		cctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+		defer cancel()
+		start := time.Now()
+		r := call(t, cctx, httpClient, http.MethodPost, sandboxURL(p.daprd, "nope", "sb-1", "exec"),
+			execBody{Command: "echo", Args: []string{"hi"}})
+		assert.Less(t, time.Since(start), 5*time.Second)
+		assert.GreaterOrEqual(t, r.status, 400, r.String())
+		assert.Less(t, r.status, 500, r.String())
+		assert.Equal(t, "ERR_SANDBOX_NOT_FOUND", r.errorCode())
+	})
+}
