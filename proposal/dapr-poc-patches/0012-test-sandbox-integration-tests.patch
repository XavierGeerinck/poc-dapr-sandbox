+
+package sandbox
+
+import (
+	"context"
+	"net/http"
+	"os/exec"
+	"runtime"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+	"github.com/dapr/dapr/tests/integration/framework"
+	"github.com/dapr/dapr/tests/integration/framework/client"
+	"github.com/dapr/dapr/tests/integration/framework/process/daprd"
+	"github.com/dapr/dapr/tests/integration/framework/process/placement"
+	"github.com/dapr/dapr/tests/integration/framework/process/scheduler"
+	"github.com/dapr/dapr/tests/integration/suite"
+)
+
+func init() {
+	suite.Register(new(crossapp))
+}
+
+// crossapp checks that a caller without a sandbox component reaches the
+// sandbox component of another app, and that the sandbox runs there.
+//
+// Sandbox processes are counted as the child processes of each daprd: the
+// process driver starts every command as a direct child of daprd, and daprd
+// starts no other children. A session keeps one such process alive while
+// the counts are taken.
+type crossapp struct {
+	pool   *daprd.Daprd
+	caller *daprd.Daprd
+	place  *placement.Placement
+	sched  *scheduler.Scheduler
+}
+
+func (c *crossapp) Setup(t *testing.T) []framework.Option {
+	if runtime.GOOS == "windows" {
+		t.Skip("the process sandbox driver is not available on windows")
+	}
+
+	c.place = placement.New(t)
+	c.sched = scheduler.New(t)
+	c.pool = daprd.New(t,
+		daprd.WithAppID("pool"),
+		daprd.WithPlacementAddresses(c.place.Address()),
+		daprd.WithSchedulerAddresses(c.sched.Address()),
+		daprd.WithInMemoryActorStateStore("mystore"),
+		daprd.WithResourceFiles(`
+apiVersion: dapr.io/v1alpha1
+kind: Component
+metadata:
+  name: py
+spec:
+  type: sandbox.process
+  version: v1
+  metadata:
+  - name: image
+    value: local
+  - name: template
+    value: none
+  - name: warmPoolSize
+    value: "2"
+`),
+	)
+	c.caller = daprd.New(t,
+		daprd.WithAppID("caller"),
+		daprd.WithPlacementAddresses(c.place.Address()),
+		daprd.WithSchedulerAddresses(c.sched.Address()),
+		daprd.WithInMemoryActorStateStore("mystore"),
+	)
+
+	return []framework.Option{
+		framework.WithProcesses(c.place, c.sched, c.pool, c.caller),
+	}
+}
+
+func (c *crossapp) Run(t *testing.T, ctx context.Context) {
+	c.place.WaitUntilRunning(t, ctx)
+	c.sched.WaitUntilRunning(t, ctx)
+	c.pool.WaitUntilRunning(t, ctx)
+	c.caller.WaitUntilRunning(t, ctx)
+	c.pool.WaitUntilActorTypeHosted(t, ctx, actorType(c.pool, "py"))
+
+	poolPID := daprdPID(t, c.pool)
+	callerPID := daprdPID(t, c.caller)
+	require.NotEqual(t, poolPID, callerPID)
+
+	httpClient := client.HTTP(t)
+	viaPool := []string{"dapr-app-id", "pool"}
+
+	poolBefore := len(childPIDs(t, poolPID))
+	callerBefore := len(childPIDs(t, callerPID))
+
+	t.Run("caller execs in the pool app's sandbox", func(t *testing.T) {
+		// Retry until placement has told the caller where the type lives.
+		var res runtimev1pb.SandboxExecResponseAlpha1
+		require.EventuallyWithT(t, func(col *assert.CollectT) {
+			r := call(col, ctx, httpClient, http.MethodPost, sandboxURL(c.caller, "py", "sb-x", "exec"),
+				execBody{Command: "echo", Args: []string{"hi"}, TimeoutMs: 5000}, viaPool...)
+			if assert.Equal(col, http.StatusOK, r.status, r.String()) {
+				decode(col, r, &res)
+			}
+		}, 20*time.Second, 100*time.Millisecond)
+		assert.Equal(t, "hi\n", string(res.GetStdout()))
+		assert.Equal(t, "POOL", res.GetTiming().GetAcquirePath())
+
+		// The command's parent is the pool daprd.
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sandboxURL(c.caller, "py", "sb-x", "exec"),
+			execBody{Command: "sh", Args: []string{"-c", "echo $PPID"}}, viaPool...), &res)
+		assert.Equal(t, strconv.Itoa(poolPID), strings.TrimSpace(string(res.GetStdout())))
+	})
+
+	t.Run("sandbox processes run in the pool app only", func(t *testing.T) {
+		// `cat` waits on its stdin, so the session keeps it alive.
+		var started runtimev1pb.SandboxSessionStartResponseAlpha1
+		decode(t, call(t, ctx, httpClient, http.MethodPost, sandboxURL(c.caller, "py", "sb-x", "sessions"),
+			sessionStartBody{Command: "cat"}, viaPool...), &started)
+
+		assert.EventuallyWithT(t, func(col *assert.CollectT) {
+			assert.Greater(col, len(childPIDs(col, poolPID)), poolBefore)
+		}, 5*time.Second, 50*time.Millisecond)
+		assert.Len(t, childPIDs(t, callerPID), callerBefore)
+		t.Logf("sandbox processes: pool %d -> %d, caller %d -> %d",
+			poolBefore, len(childPIDs(t, poolPID)), callerBefore, len(childPIDs(t, callerPID)))
+
+		r := call(t, ctx, httpClient, http.MethodDelete,
+			sandboxURL(c.caller, "py", "sb-x", "sessions", started.GetSessionId()), nil, viaPool...)
+		assert.Equal(t, http.StatusOK, r.status, r.String())
+		assert.EventuallyWithT(t, func(col *assert.CollectT) {
+			assert.Len(col, childPIDs(col, poolPID), poolBefore)
+		}, 5*time.Second, 50*time.Millisecond)
+		assert.Len(t, childPIDs(t, callerPID), callerBefore)
+	})
+
+	t.Run("caller has no sandbox component of its own", func(t *testing.T) {
+		r := call(t, ctx, httpClient, http.MethodPost, sandboxURL(c.caller, "py", "sb-x", "exec"),
+			execBody{Command: "echo", Args: []string{"hi"}})
+		assert.Equal(t, http.StatusBadRequest, r.status, r.String())
+		assert.Equal(t, "ERR_SANDBOX_NOT_FOUND", r.errorCode())
+	})
+}
+
+// psRow is one line of `ps`.
+type psRow struct {
+	pid, ppid int
+	args      []string
+}
+
+func listProcesses(t assert.TestingT) []psRow {
+	out, err := exec.Command("ps", "-A", "-ww", "-o", "pid=,ppid=,command=").Output()
+	if !assert.NoError(t, err) {
+		return nil
+	}
+	var rows []psRow
+	for _, line := range strings.Split(string(out), "\n") {
+		f := strings.Fields(line)
+		if len(f) < 3 {
+			continue
+		}
+		pid, err1 := strconv.Atoi(f[0])
+		ppid, err2 := strconv.Atoi(f[1])
+		if err1 != nil || err2 != nil {
+			continue
+		}
+		rows = append(rows, psRow{pid: pid, ppid: ppid, args: f[2:]})
+	}
+	return rows
+}
+
+// daprdPID finds the daprd process by its HTTP port flag, which is unique to
+// each daprd.
+func daprdPID(t *testing.T, d *daprd.Daprd) int {
+	t.Helper()
+	flag := "--dapr-http-port=" + strconv.Itoa(d.HTTPPort())
+	var pids []int
+	for _, row := range listProcesses(t) {
+		for _, a := range row.args {
+			if a == flag {
+				pids = append(pids, row.pid)
+				break
+			}
+		}
+	}
+	require.Len(t, pids, 1, "daprd processes with %s", flag)
+	return pids[0]
+}
+
+// childPIDs returns the PIDs of the direct children of pid.
+func childPIDs(t assert.TestingT, pid int) []int {
+	var pids []int
+	for _, row := range listProcesses(t) {
+		if row.ppid == pid {
+			pids = append(pids, row.pid)
+		}
+	}
+	return pids
+}
