+// Package sandbox runs a fake pluggable sandbox driver over a unix socket for
+// integration tests. It keeps its "instances" in memory and runs nothing.
+package sandbox
+
+import (
+	"context"
+	"net"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/reflection"
+	"google.golang.org/grpc/status"
+
+	compv1pb "github.com/dapr/dapr/pkg/proto/components/v1"
+	"github.com/dapr/dapr/tests/integration/framework/socket"
+)
+
+// Option configures the fake driver.
+type Option func(*options)
+
+type options struct {
+	socket *socket.Socket
+	ready  bool
+}
+
+// WithSocket sets the socket directory the driver listens in. Required.
+func WithSocket(s *socket.Socket) Option {
+	return func(o *options) {
+		o.socket = s
+	}
+}
+
+// WithReady sets whether the driver reports ready from the start. Defaults
+// to true; use SetReady to change it later.
+func WithReady(ready bool) Option {
+	return func(o *options) {
+		o.ready = ready
+	}
+}
+
+// Sandbox is a fake pluggable sandbox driver.
+type Sandbox struct {
+	listener   net.Listener
+	socketName string
+	server     *grpc.Server
+	driver     *driver
+
+	srvErrCh chan error
+	started  atomic.Bool
+	stopOnce sync.Once
+}
+
+// New creates the driver and starts listening on a new socket file in the
+// socket directory, so daprd can discover it as `sandbox.<SocketName()>`.
+func New(t *testing.T, fopts ...Option) *Sandbox {
+	t.Helper()
+
+	opts := options{ready: true}
+	for _, fopt := range fopts {
+		fopt(&opts)
+	}
+
+	require.NotNil(t, opts.socket)
+
+	// Start the listener in New so we can squat on the path immediately, and
+	// keep it for the entire test case.
+	socketFile := opts.socket.File(t)
+	listener, err := net.Listen("unix", socketFile.Filename())
+	require.NoError(t, err)
+
+	d := &driver{instances: make(map[string]*instance)}
+	d.ready.Store(opts.ready)
+
+	server := grpc.NewServer()
+	compv1pb.RegisterSandboxServer(server, d)
+	reflection.Register(server)
+
+	return &Sandbox{
+		listener:   listener,
+		socketName: socketFile.Name(),
+		server:     server,
+		driver:     d,
+		srvErrCh:   make(chan error, 1),
+	}
+}
+
+// SocketName is the component type suffix: `sandbox.<SocketName()>`.
+func (s *Sandbox) SocketName() string {
+	return s.socketName
+}
+
+func (s *Sandbox) Run(t *testing.T, ctx context.Context) {
+	s.started.Store(true)
+	go func() {
+		s.srvErrCh <- s.server.Serve(s.listener)
+	}()
+
+	conn, err := grpc.DialContext(ctx, "unix://"+s.listener.Addr().String(), //nolint:staticcheck
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithBlock(), //nolint:staticcheck
+	)
+	require.NoError(t, err)
+
+	client := compv1pb.NewSandboxClient(conn)
+	assert.EventuallyWithT(t, func(c *assert.CollectT) {
+		_, err = client.Ping(ctx, new(compv1pb.PingRequest))
+		assert.NoError(c, err)
+	}, 10*time.Second, 10*time.Millisecond)
+	require.NoError(t, conn.Close())
+}
+
+// Cleanup stops the driver if Kill did not already.
+func (s *Sandbox) Cleanup(t *testing.T) {
+	s.stop(t)
+}
+
+// Kill stops the driver abruptly, as if it crashed: open connections are
+// closed and the socket file is removed.
+func (s *Sandbox) Kill(t *testing.T) {
+	t.Helper()
+	s.stop(t)
+}
+
+func (s *Sandbox) stop(t *testing.T) {
+	s.stopOnce.Do(func() {
+		if !s.started.Load() {
+			// Never served: only the listener (and its socket file) is open.
+			require.NoError(t, s.listener.Close())
+			return
+		}
+		// Stop closes the listener, which removes the socket file.
+		s.server.Stop()
+		require.NoError(t, <-s.srvErrCh)
+	})
+}
+
+// SetReady sets what the driver's Ready call reports.
+func (s *Sandbox) SetReady(ready bool) {
+	s.driver.ready.Store(ready)
+}
+
+// ReadyCalls returns how many times daprd asked the driver whether it is
+// ready.
+func (s *Sandbox) ReadyCalls() int64 {
+	return s.driver.readyCalls.Load()
+}
+
+// Acquires returns how many instances daprd acquired.
+func (s *Sandbox) Acquires() int64 {
+	return s.driver.acquires.Load()
+}
+
+// LiveInstances returns the number of instances acquired and not released.
+func (s *Sandbox) LiveInstances() int {
+	s.driver.lock.Lock()
+	defer s.driver.lock.Unlock()
+	return len(s.driver.instances)
+}
+
+type instance struct {
+	sessions map[string]struct{}
+	seq      int
+}
+
+// driver implements the Sandbox gRPC service. Exec echoes the command line
+// it was given; a session echoes its input.
+type driver struct {
+	compv1pb.UnimplementedSandboxServer
+
+	ready      atomic.Bool
+	readyCalls atomic.Int64
+	acquires   atomic.Int64
+
+	lock      sync.Mutex
+	nextID    int
+	instances map[string]*instance
+}
+
+func (d *driver) Init(context.Context, *compv1pb.SandboxInitRequest) (*compv1pb.SandboxInitResponse, error) {
+	return new(compv1pb.SandboxInitResponse), nil
+}
+
+func (d *driver) Features(context.Context, *compv1pb.FeaturesRequest) (*compv1pb.FeaturesResponse, error) {
+	return new(compv1pb.FeaturesResponse), nil
+}
+
+func (d *driver) Ping(context.Context, *compv1pb.PingRequest) (*compv1pb.PingResponse, error) {
+	return new(compv1pb.PingResponse), nil
+}
+
+func (d *driver) Ready(context.Context, *compv1pb.SandboxReadyRequest) (*compv1pb.SandboxReadyResponse, error) {
+	d.readyCalls.Add(1)
+	if d.ready.Load() {
+		return &compv1pb.SandboxReadyResponse{Ready: true}, nil
+	}
+	return &compv1pb.SandboxReadyResponse{Reason: "fake driver is not ready"}, nil
+}
+
+func (d *driver) Acquire(context.Context, *compv1pb.SandboxAcquireRequest) (*compv1pb.SandboxAcquireResponse, error) {
+	d.acquires.Add(1)
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	d.nextID++
+	id := "fake-" + strconv.Itoa(d.nextID)
+	d.instances[id] = &instance{sessions: make(map[string]struct{})}
+	return &compv1pb.SandboxAcquireResponse{
+		InstanceId: id,
+		Path:       compv1pb.SandboxAcquirePath_POOL,
+	}, nil
+}
+
+func (d *driver) get(id string) (*instance, error) {
+	inst, ok := d.instances[id]
+	if !ok {
+		return nil, status.Errorf(codes.NotFound, "unknown instance %q", id)
+	}
+	return inst, nil
+}
+
+func (d *driver) Exec(_ context.Context, req *compv1pb.SandboxExecRequest) (*compv1pb.SandboxExecResponse, error) {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	if _, err := d.get(req.GetInstanceId()); err != nil {
+		return nil, err
+	}
+	line := append([]string{req.GetSpec().GetCommand()}, req.GetSpec().GetArgs()...)
+	return &compv1pb.SandboxExecResponse{Stdout: []byte(strings.Join(line, " ") + "\n")}, nil
+}
+
+func (d *driver) SessionStart(_ context.Context, req *compv1pb.SandboxSessionStartRequest) (*compv1pb.SandboxSessionStartResponse, error) {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	inst, err := d.get(req.GetInstanceId())
+	if err != nil {
+		return nil, err
+	}
+	inst.seq++
+	id := "s" + strconv.Itoa(inst.seq)
+	inst.sessions[id] = struct{}{}
+	return &compv1pb.SandboxSessionStartResponse{SessionId: id}, nil
+}
+
+func (d *driver) SessionSend(_ context.Context, req *compv1pb.SandboxSessionSendRequest) (*compv1pb.SandboxExecResponse, error) {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	inst, err := d.get(req.GetInstanceId())
+	if err != nil {
+		return nil, err
+	}
+	if _, ok := inst.sessions[req.GetSessionId()]; !ok {
+		return nil, status.Errorf(codes.NotFound, "unknown session %q", req.GetSessionId())
+	}
+	return &compv1pb.SandboxExecResponse{Stdout: req.GetInput()}, nil
+}
+
+func (d *driver) SessionClose(_ context.Context, req *compv1pb.SandboxSessionCloseRequest) (*compv1pb.SandboxSessionCloseResponse, error) {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	inst, err := d.get(req.GetInstanceId())
+	if err != nil {
+		return nil, err
+	}
+	if _, ok := inst.sessions[req.GetSessionId()]; !ok {
+		return nil, status.Errorf(codes.NotFound, "unknown session %q", req.GetSessionId())
+	}
+	delete(inst.sessions, req.GetSessionId())
+	return new(compv1pb.SandboxSessionCloseResponse), nil
+}
+
+func (d *driver) Release(_ context.Context, req *compv1pb.SandboxReleaseRequest) (*compv1pb.SandboxReleaseResponse, error) {
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	if _, err := d.get(req.GetInstanceId()); err != nil {
+		return nil, err
+	}
+	delete(d.instances, req.GetInstanceId())
+	return new(compv1pb.SandboxReleaseResponse), nil
+}
+
+func (d *driver) Reconcile(_ context.Context, req *compv1pb.SandboxReconcileRequest) (*compv1pb.SandboxReconcileResponse, error) {
+	keep := make(map[string]struct{}, len(req.GetLiveInstanceIds()))
+	for _, id := range req.GetLiveInstanceIds() {
+		keep[id] = struct{}{}
+	}
+	d.lock.Lock()
+	defer d.lock.Unlock()
+	var released uint32
+	for id := range d.instances {
+		if _, ok := keep[id]; !ok {
+			delete(d.instances, id)
+			released++
+		}
+	}
+	return &compv1pb.SandboxReconcileResponse{Released: released}, nil
+}
