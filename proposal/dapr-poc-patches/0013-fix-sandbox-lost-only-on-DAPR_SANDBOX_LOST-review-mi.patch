+func TestAcquireUnavailableIsNotLost(t *testing.T) {
+	for _, method := range []string{MethodExec, MethodActivate, MethodSessionStart} {
+		t.Run(method, func(t *testing.T) {
+			d := &fakeDriver{acquireErr: status.Error(codes.Unavailable, "connection refused")}
+			f := newFactory(t, d)
+
+			var in proto.Message
+			switch method {
+			case MethodExec:
+				in = &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"}
+			case MethodActivate:
+				in = &runtimev1pb.SandboxCreateRequestAlpha1{}
+			case MethodSessionStart:
+				in = &runtimev1pb.SandboxSessionStartRequestAlpha1{Command: "sh"}
+			}
+			_, err := invoke(t, f, "sb1", method, in)
+			require.Error(t, err)
+			// Nothing was acquired, so nothing was lost: the driver error
+			// keeps its code.
+			assert.Equal(t, codes.Unavailable, status.Code(err))
+			assert.False(t, IsSandboxLost(err))
+			assert.False(t, f.Exists("sb1"))
+			assert.Equal(t, 0, f.Len())
+			assert.Empty(t, f.LiveInstanceIDs())
+			assert.Equal(t, int32(0), d.execCount.Load())
+			assert.Equal(t, int32(0), d.releaseStarted.Load())
+		})
+	}
+}
+
+func TestSessionSendCloseUnavailablePassThrough(t *testing.T) {
+	d := &fakeDriver{}
+	f := newFactory(t, d)
+
+	_, err := invoke(t, f, "sb1", MethodSessionStart, &runtimev1pb.SandboxSessionStartRequestAlpha1{Command: "sh"})
+	require.NoError(t, err)
+
+	// R6: session send and close do not detect a lost sandbox; the driver
+	// error passes through and the sandbox stays.
+	d.sessionSendErr = status.Error(codes.Unavailable, "connection refused")
+	d.sessionCloseErr = status.Error(codes.Unavailable, "connection refused")
+
+	_, err = invoke(t, f, "sb1", MethodSessionSend, &runtimev1pb.SandboxSessionSendRequestAlpha1{SessionId: "sess-1", Input: []byte("x\n")})
+	require.Error(t, err)
+	assert.Equal(t, codes.Unavailable, status.Code(err))
+	assert.False(t, IsSandboxLost(err))
+	assert.True(t, f.Exists("sb1"))
+
+	_, err = invoke(t, f, "sb1", MethodSessionClose, &runtimev1pb.SandboxSessionCloseRequestAlpha1{SessionId: "sess-1"})
+	require.Error(t, err)
+	assert.Equal(t, codes.Unavailable, status.Code(err))
+	assert.False(t, IsSandboxLost(err))
+	assert.True(t, f.Exists("sb1"))
+
+	assert.Equal(t, []string{"inst-1"}, f.LiveInstanceIDs())
+	assert.Equal(t, int32(0), d.releaseStarted.Load())
+}
