diff --git a/pkg/components/sandbox/actortype.go b/pkg/components/sandbox/actortype.go
new file mode 100644
index 000000000..444ac4a31
--- /dev/null
+++ b/pkg/components/sandbox/actortype.go
@@ -0,0 +1,22 @@
