+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package sandbox
+
+// ActorType returns the internal actor type of a sandbox component hosted by
+// an app: dapr.internal.<namespace>.<appID>.sandbox.<component>. It lives in
+// this leaf package so that the API layer and its ACLs do not depend on the
+// runtime.
+func ActorType(namespace, appID, component string) string {
+	return "dapr.internal." + namespace + "." + appID + ".sandbox." + component
+}
