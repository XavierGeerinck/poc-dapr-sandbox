@@ -148,10 +148,10 @@ func (a *api) validateSameAppInternalActor(ctx context.Context, actorType, opera
 }
 
 // isHostedSandboxActorType reports whether actorType is a sandbox actor type
-// of this app (sandboxhost.ActorType). An app hosts sandboxes for the other
+// of this app (sandbox.ActorType). An app hosts sandboxes for the other
 // apps of its namespace, which invoke them with the host's app ID.
 func (a *api) isHostedSandboxActorType(actorType string) bool {
-	prefix := sandboxhost.ActorType(a.Namespace(), a.AppID(), "")
+	prefix := sandbox.ActorType(a.Namespace(), a.AppID(), "")
 	return len(actorType) > len(prefix) && strings.HasPrefix(actorType, prefix)
 }
 
