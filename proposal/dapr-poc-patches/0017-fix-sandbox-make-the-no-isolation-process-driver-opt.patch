 /*
 Copyright 2026 The Dapr Authors
@@ -22,6 +22,10 @@ import (
 	"github.com/dapr/dapr/pkg/components/sandbox/process"
 )
 
+// sandbox.process runs commands as plain host processes, with no isolation.
+// It is for tests and local development only, so it is not part of the
+// stable flavor, and a component of this type must also set the metadata
+// allowNoIsolation to "true" (see process.Init).
 func init() {
 	sandbox.DefaultRegistry.RegisterComponent(process.New, "process")
 }
diff --git a/pkg/components/sandbox/process/process.go b/pkg/components/sandbox/process/process.go
index 068029d50..ce264292f 100644
--- a/pkg/components/sandbox/process/process.go
+++ b/pkg/components/sandbox/process/process.go
@@ -25,6 +25,10 @@ limitations under the License.
 // implementation of the sandbox driver contract; never use it to run
 // untrusted code.
 //
+// It is opt-in twice over: daprd only includes it in the allcomponents flavor
+// (or with the sandbox_process build tag), and Init fails unless the
+// component's metadata sets MetadataAllowNoIsolation to "true".
+//
 // Error contract: Exec, SessionStart, SessionSend, SessionClose and Release
 // return codes.NotFound for an unknown instance (or session) id. Release of an
 // unknown id therefore also returns NotFound; callers that want idempotent
@@ -54,6 +58,10 @@ import (
 	"github.com/dapr/kit/logger"
 )
 
+// MetadataAllowNoIsolation is the metadata key a sandbox.process component
+// must set to "true", to acknowledge that its commands run without isolation.
+const MetadataAllowNoIsolation = "allowNoIsolation"
+
 const (
 	// outputCap is the per-stream output cap for Exec and per-session buffers.
 	outputCap = 4 * 1024 * 1024
@@ -99,6 +107,9 @@ func New(l logger.Logger) sandbox.Sandbox {
 }
 
 func (p *Process) Init(_ context.Context, md metadata.Base) error {
+	if md.Properties[MetadataAllowNoIsolation] != "true" {
+		return fmt.Errorf("sandbox.process runs commands as host processes with no isolation: set metadata '%s' to \"true\" to use it, for tests and local development only", MetadataAllowNoIsolation)
+	}
 	cfg, err := sandbox.ParseConfig(md.Properties)
 	if err != nil {
 		return err
diff --git a/pkg/components/sandbox/process/process_test.go b/pkg/components/sandbox/process/process_test.go
index 3f09102bf..b3240b832 100644
--- a/pkg/components/sandbox/process/process_test.go
+++ b/pkg/components/sandbox/process/process_test.go
@@ -40,7 +40,7 @@ func newDriver(t *testing.T, props map[string]string) *Process {
 
 func newDriverDelay(t *testing.T, props map[string]string, refillDelay time.Duration) *Process {
 	t.Helper()
-	p := map[string]string{"image": "ignored"}
+	p := map[string]string{"image": "ignored", MetadataAllowNoIsolation: "true"}
 	for k, v := range props {
 		p[k] = v
 	}
@@ -75,6 +75,33 @@ func run(t *testing.T, d *Process, id string, spec *proto.SandboxExecSpec) *prot
 	return r
 }
 
+func TestInitRequiresAllowNoIsolation(t *testing.T) {
+	for name, props := range map[string]map[string]string{
+		"unset": {"image": "ignored"},
+		"empty": {"image": "ignored", MetadataAllowNoIsolation: ""},
+		"false": {"image": "ignored", MetadataAllowNoIsolation: "false"},
+		"other": {"image": "ignored", MetadataAllowNoIsolation: "yes"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := New(logger.NewLogger("test")).(*Process)
+			t.Cleanup(func() { _ = d.Close() })
+			err := d.Init(t.Context(), metadata.Base{Properties: props})
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "'allowNoIsolation'")
+			assert.Contains(t, err.Error(), "no isolation")
+			// Nothing was started.
+			assert.Empty(t, d.pool)
+			assert.Equal(t, 0, d.inflight)
+		})
+	}
+
+	d := New(logger.NewLogger("test")).(*Process)
+	t.Cleanup(func() { _ = d.Close() })
+	require.NoError(t, d.Init(t.Context(), metadata.Base{Properties: map[string]string{
+		"image": "ignored", MetadataAllowNoIsolation: "true",
+	}}))
+}
+
 func TestAcquirePoolThenBoot(t *testing.T) {
 	d := newDriverDelay(t, map[string]string{"warmPoolSize": "1", "refillConcurrency": "1"}, time.Hour)
 	a := acquire(t, d)
