+// acquireNeverDriver is a sandbox driver whose Acquire never hands out a VM:
+// it waits until its context is done. No other method is called.
+type acquireNeverDriver struct{ sandbox.Sandbox }
+
+func (acquireNeverDriver) Acquire(ctx context.Context, _ *compv1pb.SandboxAcquireRequest) (*compv1pb.SandboxAcquireResponse, error) {
+	<-ctx.Done()
+	return nil, status.FromContextError(ctx.Err()).Err()
+}
