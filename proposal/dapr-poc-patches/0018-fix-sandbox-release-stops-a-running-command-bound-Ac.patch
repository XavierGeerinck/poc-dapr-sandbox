+func TestAcquireTimeout(t *testing.T) {
+	for _, method := range []string{MethodActivate, MethodExec} {
+		t.Run(method, func(t *testing.T) {
+			d := &fakeDriver{untilDone: true}
+			f := newFactory(t, d, func(o *Options) { o.AcquireTimeout = 100 * time.Millisecond })
+
+			var in proto.Message = &runtimev1pb.SandboxCreateRequestAlpha1{}
+			if method == MethodExec {
+				in = &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"}
+			}
+			start := time.Now()
+			_, err := invoke(t, f, "sb1", method, in)
+			require.Error(t, err)
+			assert.GreaterOrEqual(t, time.Since(start), 100*time.Millisecond)
+			assert.Less(t, time.Since(start), 5*time.Second)
+			// Retry later, like a full host.
+			assert.Equal(t, codes.ResourceExhausted, status.Code(err))
+			assert.Contains(t, status.Convert(err).Message(), "did not provide a sandbox within 100ms")
+			assert.False(t, IsSandboxLost(err))
+			assert.False(t, f.Exists("sb1"))
+			assert.Equal(t, int32(0), d.execCount.Load())
+		})
+	}
+
+	t.Run("the caller's deadline is not the bound", func(t *testing.T) {
+		d := &fakeDriver{untilDone: true}
+		f := newFactory(t, d)
+
