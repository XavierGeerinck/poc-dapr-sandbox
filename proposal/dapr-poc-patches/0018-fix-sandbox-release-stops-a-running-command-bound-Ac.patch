+func TestReleaseDuringAcquire(t *testing.T) {
+	d := &fakeDriver{acquireStarted: make(chan struct{}, 1), acquireBlock: make(chan struct{})}
+	f := newFactory(t, d)
+
+	running := goInvoke(t.Context(), f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "ls"})
+	await(t, d.acquireStarted)
+
+	start := time.Now()
+	_, err := invoke(t, f, "sb1", MethodRelease, &runtimev1pb.SandboxDeleteRequestAlpha1{SandboxId: "sb1"})
+	require.NoError(t, err)
+	assert.Less(t, time.Since(start), time.Second)
+
+	// The acquire finishes and hands its VM straight back. No command ran,
+	// so the exec is Closed and the router may run it on a new target.
+	close(d.acquireBlock)
+	c := await(t, running)
+	assert.True(t, targetserrors.IsClosed(c.err), "expected Closed, got %v", c.err)
+	assert.Equal(t, int32(0), d.execCount.Load())
+	assert.Eventually(t, func() bool { return d.releaseCount.Load() == 1 }, 5*time.Second, 10*time.Millisecond)
+}
