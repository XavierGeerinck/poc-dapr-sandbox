+// acquireErr maps a failed driver Acquire. When the acquire bound passed, no
+// VM is available now, so it becomes ResourceExhausted: retry later. Nothing
+// was acquired, so nothing was lost.
+func (t *target) acquireErr(err error, timedOut bool) error {
+	switch {
+	case timedOut:
+		return status.Errorf(codes.ResourceExhausted, "sandbox driver did not provide a sandbox within %s", t.factory.acquireTimeout)
+	default:
+		return driverErr("acquire", err)
+	}
+}
+
+// callContext returns the context for a driver call that runs a command in
+// the VM. It is also cancelled when the target is removed, so a release,
+// deactivation or halt stops the command instead of waiting for it.
+func (t *target) callContext(ctx context.Context) (context.Context, context.CancelFunc) {
+	ctx, cancel := context.WithCancel(ctx)
+	go func() {
+		select {
+		case <-t.closed:
+			cancel()
+		case <-ctx.Done():
+		}
+	}()
+	return ctx, cancel
+}
+
+// commandErr maps the outcome of a driver call that runs a command (exec,
+// session start, session send); err is the driver's error, or nil. A target
+// removed during the call lost its VM, so the outcome is the "sandbox lost"
+// error even if the driver answered. Other driver errors go through mapErr.
+func (t *target) commandErr(op string, err error, mapErr func(string, error) error) error {
+	switch {
+	case t.isRemoved():
+		log.Debugf("Sandbox actor '%s' was removed during %s", t.Key(), op)
+		return ErrSandboxLost()
+	case err == nil:
+		return nil
+	default:
+		return mapErr(op, err)
+	}
+}
+
