+func TestReleaseDuringRunningCall(t *testing.T) {
+	for name, tc := range map[string]struct {
+		started func(*fakeDriver) chan struct{}
+		run     func(context.Context, *Factory) <-chan call
+	}{
+		"exec": {
+			started: func(d *fakeDriver) chan struct{} { return d.execStarted },
+			run: func(ctx context.Context, f *Factory) <-chan call {
+				// No timeoutMs: without the release, the command would run
+				// until it exits.
+				return goInvoke(ctx, f, "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "sleep"})
+			},
+		},
+		"session send": {
+			started: func(d *fakeDriver) chan struct{} { return d.sendStarted },
+			run: func(ctx context.Context, f *Factory) <-chan call {
+				return goInvoke(ctx, f, "sb1", MethodSessionSend, &runtimev1pb.SandboxSessionSendRequestAlpha1{
+					SessionId: "sess-1", Input: []byte("x\n"), Until: []byte(">>> "),
+				})
+			},
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := &fakeDriver{}
+			f := newFactory(t, d)
+
+			// Acquire the VM and start a session first.
+			_, err := invoke(t, f, "sb1", MethodSessionStart, &runtimev1pb.SandboxSessionStartRequestAlpha1{Command: "sh"})
+			require.NoError(t, err)
+
+			d.execStarted = make(chan struct{}, 1)
+			d.sendStarted = make(chan struct{}, 1)
+			d.untilDone = true
+			running := tc.run(t.Context(), f)
+			await(t, tc.started(d))
+
+			// The release does not wait for the running call's turn.
+			start := time.Now()
+			_, err = invoke(t, f, "sb1", MethodRelease, &runtimev1pb.SandboxDeleteRequestAlpha1{SandboxId: "sb1"})
+			require.NoError(t, err)
+			assert.Less(t, time.Since(start), time.Second)
+			assert.False(t, f.Exists("sb1"))
+
+			// The running call ends: its driver call was cancelled and the
+			// sandbox is gone.
+			c := await(t, running)
+			requireLost(t, c.err)
+			assert.Eventually(t, func() bool { return d.releaseCount.Load() == 1 }, 5*time.Second, 10*time.Millisecond)
+			assert.Equal(t, []string{"inst-1"}, d.releasedIDs())
+		})
+	}
+}
