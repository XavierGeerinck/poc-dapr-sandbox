 	"google.golang.org/genproto/googleapis/rpc/errdetails"
 	"google.golang.org/grpc/codes"
 	"google.golang.org/grpc/status"
@@ -68,6 +69,11 @@ const (
 	// the caller's expected activation token no longer matches, or the
 	// driver no longer knows the sandbox's VM.
 	ReasonSandboxLost = "DAPR_SANDBOX_LOST"
+	// ReasonInterrupted is the ErrorInfo reason of the "interrupted" error:
+	// the context of a driver call that runs a command ended while the call
+	// ran, because the actor's placement claim was cancelled (a rebalance)
+	// or the caller gave up.
+	ReasonInterrupted = "DAPR_SANDBOX_INTERRUPTED"
 	// ErrorDomain is the ErrorInfo domain of the errors of this package.
 	ErrorDomain = "dapr.io"
 )
@@ -84,6 +90,20 @@ var errSandboxLost = func() error {
 	return st.Err()
 }()
 
+// errInterrupted is built once so that it always carries its ErrorInfo. Its
+// code, Aborted, is not one that a caller's router retries
+// (router.IsRetryableRemoteError).
+var errInterrupted = func() error {
+	st, err := status.New(codes.Aborted, "sandbox call interrupted by actor rebalancing: the command may have partly run").WithDetails(&errdetails.ErrorInfo{
+		Reason: ReasonInterrupted,
+		Domain: ErrorDomain,
+	})
+	if err != nil {
+		panic("sandbox: building the interrupted error: " + err.Error())
+	}
+	return st.Err()
+}()
+
 // ErrSandboxLost returns the "sandbox lost" error: FailedPrecondition with an
 // ErrorInfo detail whose reason is ReasonSandboxLost.
 func ErrSandboxLost() error {
@@ -92,12 +112,27 @@ func ErrSandboxLost() error {
 
 // IsSandboxLost reports whether err is the "sandbox lost" error.
 func IsSandboxLost(err error) bool {
+	return hasReason(err, codes.FailedPrecondition, ReasonSandboxLost)
+}
+
+// ErrInterrupted returns the "interrupted" error: Aborted with an ErrorInfo
+// detail whose reason is ReasonInterrupted.
+func ErrInterrupted() error {
+	return errInterrupted
+}
+
+// IsInterrupted reports whether err is the "interrupted" error.
+func IsInterrupted(err error) bool {
+	return hasReason(err, codes.Aborted, ReasonInterrupted)
+}
+
+func hasReason(err error, code codes.Code, reason string) bool {
 	st, ok := status.FromError(err)
-	if !ok || st.Code() != codes.FailedPrecondition {
+	if !ok || st.Code() != code {
 		return false
 	}
 	for _, d := range st.Details() {
-		if info, ok := d.(*errdetails.ErrorInfo); ok && info.GetReason() == ReasonSandboxLost {
+		if info, ok := d.(*errdetails.ErrorInfo); ok && info.GetReason() == reason {
 			return true
 		}
 	}
@@ -254,7 +289,7 @@ func (t *target) exec(ctx context.Context, data []byte, start time.Time) (proto.
 	})
 	cancel()
 	timing.ExecUs = t.factory.sinceUs(execStart)
-	if err = t.commandErr("exec", err, t.instanceErr); err != nil {
+	if err = t.commandErr(ctx, "exec", err, t.instanceErr); err != nil {
 		return nil, err
 	}
 
@@ -297,7 +332,7 @@ func (t *target) sessionStart(ctx context.Context, data []byte) (proto.Message,
 		},
 	})
 	cancel()
-	if err = t.commandErr("session start", err, t.instanceErr); err != nil {
+	if err = t.commandErr(ctx, "session start", err, t.instanceErr); err != nil {
 		return nil, err
 	}
 
@@ -335,7 +370,7 @@ func (t *target) sessionSend(ctx context.Context, data []byte, start time.Time)
 	timing.ExecUs = t.factory.sinceUs(execStart)
 	// NotFound here can mean an unknown session, so a driver error is not
 	// treated as a lost sandbox.
-	if err = t.commandErr("session send", err, func(op string, err error) error { return driverErr(op, err) }); err != nil {
+	if err = t.commandErr(ctx, "session send", err, func(op string, err error) error { return driverErr(op, err) }); err != nil {
 		return nil, err
 	}
 
@@ -471,19 +506,34 @@ func (t *target) callContext(ctx context.Context) (context.Context, context.Canc
 }
 
 // commandErr maps the outcome of a driver call that runs a command (exec,
-// session start, session send); err is the driver's error, or nil. A target
-// removed during the call lost its VM, so the outcome is the "sandbox lost"
-// error even if the driver answered. Other driver errors go through mapErr.
-func (t *target) commandErr(op string, err error, mapErr func(string, error) error) error {
+// session start, session send); ctx is the call's context and err the
+// driver's error, or nil.
+//
+//   - A target removed during the call lost its VM, so the outcome is the
+//     "sandbox lost" error even if the driver answered.
+//   - A driver error after ctx ended is the "interrupted" error: the command
+//     was cut short (a driver kills it when its call is cancelled) and may
+//     have partly run. The actor router cancels ctx when it cancels the
+//     actor's placement claim, on a rebalance after the drain timeout.
+//   - Other driver errors go through mapErr.
+//
+// Every error is permanent. The router retries a failed call whose context
+// ended, on this or the actor's new host, unless the error is permanent; a
+// retry would run the command again.
+func (t *target) commandErr(ctx context.Context, op string, err error, mapErr func(string, error) error) error {
 	switch {
 	case t.isRemoved():
 		log.Debugf("Sandbox actor '%s' was removed during %s", t.Key(), op)
-		return ErrSandboxLost()
+		err = ErrSandboxLost()
 	case err == nil:
 		return nil
+	case ctx.Err() != nil:
+		log.Debugf("Sandbox actor '%s': %s interrupted: %v (cause: %v)", t.Key(), op, err, context.Cause(ctx))
+		err = ErrInterrupted()
 	default:
-		return mapErr(op, err)
+		err = mapErr(op, err)
 	}
+	return backoff.Permanent(err)
 }
 
 // instanceErr maps a driver error for a call on the instance itself: NotFound
