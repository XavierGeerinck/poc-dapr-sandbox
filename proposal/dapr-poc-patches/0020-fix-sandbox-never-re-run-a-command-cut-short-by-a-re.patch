+package sandbox
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/dapr/dapr/pkg/actors/api"
+	placementfake "github.com/dapr/dapr/pkg/actors/internal/placement/fake"
+	"github.com/dapr/dapr/pkg/actors/internal/reentrancystore"
+	"github.com/dapr/dapr/pkg/actors/router"
+	"github.com/dapr/dapr/pkg/actors/table"
+	internalv1pb "github.com/dapr/dapr/pkg/proto/internals/v1"
+	runtimev1pb "github.com/dapr/dapr/pkg/proto/runtime/v1"
+	"github.com/dapr/dapr/pkg/resiliency"
+	"github.com/dapr/kit/logger"
+)
+
+// routed is the real actor router in front of a sandbox Factory, with a fake
+// placement that hosts the type locally and hands every claim to the test.
+type routed struct {
+	router.Interface
+	lookups atomic.Int32
+	// claims receives the cancel function of every placement claim, in
+	// order. Cancelling one is what the disseminator does to in-flight calls
+	// on a rebalance, after the drain timeout.
+	claims chan context.CancelCauseFunc
+}
+
+func newRouted(t *testing.T, f *Factory) *routed {
+	t.Helper()
+	r := &routed{claims: make(chan context.CancelCauseFunc, 16)}
+	plc := placementfake.New().WithLookupActor(func(ctx context.Context, req *api.LookupActorRequest) (*api.LookupActorResponse, context.Context, context.CancelCauseFunc, error) {
+		r.lookups.Add(1)
+		cctx, cancel := context.WithCancelCause(ctx)
+		r.claims <- cancel
+		return &api.LookupActorResponse{Local: true}, cctx, cancel, nil
+	})
+	tbl := table.New(table.Options{ReentrancyStore: reentrancystore.New()})
+	t.Cleanup(func() { require.NoError(t, tbl.Close()) })
+	tbl.RegisterActorTypes(table.RegisterActorTypeOptions{
+		Factories: []table.ActorTypeFactory{{Type: testActorType, Factory: f}},
+	})
+	r.Interface = router.New(router.Options{
+		Placement:  plc,
+		Table:      tbl,
+		Resiliency: resiliency.FromConfigurations(logger.NewLogger("test")),
+	})
+	return r
+}
+
+// goCall routes one sandbox actor call on a new goroutine.
+func (r *routed) goCall(ctx context.Context, id, method string, in proto.Message) <-chan call {
+	ch := make(chan call, 1)
+	go func() {
+		data, err := proto.Marshal(in)
+		if err != nil {
+			ch <- call{err: err}
+			return
+		}
+		req := internalv1pb.NewInternalInvokeRequest(method).
+			WithActor(testActorType, id).
+			WithData(data).
+			WithContentType(internalv1pb.ProtobufContentType)
+		res, err := r.Call(ctx, req)
+		ch <- call{res: res, err: err}
+	}()
+	return ch
+}
+
+// TestRebalanceInterruptedCommandIsNotRetried checks that an exec or session
+// send whose driver call is cancelled by a placement claim cancellation (a
+// rebalance) fails with the interrupted error and is not run again: the
+// router does not retry it, here or on another host.
+func TestRebalanceInterruptedCommandIsNotRetried(t *testing.T) {
+	rebalance := errors.New("placement table updated")
+
+	for name, tc := range map[string]struct {
+		method  string
+		in      proto.Message
+		started func(*fakeDriver) chan struct{}
+		calls   func(*fakeDriver) int
+	}{
+		"exec": {
+			method:  MethodExec,
+			in:      &runtimev1pb.SandboxExecRequestAlpha1{Command: "sleep"},
+			started: func(d *fakeDriver) chan struct{} { return d.execStarted },
+			calls:   func(d *fakeDriver) int { return int(d.execCount.Load()) },
+		},
+		"session send": {
+			method:  MethodSessionSend,
+			in:      &runtimev1pb.SandboxSessionSendRequestAlpha1{SessionId: "sess-1", Input: []byte("x\n")},
+			started: func(d *fakeDriver) chan struct{} { return d.sendStarted },
+			calls:   func(d *fakeDriver) int { return d.sendCount() },
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			d := &fakeDriver{}
+			f := newFactory(t, d)
+			r := newRouted(t, f)
+
+			// Acquire the VM and start a session through the router first.
+			c := await(t, r.goCall(t.Context(), "sb1", MethodSessionStart, &runtimev1pb.SandboxSessionStartRequestAlpha1{Command: "sh"}))
+			require.NoError(t, c.err)
+			<-r.claims
+			lookups := r.lookups.Load()
+
+			d.execStarted = make(chan struct{}, 1)
+			d.sendStarted = make(chan struct{}, 1)
+			d.untilDone = true
+			running := r.goCall(t.Context(), "sb1", tc.method, tc.in)
+			await(t, tc.started(d))
+			claim := await(t, r.claims)
+			claim(rebalance)
+
+			c = await(t, running)
+			require.Error(t, c.err)
+			assert.True(t, IsInterrupted(c.err), "expected the interrupted error, got %v", c.err)
+			assert.Equal(t, codes.Aborted, status.Code(c.err))
+			assert.Contains(t, status.Convert(c.err).Message(), "interrupted by actor rebalancing")
+			assert.False(t, IsSandboxLost(c.err))
+
+			// The driver ran the command once and the router looked the actor
+			// up once: no retry, so nothing ran it again.
+			assert.Equal(t, 1, tc.calls(d))
+			assert.Equal(t, lookups+1, r.lookups.Load())
+			// A caller on another host would not retry it either.
+			assert.False(t, router.IsRetryableRemoteError(c.err))
+
+			// The sandbox itself is kept, and the next call runs normally.
+			assert.True(t, f.Exists("sb1"))
+			d.untilDone = false
+			c = await(t, r.goCall(t.Context(), "sb1", tc.method, tc.in))
+			require.NoError(t, c.err)
+			assert.Equal(t, 2, tc.calls(d))
+		})
+	}
+
+	t.Run("a call cancelled before the driver is retried", func(t *testing.T) {
+		// While the call waits for its turn its claim is cancelled: no
+		// command ran, so the router may retry it, and the retry runs once.
+		d := &fakeDriver{execStarted: make(chan struct{}, 1), execBlock: make(chan struct{})}
+		f := newFactory(t, d)
+		r := newRouted(t, f)
+
+		first := r.goCall(t.Context(), "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "first"})
+		await(t, d.execStarted)
+		<-r.claims
+
+		queued := r.goCall(t.Context(), "sb1", MethodExec, &runtimev1pb.SandboxExecRequestAlpha1{Command: "queued"})
+		claim := await(t, r.claims)
+		assert.Eventually(t, func() bool { return f.GetOrCreate("sb1").(*target).inflight.Load() == 2 }, 5*time.Second, time.Millisecond)
+		claim(rebalance)
+
+		// The retry looks the actor up again, then waits for the turn.
+		<-r.claims
+		close(d.execBlock)
+		require.NoError(t, await(t, first).err)
+		require.NoError(t, await(t, queued).err)
+		assert.Equal(t, int32(2), d.execCount.Load())
+	})
+}
