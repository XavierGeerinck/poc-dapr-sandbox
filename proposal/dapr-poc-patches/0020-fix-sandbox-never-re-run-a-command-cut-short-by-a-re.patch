diff --git a/pkg/api/universal/sandbox_test.go b/pkg/api/universal/sandbox_test.go
index e0febc02d..fd51d2a21 100644
--- a/pkg/api/universal/sandbox_test.go
+++ b/pkg/api/universal/sandbox_test.go
@@ -462,3 +462,31 @@ func TestSandboxAcquireDriverUnavailableIsHostFull(t *testing.T) {
 	assert.Equal(t, int32(1), calls.Load())
 	assert.Equal(t, 0, f.Len())
 }
+
+func TestSandboxInterruptedIsExecError(t *testing.T) {
+	t.Run("interrupted by a rebalance", func(t *testing.T) {
+		u, rec := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+			return nil, sandboxtarget.ErrInterrupted()
+		})
+		_, err := u.SandboxSessionSendAlpha1(t.Context(), &runtimev1pb.SandboxSessionSendRequestAlpha1{Component: "py", SandboxId: "sb", SessionId: "s"})
+		require.ErrorIs(t, err, messages.ErrSandboxExec)
+		var apiErr messages.APIError
+		require.ErrorAs(t, err, &apiErr)
+		assert.Equal(t, http.StatusInternalServerError, apiErr.HTTPCode())
+		assert.Equal(t, "ERR_SANDBOX_EXEC", apiErr.Tag())
+		assert.Equal(t, "sandbox call interrupted by actor rebalancing: the command may have partly run", apiErr.Message())
+		assert.Equal(t, 1, rec.len(), "an interrupted call must not be retried")
+	})
+
+	t.Run("the caller's own context ended", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		defer cancel()
+		u, _ := newSandboxUniversal(t, true, func(int, *internalsv1pb.InternalInvokeRequest) (proto.Message, error) {
+			cancel()
+			return nil, sandboxtarget.ErrInterrupted()
+		})
+		_, err := u.SandboxExecAlpha1(ctx, &runtimev1pb.SandboxExecRequestAlpha1{Component: "py", SandboxId: "sb", Command: "x"})
+		assert.Equal(t, codes.Canceled, status.Code(err))
+		assert.NotErrorIs(t, err, messages.ErrSandboxExec)
+	})
+}
